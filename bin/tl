#!/usr/bin/env python3
"""Time-log helper for Helix (keys: space , i / I / o / O / u / r / l; see docs/keys.md).

An entry is any line that starts with a date (optionally after indentation and
a list bullet, checkbox or not), so entries can sit anywhere in a file, in any order:

    2026-10-09 09:30 - 10:45 = 1h 15min  note
    - 2026-10-09 13:00 -                 (still running)

The "= 1h 15min" part is only a convenience; totals are always recomputed from
the start/end times.

    tl start            print "YYYY-MM-DD HH:MM - " (no newline)
    tl start - [--file F]
                        the last step of `space , i`, on the buffer of F, the file `tl next` printed:
                        stdin to stdout with a new entry "YYYY-MM-DD HH:MM - " on a new last line.
                        In td's inbox, at the line `tl running` kept (when F is its file) it goes
                        at the end of the section of the todo that line is in, lined up with the
                        todo; on a blank line in no section, on that line; else on a new line below.
                        Its line goes to ~/.cache/tl/goto, as F:LINE.
    tl close [--file F] stdin = region of text. Every entry line in it gets its end filled with
                        now if missing and its duration refreshed; other lines are untouched
                        (space , u). F is the file the text came from: if it is td's inbox, its
                        todos are left alone.
    tl out "$BASH_EXECUTION_STRING" # done: TEXT
                        end, at now, the latest-started entry still running in the task files on
                        disk. TEXT becomes the "# heading" right above it,
                        or is added to the one there (" - TEXT"). Comment form, so TEXT needs no
                        quoting (space , O).
    tl out --visit --from F:LINE
                        the first step of `space , o`: print the task file of the latest entry
                        running on disk (F if none), and keep F:LINE in ~/.cache/tl/goto.
    tl out --edit - [--file F]
                        the next step, on that file's buffer: stdin to stdout, with the latest entry
                        running in it ended, as `tl out` does, and its heading ready for you to type:
                        "# " on a new line right above it, or " - " after the heading already there.
                        The heading's line then replaces the goto, as F:LINE. If nothing runs in F,
                        the text passes through unchanged.
    tl stop [--skip F]  end, at now, every entry still running, in
                        the task files on disk except F; print where ("stopped ~/tasks/x.md:3").
                        An entry that has run over 12h was forgotten, and has no end date to say
                        when it really ended: it is ended one minute after it started (this goes
                        for every way of ending an entry here).
    tl stop - [--file F]
                        the same for stdin, written to stdout byte for byte otherwise. F is the file
                        the text came from: if it is td's inbox, its todos are left alone.
    tl running [--from F[:LINE]]
                        print the task file of the latest entry running on disk (F if none), and
                        keep F:LINE for `tl next` and `tl start -`. The first step of `space , i`:
                        the key ends the entry in that file's buffer, so unsaved edits there are kept.
    tl next [--skip R]  the same as `tl stop --skip R`, then print the file to clock in to: the one
                        `tl running` kept. R if there is none.
    tl where [--from F:LINE]
                        print the latest entry running as path:line, for
                        `space , I` to go to; F:LINE if none runs.
    tl where --visit --from F:LINE
                        the first step of `space , I`: print the task file of the latest entry running
                        on disk (F if none), and keep its path:line on disk, or F:LINE if none, in
                        ~/.cache/tl/goto.
    tl where --locate - [--file F]
                        the next step, on that file's buffer (`:pipe-to`, so nothing changes): the
                        line of the latest entry running in the buffer, as F:LINE, replaces the goto.
                        The buffer's own line, so edits not saved yet above the entry don't move
                        the cursor off it. If nothing runs in the buffer, the goto stays.
    tl where --say      print "running since HH:MM", or "nothing running", for :echo %sh{}.
    tl recent [N]       numbered list of the N (default 9) most recently modified task files
    tl recent --nth K [ELSE]
                        path of the Kth most recently modified task file (ELSE if none)
    tl summary [--week [DATE]] [--view] [N|all]
                        per-day totals for the last N days (default 14) over the task folder;
                        with --week, this week's (or DATE's week), Monday to Sunday. With --view,
                        written to ~/.cache/tl/summary.txt (read-only) instead, and its path
                        printed (space , L); `+`/`-` there step it a week (view_step).
                        Entries with no end time, of any date, are
                        listed first. Locations print as ~/path:line, for gf. Under each day, a
                        line per task (total and title: its file's first line), then the nearest
                        markdown "# heading" above its entries, as bullets (but the title). td's
                        inbox has no title, and its entries come under the todo they are under.
    tl test [-v]        run the tests at the end of this file (temporary task folders, faked clock).

Task files: $TL_DIR (default ~/tasks), *.txt and *.md, and td's inbox ($TD_FILE, default
$TL_DIR/todo.md). In the inbox a todo (a line td reads as one, `- [S] `) is never an entry:
`- [ ] 2026-10-12 09:00 - prep slides` there is a todo, not a running entry. Its entries are the
other lines, mostly in a todo's section (the lines under it, up to the next todo that is not under
it), and the summary lists them under that todo's text. $TL_NOW="YYYY-MM-DD HH:MM" fakes the clock.
"""
import contextlib
import io
import os
import re
import sys
from collections import defaultdict, namedtuple
from datetime import date, datetime, timedelta
from pathlib import Path

# indent + optional "- " / "* " / "- [S] ", any of td's states: a bullet keeps its entry whatever its checkbox
PREFIX = r"\s*(?:[-*]\s+(?:\[[ xXyYaAwW!]\]\s+)?)?"
ENTRY = re.compile(
    rf"""^(?P<prefix>{PREFIX})
        (?P<date>\d{{4}}-\d{{2}}-\d{{2}})\s+
        (?P<start>\d{{1,2}}:\d{{2}})\s*[-–]
        (?:\s*(?P<end>\d{{1,2}}:\d{{2}}))?
        (?:\s*=\s*(?:\d+h)?\s*(?:\d+min)?)?
        (?:\s+(?P<note>\S.*?))?\s*$""",
    re.X,
)
# Looks like an attempt at an entry (date, time, dash); used to flag lines ENTRY rejects.
# td's TL_ENTRY is the same pattern (td's tests check), so a line is a time-log entry here
# or a reminder there: `2026-11-01 10:00` with no dash is td's, not a broken entry.
ATTEMPT = re.compile(rf"^{PREFIX}(\d{{4}}-\d{{2}}-\d{{2}})\s+\d{{1,2}}:\d{{2}}\s*[-–]")
# Markdown heading; "#+BEGIN_SRC", "#tag" and an empty "# " are not one. The title leaves out td's
# state ("# [A] fix parser" is "fix parser"), so it stays the same when the state changes.
HEADING = re.compile(r"^ {0,3}#{1,6}\s+(?:\[[ xXyYaAwW!]\]\s+)?(\S.*?)(?:\s+#+)?\s*$")
# A todo: a line td reads as one (td's TASK, the same pattern: td's tests check). In td's inbox a
# todo is never an entry, so `- [ ] 2026-10-12 09:00 - prep slides` there stays a todo.
TODO = re.compile(r"^(?P<indent>\s*)- \[(?P<state>[ xXyYaAwW!])\]\s+(?P<text>.*?)\s*$")
# Code block fence (markdown or org); a "# " line inside a block is a comment, not a heading.
FENCE = re.compile(r"^\s*(?:```|~~~|#\+(?:BEGIN|END)_)", re.I)

Entry = namedtuple("Entry", "prefix date start end note")

MAX_SANE = 12 * 60  # longer ended entries are reported as probable typos


def now():
    fake = os.environ.get("TL_NOW")
    return datetime.strptime(fake, "%Y-%m-%d %H:%M") if fake else datetime.now()


def to_min(hhmm):
    h, m = map(int, hhmm.split(":"))
    if h > 23 or m > 59:
        raise ValueError(hhmm)
    return h * 60 + m


def hhmm(minutes):
    return f"{minutes // 60:02d}:{minutes % 60:02d}"


def dur_text(minutes):
    return f"{minutes // 60}h {minutes % 60:02d}min"


def duration(start, end):
    return (end - start) % 1440  # end before start = crossed midnight


def end_minute(e, t):
    """The end, as minutes of the day, to close the running entry e at t. One that has run longer
    than MAX_SANE was forgotten: an entry has no end date, so its real end can't be written, and
    the time of day would give a wrong duration. It gets one minute instead, to show on the timeline
    that something was there."""
    if t - started_at(e) > timedelta(minutes=MAX_SANE):
        return (e.start + 1) % 1440
    return t.hour * 60 + t.minute


def parse(line):
    """-> (Entry, None) | (None, error) | (None, None) when not an entry line."""
    if not ATTEMPT.match(line):
        return None, None
    m = ENTRY.match(line)
    if not m:
        return None, "can't parse"
    note = m["note"] or ""
    if re.match(r"\d{1,2}:", note):  # e.g. end typed as "10:4"
        return None, "can't parse"
    try:
        date.fromisoformat(m["date"])
        start = to_min(m["start"])
        end = to_min(m["end"]) if m["end"] else None
    except ValueError:
        return None, "invalid date or time"
    return Entry(m["prefix"], m["date"], start, end, note), None


def parse_in(line, inbox):
    """parse(line) for a line of a task file; inbox: the file is td's inbox, where a todo is
    never an entry -> (None, None) for one."""
    return (None, None) if inbox and TODO.match(line) else parse(line)


def width(line):
    """The columns line is indented by, a tab to 4 as in markdown."""
    return len(re.match(r"[ \t]*", line)[0].expandtabs(4))


# Any markdown heading, an empty "# " too: it ends a todo's section, unless it is right above a
# time entry (see heads_entry).
HEADING_LINE = re.compile(r" {0,3}#{1,6}(\s|$)")


def heads_entry(lines, k):
    """True when lines[k] is a heading right above a time entry of td's inbox (what `space , o`
    and `O` add): it belongs to that entry, so to the todo whose section the entry is in."""
    return (k + 1 < len(lines) and bool(HEADING_LINE.match(lines[k].rstrip("\r\n")))
            and parse_in(lines[k + 1].rstrip("\r\n"), True)[0] is not None)


def section_end(lines, j):
    """The index of the last line of the section of the todo at lines[j]: the lines after it up
    to a heading (one right above a time entry is part of it, see heads_entry), the next todo at
    its indent or less, or a line indented less than it (a parent todo's note), blank lines at its
    end left out. A todo's notes need no indent, but a sub-todo's section holds only the lines
    indented at least as deep as it. (A heading above an entry is judged by the entry's indent.)"""
    deep, end = width(lines[j]), j
    for k in range(j + 1, len(lines)):
        body = lines[k].rstrip("\r\n")
        if not body.strip():
            continue
        head = heads_entry(lines, k)
        if HEADING_LINE.match(body) and not head:
            break
        at = lines[k + 1].rstrip("\r\n") if head else body
        if width(at) < deep or (width(at) == deep and TODO.match(at)):
            break
        end = k
    return end


def section_of(lines, i):
    """The todo whose section holds lines[i] (the innermost, when todos nest; a blank line after a
    section counts as in it) -> (its index, the index of its section's last line), or None: above
    the first todo, or under a heading (not one above a time entry) with no todo after it yet."""
    i = min(i, len(lines) - 1)
    for j in range(i, -1, -1):
        body = lines[j].rstrip("\r\n")
        if TODO.match(body):
            end = section_end(lines, j)
            if end >= i or not "".join(lines[end + 1:i + 1]).strip():
                return j, end
        elif HEADING_LINE.match(body) and not heads_entry(lines, j):
            return None
    return None


# An entry's head, in parts, so td's `+`/`-` can move one of them and keep the rest as it is.
HEAD = re.compile(
    rf"""^(?P<prefix>{PREFIX})(?P<date>\d{{4}}-\d{{2}}-\d{{2}})(?P<sp>\s+)
        (?P<start>\d{{1,2}}:\d{{2}})(?P<dash>\s*[-–])
        (?:(?P<sp2>\s*)(?P<end>\d{{1,2}}:\d{{2}}))?
        (?P<dur>\s*=\s*(?:\d+h)?\s*(?:\d+min)?)?""",
    re.X,
)


def entry_head(line):
    """For td's `+`/`-`: the HEAD match of an entry line (groups prefix, date, sp, start, dash,
    sp2, end, dur; end and dur None when missing), or None when line is not a valid entry."""
    e, _ = parse(line)
    return HEAD.match(line) if e else None


def started_at(e):
    return datetime.strptime(f"{e.date} {hhmm(e.start)}", "%Y-%m-%d %H:%M")


def render(e, end):
    text = f"{e.prefix}{e.date} {hhmm(e.start)} - {hhmm(end)} = {dur_text(duration(e.start, end))}"
    return f"{text}  {e.note}" if e.note else text


def cmd_start(args):
    stamp = now().strftime("%Y-%m-%d %H:%M - ")
    if args[:1] != ["-"]:
        sys.stdout.write(stamp)
        return 0
    # tl start - [--file F]: the last step of `space , i`, on the whole buffer of F, the file `tl
    # next` printed. The line the key was pressed on is in FROM_PATH, if it was pressed in F.
    lines = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").splitlines(keepends=True)
    source = opt(args, "--file") or ""
    try:
        kept = FROM_PATH.read_text(encoding="utf-8").strip()
        FROM_PATH.unlink()
    except OSError:
        kept = ""
    m = re.fullmatch(r"(.+):(\d+)", kept)
    here = int(m[2]) - 1 if m and source and same_path(m[1], source) else None
    eol = next((raw[len(raw.rstrip("\r\n")):] for raw in lines if raw.endswith("\n")), "\n")

    def put(i, text):
        """text, a line of its own, at index i (after lines[i - 1], given its line ending)."""
        if i and not lines[i - 1].endswith("\n"):
            lines[i - 1] += eol
        lines.insert(i, text + eol)
        return i

    if here is not None and lines and is_td_inbox(Path(source)):
        here = min(here, len(lines) - 1)
        section = section_of(lines, here)
        if section:  # at the end of the todo's section, lined up with the todo
            j, end = section
            at = put(end + 1, re.match(r"[ \t]*", lines[j])[0] + stamp)
        elif not lines[here].strip():  # a blank line in no section: on it
            lines[here] = stamp + lines[here][len(lines[here].rstrip("\r\n")):]
            at = here
        else:
            at = put(here + 1, stamp)
    else:
        at = put(len(lines), stamp)
    GOTO_PATH.parent.mkdir(parents=True, exist_ok=True)
    GOTO_PATH.write_text(f"{source}:{at + 1}\n", encoding="utf-8", errors="surrogateescape")
    sys.stdout.buffer.write("".join(lines).encode("utf-8", "surrogateescape"))
    return 0


def same_path(a, b):
    """True when paths a and b name the same file, or are the same text (a buffer not on disk yet)."""
    try:
        return Path(a).expanduser().samefile(Path(b).expanduser())
    except OSError:
        return a == b


def cmd_close(args):
    t = now()
    text = sys.stdin.read()
    source = opt(args, "--file")
    inbox = bool(source and is_td_inbox(Path(source)))
    out = []
    for raw in text.splitlines(keepends=True):
        body = raw.rstrip("\r\n")
        e, _ = parse_in(body, inbox)  # unparseable and non-entry lines pass through untouched
        if e is not None:
            end = e.end if e.end is not None else end_minute(e, t)
            raw = render(e, end) + raw[len(body):]
        out.append(raw)
    sys.stdout.write("".join(out))
    return 0


def stop_lines(lines, t, inbox=False):
    """End, in place at t, the running entries in lines (those already started) -> their line
    numbers. inbox: the lines are td's inbox, whose todos are left alone."""
    stopped = []
    for i, raw in enumerate(lines):
        body = raw.rstrip("\r\n")
        e, _ = parse_in(body, inbox)
        if e is None or e.end is not None:
            continue
        if started_at(e) > t:
            continue  # not started yet
        lines[i] = render(e, end_minute(e, t)) + raw[len(body):]
        stopped.append(i + 1)
    return stopped


def cmd_stop(args):
    t = now()
    # bytes in and out, so line endings and odd bytes survive a whole-buffer :pipe
    if args[:1] == ["-"]:
        lines = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").splitlines(keepends=True)
        source = Path(args[2]) if args[1:2] == ["--file"] and len(args) > 2 else None
        stop_lines(lines, t, bool(source and is_td_inbox(source)))
        sys.stdout.buffer.write("".join(lines).encode("utf-8", "surrogateescape"))
        return 0
    stopped = stop_files(skip_arg(args), t)
    print(f"stopped {', '.join(stopped)}" if stopped else "", end="")  # no newline: for :echo %sh{}
    return 0


def skip_arg(args):
    return Path(args[1]) if args[:1] == ["--skip"] and len(args) > 1 else None


def stop_files(skip, t):
    """End, at t, the running entries in the task files on disk,
    but skip (its buffer gets `tl stop -`) -> where, as ["~/tasks/x.md:3", ...]."""
    _, files = recent_files(None)
    stopped = []
    for path in files or []:
        if skip and skip.is_file() and path.samefile(skip):
            continue
        lines = path.read_bytes().decode("utf-8", "surrogateescape").splitlines(keepends=True)
        closed = stop_lines(lines, t, is_td_inbox(path))
        if closed:
            path.write_bytes("".join(lines).encode("utf-8", "surrogateescape"))
            stopped += [f"{tilde(path)}:{n}" for n in closed]
    return stopped


# The buffer `space , i` was pressed in, and its line, as F:LINE, kept by `tl running` for `tl next`
# and `tl start -` while the key is in the running entry's buffer.
FROM_PATH = Path("~/.cache/tl/from").expanduser()


def opt(args, name):
    """The value after name in args, or None."""
    return args[args.index(name) + 1] if name in args[:-1] else None


def entry_starts(t):
    """-> ([(start, mtime, index, path)] of every entry already started, [the same] of those running),
    over the task files on disk; index is the line's, from 0.
    The latest (max) is the one started last: entries start on the minute, so for a task switch within
    one, the file written last holds the newer one (the switch writes both: it ends one entry, then
    starts the other), and in one file the lower line."""
    _, files = recent_files(None)
    starts, running = [], []
    for path in files or []:
        mtime, inbox = path.stat().st_mtime, is_td_inbox(path)
        for i, raw in enumerate(path.read_bytes().decode("utf-8", "surrogateescape").splitlines()):
            e, _ = parse_in(raw, inbox)
            if e is None or started_at(e) > t:
                continue
            key = (started_at(e), mtime, i, str(path))
            starts.append(key)
            if e.end is None:
                running.append(key)
    return starts, running


def cmd_running(args):
    """tl running [--from F[:LINE]]: the first step of `space , i`. Print the task file of the
    latest entry running on disk, so the key ends it in that file's buffer, where its unsaved edits
    are; F when nothing runs. F:LINE, the buffer the key was pressed in and its line, is kept for
    `tl next` and `tl start -`."""
    _, running = entry_starts(now())
    here = opt(args, "--from") or ""
    FROM_PATH.parent.mkdir(parents=True, exist_ok=True)
    FROM_PATH.write_text(here, encoding="utf-8")
    print(max(running)[-1] if running else re.sub(r":\d+$", "", here), end="")  # no newline: for :open %sh{}
    return 0


def cmd_next(args):
    """tl next [--skip R]: the last step of `space , i`, once the key has ended the entry in R's
    buffer. End the entries running in the other task files on disk, as `tl stop` does, and print
    the file to clock in to: the buffer `tl running` kept (it stays kept, with its line, for `tl
    start -`), else R."""
    t = now()
    skip = opt(args, "--skip")
    try:
        target = re.sub(r":\d+$", "", FROM_PATH.read_text(encoding="utf-8").strip()) or None
    except OSError:
        target = None
    stop_files(Path(skip) if skip else None, t)
    print(target or skip or "", end="")  # no newline: for :open %sh{}
    return 0


def cmd_where(args):
    """tl where [--from F:LINE]: `space , I`. Print the latest entry running
    as path:line, for :open %sh{}; F:LINE, where the key was pressed, if none runs. With
    --say, what the key echoes after: "running since HH:MM", or "nothing running". The key itself
    goes by --visit and --locate (see cmd_where_visit): the line on disk can be off in the buffer."""
    if "--visit" in args:
        return cmd_where_visit(args)
    if "--locate" in args:
        return cmd_where_locate(args)
    _, running = entry_starts(now())
    if "--say" in args:
        print(f"running since {max(running)[0]:%H:%M}" if running else "nothing running", end="")
        return 0
    if not running:
        print(opt(args, "--from") or "", end="")
        return 0
    _, _, i, path = max(running)
    print(f"{path}:{i + 1}", end="")
    return 0


def cmd_where_visit(args):
    """tl where --visit --from F:LINE: the first step of `space , I`. Print the task file of the
    latest entry running on disk (F if none), to :open; keep its path:line on disk in GOTO_PATH, or
    F:LINE if none runs, to come back to. See cmd_where_locate for the line in the buffer."""
    here = opt(args, "--from") or ""
    _, running = entry_starts(now())
    if running:
        _, _, i, path = max(running)
        target, shown = f"{path}:{i + 1}", path
    else:
        target, shown = here, re.sub(r":\d+$", "", here)
    GOTO_PATH.parent.mkdir(parents=True, exist_ok=True)
    GOTO_PATH.write_text(target + "\n", encoding="utf-8", errors="surrogateescape")
    print(shown, end="")  # no newline: for :open %sh{}
    return 0


def cmd_where_locate(args):
    """tl where --locate - [--file F]: the next step of `space , I`, on the whole buffer of F, the
    file cmd_where_visit printed. Keep the line of the latest entry running in the buffer in
    GOTO_PATH, as F:LINE, in place of the one on disk: the buffer can have edits not saved yet above
    the entry (a new todo at the top of todo.md), which move it. Prints nothing and changes nothing."""
    lines = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").splitlines(keepends=True)
    source = opt(args, "--file")
    i = latest_running(lines, bool(source and is_td_inbox(Path(source))), now())
    if i is not None and source:
        GOTO_PATH.parent.mkdir(parents=True, exist_ok=True)
        GOTO_PATH.write_text(f"{source}:{i + 1}\n", encoding="utf-8", errors="surrogateescape")
    return 0


def latest_running(lines, inbox, t):
    """The index of the latest-started entry running in lines (at the same minute, the later line),
    or None. inbox: the lines are td's inbox, whose todos are never entries."""
    running = []
    for i, raw in enumerate(lines):
        e, _ = parse_in(raw.rstrip("\r\n"), inbox)
        if e and e.end is None and started_at(e) <= t:
            running.append((started_at(e), i))
    return max(running)[1] if running else None


# Ends the prompt `space , O` leaves open: what you type after it is a shell comment, so it needs no quoting.
DONE_MARK = '"$BASH_EXECUTION_STRING" # done:'


def done_text(invocation):
    """What was typed after the prompt's DONE_MARK, stripped; "" with none."""
    return invocation.split(DONE_MARK, 1)[1].strip() if DONE_MARK in invocation else ""


def cmd_out(args):
    if "--visit" in args:
        return cmd_visit(args)
    if "--edit" in args:
        return cmd_edit(args)
    comment = done_text(" ".join(args))
    ended = end_latest(now(), comment)
    if not ended:
        print("nothing running")
        return 0
    path, i = ended
    print(f"stopped {tilde(path)}:{i + 1}" + (f"  # {comment}" if comment else ""))
    return 0


# Where `space , o` goes last, as path:line: the ended entry's heading, or with nothing running back
# where the key was pressed. `space , i` goes to its new entry, and `space , I` to the running one,
# the same way.
GOTO_PATH = Path("~/.cache/tl/goto").expanduser()


def cmd_visit(args):
    """tl out --visit --from F:LINE: the first step of `space , o`. Print the task file of the
    latest entry running on disk (F if none), so the key ends it in that file's buffer, where its
    unsaved edits are (see cmd_edit); keep F:LINE in GOTO_PATH, to go back to when nothing runs."""
    here = opt(args, "--from") or ""
    GOTO_PATH.parent.mkdir(parents=True, exist_ok=True)
    GOTO_PATH.write_text(here + "\n", encoding="utf-8", errors="surrogateescape")
    _, running = entry_starts(now())
    print(max(running)[-1] if running else re.sub(r":\d+$", "", here), end="")  # for :open %sh{}
    return 0


def cmd_edit(args):
    """tl out --edit - [--file F]: the next step of `space , o`, on the whole buffer of F, the
    file `tl out --visit` printed. End the latest entry running in it,
    as `tl out` does, and get its heading ready for the note you type next: "# " on a new line
    right above the entry, or " - " added to the heading already there (an empty "# " stays as it
    is; see add_heading). Keep the heading's line in GOTO_PATH, as F:LINE. In td's inbox too: its
    todos are never entries, but the heading goes above the entry as anywhere. If nothing runs in F,
    the text passes through unchanged and GOTO_PATH stays."""
    t = now()
    # bytes in and out, so line endings and odd bytes survive a whole-buffer :pipe
    lines = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").splitlines(keepends=True)
    source = opt(args, "--file")
    inbox = bool(source and is_td_inbox(Path(source)))
    i = latest_running(lines, inbox, t)
    if i is not None:
        body = lines[i].rstrip("\r\n")
        e = parse(body)[0]
        lines[i] = render(e, end_minute(e, t)) + lines[i][len(body):]
        i = add_heading(lines, i, "")
        GOTO_PATH.parent.mkdir(parents=True, exist_ok=True)
        GOTO_PATH.write_text(f"{source}:{i}\n", encoding="utf-8", errors="surrogateescape")
    sys.stdout.buffer.write("".join(lines).encode("utf-8", "surrogateescape"))
    return 0


def end_latest(t, comment=""):
    """End, at t, the latest-started entry running in the task files on
    disk, with comment as its heading (see add_heading) -> (path, index of its line), or None when
    nothing runs."""
    _, files = recent_files(None)
    running = []  # (start, path, index) of entries running
    for path in files or []:
        inbox = is_td_inbox(path)
        for i, raw in enumerate(path.read_bytes().decode("utf-8", "surrogateescape").splitlines()):
            e, _ = parse_in(raw, inbox)
            if e and e.end is None and started_at(e) <= t:
                running.append((started_at(e), str(path), i))
    if not running:
        return None
    _, path, i = max(running)
    path = Path(path)
    lines = path.read_bytes().decode("utf-8", "surrogateescape").splitlines(keepends=True)
    body = lines[i].rstrip("\r\n")
    e = parse(body)[0]
    lines[i] = render(e, end_minute(e, t)) + lines[i][len(body):]
    if comment:
        i = add_heading(lines, i, comment)
    path.write_bytes("".join(lines).encode("utf-8", "surrogateescape"))
    return path, i


def add_heading(lines, i, comment):
    """comment as the "# heading" right above the entry lines[i], or added to the heading already
    there (" - comment"; an empty "# " is filled) -> the entry's index after."""
    eol = lines[i][len(lines[i].rstrip("\r\n")):]
    above = lines[i - 1].rstrip("\r\n") if i else ""
    if i and HEADING_LINE.match(above):  # a heading already: add to it ("# " left empty counts)
        lines[i - 1] = (f"{above} - {comment}" if HEADING.match(above) else f"# {comment}") + lines[i - 1][len(above):]
        return i
    lines.insert(i, f"# {comment}{eol or chr(10)}")
    return i + 1


def tilde(path):
    home = str(Path.home())
    return "~" + str(path)[len(home):] if str(path).startswith(home + os.sep) else str(path)


def recent_files(limit):
    folder = Path(os.environ.get("TL_DIR", "~/tasks")).expanduser()
    if not folder.is_dir():
        return folder, None
    return folder, sorted(task_files(folder), key=lambda f: f.stat().st_mtime, reverse=True)[:limit]


def task_files(folder):
    """The task files: *.txt and *.md in folder, and td's inbox, wherever $TD_FILE puts it."""
    files = [*folder.glob("*.txt"), *folder.glob("*.md")]
    inbox = td_inbox()
    if inbox.is_file() and not any(is_td_inbox(f) for f in files):
        files.append(inbox)
    return files


def td_inbox():
    """td's inbox: $TD_FILE, default $TL_DIR/todo.md."""
    env = os.environ.get("TD_FILE")
    return Path(env).expanduser() if env else Path(os.environ.get("TL_DIR", "~/tasks")).expanduser() / "todo.md"


def is_td_inbox(path):
    """True for td's inbox. It holds td's todos, and `- [ ] 2026-10-12 09:00 - prep slides` there
    is a todo, not a running entry (see parse_in)."""
    try:
        return path.samefile(td_inbox())
    except OSError:
        return False


def cmd_recent(args):
    """tl recent [N]: numbered list of the N (default 9) most recently modified task files.
    tl recent --nth K [ELSE]: print just the path of the Kth one (no newline), for use in %sh{};
    if there is no Kth file print ELSE (the key bindings pass the current buffer, so :open is a no-op)."""
    if args[:1] == ["--nth"]:
        k = int(args[1])
        _, files = recent_files(k)
        found = files and len(files) >= k
        print(files[-1] if found else args[2] if len(args) > 2 else "", end="")
        return 0
    folder, files = recent_files(int(args[0]) if args else 9)
    if files is None:
        print(f"Task folder not found: {folder}\n(create it or set TL_DIR)")
        return 0
    for i, f in enumerate(files, 1):
        shown = tilde(f)
        stamp = datetime.fromtimestamp(f.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
        inbox = is_td_inbox(f)
        entries = [e for e, _ in (parse_in(raw, inbox) for raw in f.read_text(errors="replace").splitlines()) if e]
        last = max(entries, key=lambda e: (e.date, e.start), default=None)
        print(f"{i}  {shown}   {stamp}")
        if last:
            end = f" {hhmm(last.end)}" if last.end is not None else ""
            print(f"     last: {last.date} {hhmm(last.start)} -{end}  {last.note}".rstrip())
    return 0


def cmd_summary(arg, week=None):
    folder = Path(os.environ.get("TL_DIR", "~/tasks")).expanduser()
    if not folder.is_dir():
        # exit 0: Helix discards stdout of a failed command and only shows "status 1"
        print(f"Task folder not found: {folder}\n(create it or set TL_DIR)")
        return 0
    today = now().date()
    if arg not in (None, "all") and not arg.isdigit():
        sys.exit(__doc__)
    if week:  # Monday to Sunday of the week holding the date `week`
        monday = week - timedelta(days=week.weekday())
        sunday = monday + timedelta(days=6)
        first, last = monday.isoformat(), sunday.isoformat()
        scope = f"week {monday:%Y-%m-%d %a} to {sunday:%Y-%m-%d %a}"
    else:
        days = None if arg == "all" else int(arg or 14)
        first = None if days is None else (today - timedelta(days=days - 1)).isoformat()
        last = None
        scope = "all days" if days is None else f"last {days} day{'s' * (days != 1)}"

    totals = defaultdict(lambda: defaultdict(int))  # date -> task -> minutes
    done = defaultdict(lambda: defaultdict(dict))   # date -> task -> heading -> earliest start
    spans = defaultdict(list)                       # date -> [(start, end, file, line)]
    seen = {}                                       # (file, date, start, end) -> line
    warns = []                                      # (file, line, message)
    running = []                                    # (file, line, entry, heading), whatever the date
    titles = {}                                     # task -> its first line, "# " dropped, unless an entry

    for path in sorted(task_files(folder)):
        where = tilde(path)
        heading, fenced = "", False
        lines = path.read_text(errors="replace").splitlines()
        first_line = next((line.strip() for line in lines if line.strip()), "")
        h = HEADING.match(first_line)
        inbox = is_td_inbox(path)  # td's inbox: no title (its first line is a todo), entries under todos
        titles[path.stem] = "" if inbox else h.group(1) if h else "" if first_line.startswith("#") or ATTEMPT.match(first_line) else first_line
        for n, line in enumerate(lines, 1):
            if FENCE.match(line):
                fenced = not fenced
            elif not fenced and HEADING.match(line):
                heading = HEADING.match(line).group(1)
            e, err = parse_in(line, inbox)
            if e is None and err is None:
                continue
            # what the entry was for: the heading above it, or in td's inbox the todo it is under
            todo = section_of(lines, n - 1) if inbox else None
            above = HEADING.match(lines[n - 2]) if inbox and n >= 2 else None  # what you did, typed by `o`/`O`
            topic = above[1] if above else TODO.match(lines[todo[0]])["text"] if todo else heading
            if e and e.end is None:
                running.append((where, n, e, topic))
                continue
            day = e.date if e else ATTEMPT.match(line).group(1)
            if (first and day < first) or (last and day > last):
                continue
            if err:
                warns.append((where, n, f'{err}: "{line.strip()}"'))
                continue
            dur = duration(e.start, e.end)
            totals[e.date][path.stem] += dur
            if topic:
                headings = done[e.date][path.stem]
                headings[topic] = min(headings.get(topic, e.start), e.start)
            if dur > MAX_SANE:
                warns.append((where, n, f"duration {dur_text(dur)}, typo?"))
            if e.date > today.isoformat():
                warns.append((where, n, f"date {e.date} is in the future"))
            key = (where, e.date, e.start, e.end)
            if key in seen:
                warns.append((where, n, f"duplicate of line {seen[key]}"))
                continue
            seen[key] = n
            spans[e.date].append((e.start, e.start + dur, where, n))

    for day, items in spans.items():
        items.sort()
        prev = items[0]
        for cur in items[1:]:
            if cur[0] < prev[1]:
                warns.append((cur[2], cur[3], f"overlaps {prev[2]}:{prev[3]}"))
            if cur[1] > prev[1]:
                prev = cur

    if running:
        print("Still running:")
        loc = max(len(f"{f}:{n}") for f, n, _, _ in running)
        for f, n, e, heading in sorted(running, key=lambda r: (r[2].date, r[2].start), reverse=True):
            so_far = max(int((now() - started_at(e)).total_seconds()) // 60, 0)
            label = " - ".join(s for s in (heading, e.note) if s)
            print(f"  {f + ':' + str(n):<{loc}}  {e.date} {hhmm(e.start)}  {dur_text(so_far):>9}  {label}".rstrip())
        print()
    print(f"Time summary, {scope} ({folder})\n")
    if not totals:
        print("No complete entries found.")
    width = max((len(t) for d in totals.values() for t in d), default=0)
    grand = 0
    for day in sorted(totals, reverse=True):
        day_total = sum(totals[day].values())
        grand += day_total
        wd = date.fromisoformat(day).strftime("%a")
        print(f"{day} {wd}  {dur_text(day_total):>9}")
        for task, minutes in sorted(totals[day].items()):
            print(f"    {task:<{width}}  {dur_text(minutes):>9}  {titles[task]}".rstrip())
            headings = done[day][task]  # what was done, in time order; the title is on the task line already
            for heading in sorted(headings, key=headings.get):
                if heading != titles[task]:
                    print(f"      - {heading}")
    if totals:
        print(f"{'-' * 5}\nTotal ({len(totals)} day{'s' * (len(totals) != 1)})  {dur_text(grand)}")
    if warns:
        loc = max(len(f"{f}:{n}") for f, n, _ in warns)
        print("\nCheck by hand:")
        for f, n, msg in sorted(set(warns)):
            print(f"  {f + ':' + str(n):<{loc}}  {msg}")
    return 0


# The summary view `space , L` opens: a file of its own, read-only like td's agenda.
VIEW_PATH = Path("~/.cache/tl/summary.txt").expanduser()


def write_view(text):
    """Write text to VIEW_PATH, read-only (0444: it is a view, and Helix won't save over it), by
    a rename, which needs no write permission on the old file -> the path."""
    VIEW_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = VIEW_PATH.with_name(VIEW_PATH.name + ".tmp")
    tmp.unlink(missing_ok=True)
    tmp.write_text(text, encoding="utf-8", errors="surrogateescape")
    os.chmod(tmp, 0o444)
    os.replace(tmp, VIEW_PATH)
    return VIEW_PATH


def view_step(n):
    """For `+`/`-` on the summary view (td shift calls this): rewrite the view for the week n weeks
    after the one it shows, read from its first line; this week's when it shows no week."""
    shown = None
    if VIEW_PATH.is_file():
        m = re.match(r"Time summary, week (\d{4}-\d{2}-\d{2}) ", VIEW_PATH.read_text(errors="replace"))
        shown = date.fromisoformat(m[1]) if m else None
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        cmd_summary(None, (shown or now().date()) + timedelta(weeks=n))
    write_view(out.getvalue())


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "start":
        return cmd_start(argv[2:])
    elif cmd == "close":
        return cmd_close(argv[2:])
    elif cmd == "out":
        return cmd_out(argv[2:])
    elif cmd == "stop":
        return cmd_stop(argv[2:])
    elif cmd == "running":
        return cmd_running(argv[2:])
    elif cmd == "next":
        return cmd_next(argv[2:])
    elif cmd == "where":
        return cmd_where(argv[2:])
    elif cmd == "recent":
        return cmd_recent(argv[2:])
    elif cmd == "test":
        return run_tests("-v" in argv[2:])
    elif cmd == "summary":
        args = argv[2:]
        week, view = None, "--view" in args
        if "--week" in args:
            i = args.index("--week")
            week = now().date()
            if i + 1 < len(args) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", args[i + 1]):
                week = date.fromisoformat(args.pop(i + 1))
        args = [a for a in args if a not in ("--week", "--view")]
        if not view:
            return cmd_summary(args[0] if args else None, week)
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            cmd_summary(args[0] if args else None, week)
        print(write_view(out.getvalue()), end="")  # no newline: for :open %sh{}
    else:
        sys.exit(__doc__)
    return 0



def run_tests(verbose=False):
    """Each test runs this file as a subprocess, the way Helix does, with HOME a temporary folder holding the
    task folder (so paths print as ~/tasks/...) and the clock at NOW. Imports are here to keep plain runs fast."""
    import shlex
    import shutil
    import subprocess
    import tempfile
    import unittest

    NOW = "2026-10-09 14:05"  # a Friday
    TL = os.path.abspath(__file__)

    class Case(unittest.TestCase):
        maxDiff = None

        def setUp(self):
            tmp = tempfile.TemporaryDirectory()
            self.addCleanup(tmp.cleanup)
            self.home = Path(tmp.name)
            self.tasks = self.home / "tasks"
            self.tasks.mkdir()

        def put(self, name, text, folder=None):
            path = (folder or self.tasks) / name
            path.write_bytes(text.encode("utf-8", "surrogateescape"))
            return path

        def get(self, name):
            return (self.tasks / name).read_bytes().decode("utf-8", "surrogateescape")

        def tl(self, *args, stdin="", argv=None, **env):
            env = {**os.environ, "HOME": str(self.home), "TL_DIR": str(self.tasks), "TL_NOW": NOW, **env}
            done = subprocess.run(argv or [sys.executable, TL, *args], env=env, capture_output=True, check=True,
                                  input=stdin.encode("utf-8", "surrogateescape"))
            return done.stdout.decode("utf-8", "surrogateescape")

        def out(self, comment=""):
            # what bash hands `tl out` as "$BASH_EXECUTION_STRING" for `space , O`
            return self.tl("out", f'"$BASH_EXECUTION_STRING" # done: {comment}')

    class Parse(unittest.TestCase):
        def test_entry_forms(self):
            self.assertEqual(parse("2026-10-09 09:30 - 10:45 = 1h 15min  a note"),
                             (Entry("", "2026-10-09", 570, 645, "a note"), None))
            self.assertEqual(parse("  - [ ] 2026-10-09 9:05 -"), (Entry("  - [ ] ", "2026-10-09", 545, None, ""), None))
            e, _ = parse("2026-10-09 23:30 – 00:15")  # en dash, past midnight
            self.assertEqual(duration(e.start, e.end), 45)
            for state in " xXyYaAwW!":  # any of td's states: toggling a bullet keeps its entry
                self.assertEqual(parse(f"- [{state}] 2026-10-09 09:00 - 10:00")[0].end, 600, state)

        def test_rejects(self):
            self.assertEqual(parse("notes 2026-10-09 10:00 -"), (None, None))
            self.assertEqual(parse("2026-10-09 Fri   1h 00min"), (None, None))
            self.assertEqual(parse("2026-10-09 10:00 - 10:4"), (None, "can't parse"))
            self.assertEqual(parse("2026-10-09 25:00 - 26:00"), (None, "invalid date or time"))
            self.assertEqual(parse("2026-02-30 10:00 -"), (None, "invalid date or time"))
            # No dash after the time: a td reminder, not a broken entry.
            self.assertEqual(parse("2026-11-01 10:00"), (None, None))
            self.assertEqual(parse("- [ ] 2026-11-01 10:00 call the bank"), (None, None))

        def test_render(self):
            e, _ = parse("- 2026-10-09 23:30 -  late")
            self.assertEqual(render(e, 15), "- 2026-10-09 23:30 - 00:15 = 0h 45min  late")

        def test_in_td_inbox_a_todo_is_never_an_entry(self):
            for line in ("- [ ] 2026-10-09 09:00 - prep slides", "  - [x] 2026-10-09 09:00 - 10:00"):
                self.assertEqual(parse_in(line, True), (None, None))
                self.assertIsNotNone(parse_in(line, False)[0])
            for line in ("2026-10-09 09:00 -", "  2026-10-09 09:00 -", "  - 2026-10-09 09:00 -", "* [ ] 2026-10-09 09:00 -"):
                self.assertIsNotNone(parse_in(line, True)[0], line)

        def test_sections(self):
            lines = ["- [ ] a\n", "\n", "note at the left\n", "  - [ ] b\n", "\tb's note\n", "  b's too\n",
                     "a's note\n", "\n", "- [ ] c\n", "# heading\n", "under it\n", "- [ ] d"]
            self.assertEqual(section_end(lines, 0), 6)  # to the next todo at its indent, blank lines at the end left out
            self.assertEqual(section_end(lines, 3), 5)  # a sub-todo: to a line indented less (a tab is 4)
            self.assertEqual(section_end(lines, 8), 8)  # a heading ends it
            self.assertEqual(section_end(lines, 11), 11)
            self.assertEqual([section_of(lines, i) for i in range(12)],
                             [(0, 6), (0, 6), (0, 6), (3, 5), (3, 5), (3, 5), (0, 6), (0, 6), (8, 8), None, None, (11, 11)])

        def test_a_heading_right_above_an_entry_is_in_the_section(self):
            lines = ["- [ ] a\n", "# did x\n", "2026-10-09 13:00 - 13:30 = 0h 30min\n", "\n", "# \n",
                     "2026-10-09 14:00 -\n", "\n", "# a heading\n", "plain text\n", "- [ ] b\n", "# did y\n",
                     "  2026-10-09 15:00 -\n", "- [ ] c\n", "  - [ ] d\n", "# did z\n", "    2026-10-09 16:00 -\n",
                     "# at the left\n", "2026-10-09 17:00 -\n"]
            self.assertTrue(heads_entry(lines, 1) and heads_entry(lines, 4) and heads_entry(lines, 14))
            self.assertFalse(heads_entry(lines, 0) or heads_entry(lines, 7) or heads_entry(lines, len(lines) - 1))
            self.assertFalse(heads_entry(["# h\n", "- [ ] 2026-10-09 13:00 - x\n"], 0))  # a todo is no entry
            # a's section runs over both headed entries, and stops at the heading with text under it
            self.assertEqual(section_end(lines, 0), 5)
            # b's: the heading above its entry is its own, at the left though the entry is indented
            self.assertEqual(section_end(lines, 9), 11)
            # d's (a sub-todo): its heading is judged by the entry's indent: in, then out for an entry at the left,
            # which is c's
            self.assertEqual(section_end(lines, 13), 15)
            self.assertEqual(section_end(lines, 12), 17)
            self.assertEqual([section_of(lines, i) for i in (1, 2, 5, 10, 11, 14, 15)],
                             [(0, 5), (0, 5), (0, 5), (9, 11), (9, 11), (13, 15), (13, 15)])
            self.assertIsNone(section_of(lines, 7))  # a heading with text under it still ends a section

    class Commands(Case):
        def test_start(self):
            self.assertEqual(self.tl("start"), "2026-10-09 14:05 - ")

        def goto(self):
            return (self.home / ".cache" / "tl" / "goto").read_text().strip()

        def start(self, text, name, line=None, kept=None):
            """tl start - on the buffer of name, as space , i runs it, pressed on line (in name, or
            in the file kept)."""
            if line is not None:
                (self.home / ".cache" / "tl").mkdir(parents=True, exist_ok=True)
                (self.home / ".cache" / "tl" / "from").write_text(f"{kept or self.tasks / name}:{line}")
            return self.tl("start", "-", "--file", str(self.tasks / name), stdin=text)

        def test_start_on_a_new_last_line(self):
            a = self.put("A.md", "")
            for text, out, line in [("x\n", "x\n2026-10-09 14:05 - \n", 2),
                                    ("x", "x\n2026-10-09 14:05 - \n", 2),  # no final newline
                                    ("", "2026-10-09 14:05 - \n", 1),
                                    ("# A\r\n- [ ] sub\r\n", "# A\r\n- [ ] sub\r\n2026-10-09 14:05 - \r\n", 3)]:
                self.assertEqual(self.start(text, "A.md", 1), out)  # where it was pressed: the end anyway
                self.assertEqual(self.goto(), f"{a}:{line}")
                self.assertFalse((self.home / ".cache" / "tl" / "from").exists())

        def test_start_in_td_inbox_where_it_was_pressed(self):
            todo = self.put("todo.md", "")
            text = ("- [ ] prep slides\n\ncheck deck\n  2026-10-09 09:00 - 10:00 = 1h 00min\n\n"
                    "- [ ] call mom\n\n# later\nplain\n\n")
            entry = "2026-10-09 14:05 - "
            lines = text.splitlines(keepends=True)
            for pressed, at in [(1, 4), (2, 4), (3, 4), (4, 4),  # in its section: at its end, lined up with the todo
                                (5, 4),  # a blank line after the section counts
                                (6, 6), (7, 6),  # a todo with nothing under it: right under it
                                (8, 8), (9, 9)]:  # in no section (a heading ends one): below the line
                want = "".join(lines[:at] + [entry + "\n"] + lines[at:])
                self.assertEqual(self.start(text, "todo.md", pressed), want, pressed)
                self.assertEqual(self.goto(), f"{todo}:{at + 1}")
            # a blank line in no section: on it (past the end: the last line)
            for pressed in (10, 99):
                self.assertEqual(self.start(text, "todo.md", pressed), text[:-1] + entry + "\n")
                self.assertEqual(self.goto(), f"{todo}:10")
            # pressed in another buffer (tl next came back to todo.md some other way): the end
            self.assertEqual(self.start(text, "todo.md", 1, kept=self.tasks / "A.md"), text + entry + "\n")
            self.assertEqual(self.start(text, "todo.md"), text + entry + "\n")

        def test_start_in_td_inbox_on_a_heading_above_an_entry(self):
            # `o`'s heading is in the todo's section: pressed on it or its entry, the new entry goes at the
            # section's end, past the headed one
            self.put("todo.md", "")
            text = "- [ ] a\n# did x\n2026-10-09 13:00 - 13:30 = 0h 30min\n\n- [ ] b\n"
            lines = text.splitlines(keepends=True)
            for pressed in (1, 2, 3):
                want = "".join(lines[:3] + ["2026-10-09 14:05 - \n"] + lines[3:])
                self.assertEqual(self.start(text, "todo.md", pressed), want, pressed)

        def test_start_in_td_inbox_nested_todos(self):
            self.put("todo.md", "")
            text = "- [ ] a\n  - [ ] b\n    note b\nnote a\n- [ ] c\n\tnote c"
            self.assertEqual(self.start(text, "todo.md", 3),  # under b, lined up with it
                             "- [ ] a\n  - [ ] b\n    note b\n  2026-10-09 14:05 - \nnote a\n- [ ] c\n\tnote c")
            for pressed in (1, 4):  # a's note comes after b's section
                self.assertEqual(self.start(text, "todo.md", pressed),
                                 "- [ ] a\n  - [ ] b\n    note b\nnote a\n2026-10-09 14:05 - \n- [ ] c\n\tnote c")
            self.assertEqual(self.start(text, "todo.md", 5),
                             "- [ ] a\n  - [ ] b\n    note b\nnote a\n- [ ] c\n\tnote c\n2026-10-09 14:05 - \n")

        def test_close_stamps_and_refreshes_entries_only(self):
            text = "# h\n2026-10-09 13:00 -  open\n2026-10-09 09:00 - 10:30 = 9h 99min\nnot 2026-10-09 10:00 -\n"
            self.assertEqual(self.tl("close", stdin=text),
                             "# h\n2026-10-09 13:00 - 14:05 = 1h 05min  open\n"
                             "2026-10-09 09:00 - 10:30 = 1h 30min\nnot 2026-10-09 10:00 -\n")

        def test_close_in_td_inbox_leaves_its_todos(self):
            # space , u in todo.md: its todos are not entries, the lines under them can be
            text = "- [ ] 2026-10-09 13:00 - prep slides\n  2026-10-09 13:30 -\n"
            todo = self.put("todo.md", text)
            self.assertEqual(self.tl("close", "--file", str(todo), stdin=text),
                             "- [ ] 2026-10-09 13:00 - prep slides\n  2026-10-09 13:30 - 14:05 = 0h 35min\n")
            text = "- [ ] 2026-10-09 13:00 - prep slides\n"
            other = self.put("A.md", text)
            self.assertEqual(self.tl("close", "--file", str(other), stdin=text),
                             "- [ ] 2026-10-09 13:00 - 14:05 = 1h 05min  prep slides\n")

        def test_stop_files(self):
            self.put("A.md", "# A\r\n2026-10-09 13:00 -  a\r\n")
            self.put("B.txt", "2026-10-09 13:30 -")  # no final newline
            self.put("C.md", "2026-09-01 10:00 -  forgotten\n")  # however long ago, it is running; ended at one minute
            self.put("E.log", "2026-10-09 13:00 -\n")  # not a task file
            skip = self.put("D.md", "2026-10-09 13:45 -\n")
            out = self.tl("stop", "--skip", str(skip))
            self.assertTrue(out.startswith("stopped "))
            self.assertEqual(sorted(out[len("stopped "):].split(", ")),
                             ["~/tasks/A.md:2", "~/tasks/B.txt:1", "~/tasks/C.md:1"])
            self.assertEqual(self.get("A.md"), "# A\r\n2026-10-09 13:00 - 14:05 = 1h 05min  a\r\n")
            self.assertEqual(self.get("B.txt"), "2026-10-09 13:30 - 14:05 = 0h 35min")
            self.assertEqual(self.get("C.md"), "2026-09-01 10:00 - 10:01 = 0h 01min  forgotten\n")  # one minute
            for name, text in [("E.log", "2026-10-09 13:00 -\n"), ("D.md", "2026-10-09 13:45 -\n")]:
                self.assertEqual(self.get(name), text)
            self.assertEqual(self.tl("stop", "--skip", str(skip)), "")

        def test_a_forgotten_entry_is_closed_at_one_minute(self):
            # over MAX_SANE (12h) at 14:05: the end has no date, so only a mark on the timeline is kept
            for start, end in [("2026-10-09 02:04", "02:05 = 0h 01min"),  # 12h 01min: forgotten
                               ("2026-10-09 02:05", "14:05 = 12h 00min"),  # 12h exactly: still counts
                               ("2026-10-08 14:05", "14:06 = 0h 01min"),  # a day
                               ("2026-10-08 23:59", "00:00 = 0h 01min"),  # one minute over midnight
                               ("2026-09-01 10:00", "10:01 = 0h 01min")]:
                with self.subTest(start=start):
                    self.assertEqual(self.tl("close", stdin=f"{start} -  x\n"), f"{start} - {end}  x\n")
                    self.assertEqual(self.tl("stop", "-", stdin=f"{start} -  x\n"), f"{start} - {end}  x\n")
            # an entry with an end is left alone, however long
            self.assertEqual(self.tl("close", stdin="2026-09-01 10:00 - 23:00 = 9h 99min\n"),
                             "2026-09-01 10:00 - 23:00 = 13h 00min\n")

        def test_out_and_edit_close_a_forgotten_entry_at_one_minute(self):
            self.put("A.md", "2026-10-06 01:00 -\n")
            self.assertEqual(self.out("left open"), "stopped ~/tasks/A.md:2  # left open\n")
            self.assertEqual(self.get("A.md"), "# left open\n2026-10-06 01:00 - 01:01 = 0h 01min\n")
            self.assertEqual(self.tl("out", "--edit", "-", "--file", str(self.tasks / "B.md"),
                                     stdin="2026-10-06 01:00 -\n"), "# \n2026-10-06 01:00 - 01:01 = 0h 01min\n")

        def test_stop_stdin_changes_only_running_lines(self):
            text = "caf\udce9 \r\n2026-10-09 13:00 -\r\n2026-10-09 12:00 - 12:30 = 9h\nend"  # \udce9: a non-UTF-8 byte
            self.assertEqual(self.tl("stop", "-", stdin=text),
                             text.replace("13:00 -\r", "13:00 - 14:05 = 1h 05min\r"))

        def test_stop_stdin_in_td_inbox_leaves_its_todos(self):
            # space , i in todo.md: its todos are not running entries, the lines under them can be
            text = "- [ ] 2026-10-09 13:00 - prep slides\n\t2026-10-09 13:30 -\n"
            todo = self.put("todo.md", text)
            self.assertEqual(self.tl("stop", "-", "--file", str(todo), stdin=text),
                             "- [ ] 2026-10-09 13:00 - prep slides\n\t2026-10-09 13:30 - 14:05 = 0h 35min\n")
            text = "- [ ] 2026-10-09 13:00 - prep slides\n"
            other = self.put("A.md", text)
            self.assertEqual(self.tl("stop", "-", "--file", str(other), stdin=text),
                             "- [ ] 2026-10-09 13:00 - 14:05 = 1h 05min  prep slides\n")

        def test_recent(self):
            a = self.put("A.md", "2026-10-08 09:00 - 10:00  first\n2026-10-09 13:00 -\n")
            b = self.put("B.txt", "no entries\n")
            self.put("C.log", "")
            os.utime(a, (0, 2000))
            os.utime(b, (0, 1000))
            self.assertEqual(self.tl("recent", "--nth", "2"), str(b))
            self.assertEqual(self.tl("recent", "--nth", "3", "ELSE"), "ELSE")
            lines = self.tl("recent").splitlines()
            self.assertEqual(len(lines), 3)
            self.assertTrue(lines[0].startswith("1  ~/tasks/A.md   "))
            self.assertEqual(lines[1], "     last: 2026-10-09 13:00 -")
            self.assertTrue(lines[2].startswith("2  ~/tasks/B.txt   "))
            todo = self.put("todo.md", "- [ ] 2026-10-09 13:00 - call\n  2026-10-09 12:00 - 12:30\n")
            os.utime(todo, (0, 3000))
            self.assertEqual(self.tl("recent").splitlines()[1], "     last: 2026-10-09 12:00 - 12:30")

        def test_td_inbox_todos_left_alone(self):
            # td's inbox holds todos: a bullet that starts with a time there is not a running entry
            todo = "- [ ] 2026-10-09 13:00 - prep slides\n"
            self.put("todo.md", todo)
            self.put("A.md", "2026-10-09 13:30 -\n")
            self.assertEqual(self.tl("stop"), "stopped ~/tasks/A.md:1")
            self.assertEqual(self.out("x"), "nothing running\n")
            self.assertNotIn("todo.md", self.tl("summary"))
            self.assertEqual(self.get("todo.md"), todo)
            # $TD_FILE moves the inbox; todo.md is then an ordinary task file
            inbox = self.put("inbox.md", todo)
            self.assertEqual(self.tl("stop", TD_FILE=str(inbox)), "stopped ~/tasks/todo.md:1")
            self.assertEqual(self.get("inbox.md"), todo)

        def test_td_inbox_entries_are_entries(self):
            # the lines under a todo in td's inbox can be entries; the inbox counts wherever it is
            self.put("todo.md", "- [ ] prep slides\n  2026-10-09 13:30 -\n")
            self.assertEqual(self.tl("where"), f"{self.tasks / 'todo.md'}:2")
            self.assertEqual(self.tl("stop"), "stopped ~/tasks/todo.md:2")
            self.assertEqual(self.get("todo.md"), "- [ ] prep slides\n  2026-10-09 13:30 - 14:05 = 0h 35min\n")
            outside = self.home / "inbox.md"
            outside.write_text("- [ ] call\n  2026-10-09 13:50 -\n")
            self.assertEqual(self.tl("where", TD_FILE=str(outside)), f"{outside}:2")
            self.assertEqual(self.tl("where"), "")  # not the inbox: not a task file

    class Out(Case):
        def test_latest_running_entry_gets_a_new_heading(self):
            self.put("A.md", "# A\nnotes\n2026-10-09 13:00 -\n")
            self.put("B.md", "# B\nx\n2026-10-09 13:30 -  note\nmore\n")
            self.assertEqual(self.out("did b"), "stopped ~/tasks/B.md:4  # did b\n")
            self.assertEqual(self.get("B.md"), "# B\nx\n# did b\n2026-10-09 13:30 - 14:05 = 0h 35min  note\nmore\n")
            self.assertEqual(self.get("A.md"), "# A\nnotes\n2026-10-09 13:00 -\n")

        def test_adds_to_the_heading_above(self):
            self.put("A.md", "# Title\n2026-10-09 13:00 -\n")
            self.out("more")
            self.assertEqual(self.get("A.md"), "# Title - more\n2026-10-09 13:00 - 14:05 = 1h 05min\n")

        def test_fills_an_empty_heading(self):
            self.put("A.md", "# \r\n2026-10-09 13:00 -\r\n")
            self.out("fill")
            self.assertEqual(self.get("A.md"), "# fill\r\n2026-10-09 13:00 - 14:05 = 1h 05min\r\n")

        def test_no_comment_no_heading(self):
            self.put("A.md", "notes\n2026-10-09 13:00 -\n")
            self.assertEqual(self.out(), "stopped ~/tasks/A.md:2\n")
            self.assertEqual(self.get("A.md"), "notes\n2026-10-09 13:00 - 14:05 = 1h 05min\n")

        def test_in_td_inbox_the_comment_is_the_heading_too(self):
            self.put("todo.md", "- [ ] prep slides\n  2026-10-09 13:30 -\n- [ ] call\n")
            self.assertEqual(self.out("outline"), "stopped ~/tasks/todo.md:3  # outline\n")
            self.assertEqual(self.get("todo.md"),
                             "- [ ] prep slides\n# outline\n  2026-10-09 13:30 - 14:05 = 0h 35min\n- [ ] call\n")
            self.put("todo.md", "- [ ] prep slides\n# deck\n  2026-10-09 13:30 -\n")
            self.out("outline")
            self.assertEqual(self.get("todo.md"), "- [ ] prep slides\n# deck - outline\n  2026-10-09 13:30 - 14:05 = 0h 35min\n")
            self.put("todo.md", "- [ ] prep slides\n  2026-10-09 13:30 -\n")
            self.out()
            self.assertEqual(self.get("todo.md"), "- [ ] prep slides\n  2026-10-09 13:30 - 14:05 = 0h 35min\n")

        def test_entry_on_first_line_without_newline(self):
            self.put("A.md", "2026-10-09 13:00 -")
            self.assertEqual(self.out("top"), "stopped ~/tasks/A.md:2  # top\n")
            self.assertEqual(self.get("A.md"), "# top\n2026-10-09 13:00 - 14:05 = 1h 05min")

        def test_nothing_running(self):
            text = "2026-10-09 15:00 -  not started yet\n2026-10-09 09:00 - 10:00\n"
            self.put("A.md", text)
            self.assertEqual(self.out("x"), "nothing running\n")
            self.assertEqual(self.get("A.md"), text)

        @unittest.skipUnless(shutil.which("bash"), "needs bash")
        def test_comment_needs_no_quoting_through_bash(self):
            self.put("A.md", "2026-10-09 13:00 -\n")
            comment = "it's (part 2) \"q\" $HOME `id` & ; | 50%"
            line = f'{shlex.quote(sys.executable)} {shlex.quote(TL)} out "$BASH_EXECUTION_STRING" # done: {comment}'
            self.tl(argv=["bash", "-c", line])
            self.assertEqual(self.get("A.md"), f"# {comment}\n2026-10-09 13:00 - 14:05 = 1h 05min\n")

    class OutEdit(Case):
        """tl out --visit, then tl out --edit on that file's buffer, as space , o runs them; the key
        then opens ~/.cache/tl/goto in insert mode at its line's end."""

        def goto(self):
            return (self.home / ".cache" / "tl" / "goto").read_text().strip()

        def visit(self, here="here.md:7"):
            return self.tl("out", "--visit", "--from", here)

        def edit(self, text, name="B.md"):
            return self.tl("out", "--edit", "-", "--file", str(self.tasks / name), stdin=text)

        def test_ends_the_entry_in_the_buffer_and_readies_a_heading(self):
            b = self.put("B.md", "# B\nnotes\n2026-10-09 13:00 -\n")
            self.put("C.md", "2026-10-09 08:00 -\n")  # running too, started earlier: left as O leaves it
            self.assertEqual(self.visit(), str(b))
            # The buffer has an edit not saved yet: it is what changes, edit kept.
            out = self.edit("# B\nnotes, more\n2026-10-09 13:00 -\n")
            self.assertEqual(out, "# B\nnotes, more\n# \n2026-10-09 13:00 - 14:05 = 1h 05min\n")
            self.assertEqual(self.goto(), f"{b}:3")
            self.assertEqual(self.get("B.md"), "# B\nnotes\n2026-10-09 13:00 -\n")  # the key saves
            self.assertEqual(self.get("C.md"), "2026-10-09 08:00 -\n")

        def test_adds_to_the_heading_there(self):
            b = self.put("B.md", "")
            self.assertEqual(self.edit("# B\n# parser\n2026-10-09 13:00 -\n"),
                             "# B\n# parser - \n2026-10-09 13:00 - 14:05 = 1h 05min\n")
            self.assertEqual(self.goto(), f"{b}:2")
            # An empty "# " (an Esc'd note last time) is used as it is.
            self.assertEqual(self.edit("# \n2026-10-09 14:00 -\n"),
                             "# \n2026-10-09 14:00 - 14:05 = 0h 05min\n")
            self.assertEqual(self.goto(), f"{b}:1")

        def test_latest_of_two_running_in_the_buffer(self):
            self.put("B.md", "")
            out = self.edit("2026-10-09 13:00 -\n2026-10-09 13:30 -\n")
            self.assertEqual(out, "2026-10-09 13:00 -\n# \n2026-10-09 13:30 - 14:05 = 0h 35min\n")

        def test_nothing_running_goes_back(self):
            self.put("B.md", "2026-10-09 09:00 - 10:00\n")
            self.assertEqual(self.visit("here.md:7"), "here.md")
            text = "- [ ] alpha\n"
            self.assertEqual(self.edit(text, "here.md"), text)
            self.assertEqual(self.goto(), "here.md:7")

        def test_inbox_todos_pass_through(self):
            # td's inbox: a bullet shaped like an entry is a todo, never ended.
            inbox = self.put("todo.md", "")
            text = "- [ ] 2026-10-09 13:00 - call\n"
            self.visit(f"{inbox}:1")
            self.assertEqual(self.edit(text, "todo.md"), text)
            self.assertEqual(self.goto(), f"{inbox}:1")

        def test_inbox_heading_above_the_entry(self):
            # td's inbox too: the heading goes right above the entry, as in any task file
            inbox = self.put("todo.md", "")
            self.assertEqual(self.edit("- [ ] prep\n  2026-10-09 13:00 -\n- [ ] call\n", "todo.md"),
                             "- [ ] prep\n# \n  2026-10-09 13:00 - 14:05 = 1h 05min\n- [ ] call\n")
            self.assertEqual(self.goto(), f"{inbox}:2")
            self.assertEqual(self.edit("- [ ] prep\r\n# deck\r\n  2026-10-09 13:00 -\r\n", "todo.md"),
                             "- [ ] prep\r\n# deck - \r\n  2026-10-09 13:00 - 14:05 = 1h 05min\r\n")

        def test_keeps_the_files_line_endings(self):
            b = self.put("B.md", "")
            self.assertEqual(self.edit("notes\r\n2026-10-09 13:00 -\r\n"),
                             "notes\r\n# \r\n2026-10-09 13:00 - 14:05 = 1h 05min\r\n")
            self.assertEqual(self.goto(), f"{b}:2")

    class Switch(Case):
        """tl running / tl next, as space , i runs them, and tl where, as space , I does."""

        def test_running_names_the_file_to_end_the_entry_in(self):
            a = self.put("A.md", "2026-10-09 09:00 - 10:00\n2026-10-09 13:00 -\n")
            b = self.put("B.md", "2026-10-09 10:00 - 11:00\n")
            self.assertEqual(self.tl("running", "--from", str(b)), str(a))
            self.assertEqual(self.get("A.md"), "2026-10-09 09:00 - 10:00\n2026-10-09 13:00 -\n")
            self.put("A.md", "2026-10-09 09:00 - 10:00\n")
            self.assertEqual(self.tl("running", "--from", str(b)), str(b))  # nothing runs: stay

        def test_clock_in_here_from_another_file(self):
            # space , i in B while A runs: end it in A's buffer, then come back to B.
            a = self.put("A.md", "2026-10-09 13:00 -\n")
            b = self.put("B.md", "2026-10-09 10:00 - 11:00\n")
            c = self.put("C.md", "2026-10-09 13:30 -\n")  # a second one running: ended on disk
            self.assertEqual(self.tl("running", "--from", f"{b}:1"), str(c))
            self.assertEqual(self.tl("next", "--skip", str(c)), str(b))
            self.assertEqual(self.get("A.md"), "2026-10-09 13:00 - 14:05 = 1h 05min\n")
            self.assertEqual(self.get("C.md"), "2026-10-09 13:30 -\n")  # its buffer ends it
            # kept, with its line, for tl start -
            self.assertEqual((self.home / ".cache" / "tl" / "from").read_text(), f"{b}:1")
            self.put("C.md", "2026-10-09 13:30 - 14:05\n")
            self.assertEqual(self.tl("running", "--from", f"{b}:1"), str(b))  # nothing runs: stay

        def test_next_without_a_kept_buffer_stays(self):
            self.assertEqual(self.tl("next", "--skip", "nowhere.md"), "nowhere.md")

        def test_where_is_the_running_entry(self):
            self.put("A.md", "2026-10-09 09:00 - 10:00\n2026-10-09 11:00 -\n")  # running, started earlier
            b = self.put("B.md", "# B\nnotes\n2026-10-09 12:00 - 13:00\n2026-10-09 13:30 -  writing\n")
            self.assertEqual(self.tl("where", "--from", "here.md:7"), f"{b}:4")
            self.assertEqual(self.tl("where", "--say"), "running since 13:30")
            self.assertEqual(self.get("B.md"), "# B\nnotes\n2026-10-09 12:00 - 13:00\n2026-10-09 13:30 -  writing\n")

        def test_where_goes_by_the_line_in_the_buffer(self):
            # space , I: --visit names the file and keeps the line on disk; --locate, on the buffer, replaces
            # it with the buffer's own, which a new todo at the top, not saved yet, has moved.
            goto = self.home / ".cache" / "tl" / "goto"
            self.put("A.md", "2026-10-09 09:00 - 10:00\n")
            todo = self.put("todo.md", "- [ ] prep\nnotes\n  2026-10-09 13:30 -\n- [ ] call\n")
            self.assertEqual(self.tl("where", "--visit", "--from", "here.md:7"), str(todo))
            self.assertEqual(goto.read_text().strip(), f"{todo}:3")
            buffer = "- [ ] new\n- [ ] prep\nnotes\n  2026-10-09 13:30 -\n- [ ] call\n"
            self.assertEqual(self.tl("where", "--locate", "-", "--file", str(todo), stdin=buffer), "")
            self.assertEqual(goto.read_text().strip(), f"{todo}:4")
            self.assertEqual(self.get("todo.md"), "- [ ] prep\nnotes\n  2026-10-09 13:30 -\n- [ ] call\n")
            # a todo shaped like an entry is none; with nothing running in the buffer the goto stays
            self.tl("where", "--locate", "-", "--file", str(todo), stdin="- [ ] 2026-10-09 13:30 - x\n")
            self.assertEqual(goto.read_text().strip(), f"{todo}:4")

        def test_where_visit_with_nothing_running_stays(self):
            goto = self.home / ".cache" / "tl" / "goto"
            self.put("A.md", "2026-10-09 09:00 - 10:00\n")
            self.assertEqual(self.tl("where", "--visit", "--from", "here.md:7"), "here.md")
            self.assertEqual(goto.read_text().strip(), "here.md:7")

        def test_where_with_nothing_running_stays(self):
            self.put("todo.md", "- [ ] 2026-10-09 13:50 - prep slides\n")  # a todo, not an entry
            self.put("A.md", "2026-10-09 09:00 - 10:00\n2026-10-09 18:00 -\n")  # 18:00: future
            self.assertEqual(self.tl("where", "--from", "here.md:7"), "here.md:7")
            self.assertEqual(self.tl("where", "--say"), "nothing running")

        def test_an_entry_running_for_days_is_running(self):
            self.put("C.md", "# C\n2026-10-06 01:00 -\n")
            self.assertEqual(self.tl("where", "--say"), "running since 01:00")
            self.assertEqual(self.tl("where", "--from", "here.md:7"), f"{self.tasks / 'C.md'}:2")
            self.assertEqual(self.tl("out", "--visit", "--from", "here.md:7"), str(self.tasks / "C.md"))
            self.assertEqual(self.out("x"), "stopped ~/tasks/C.md:2  # x\n")
            self.assertEqual(self.get("C.md"), "# C - x\n2026-10-06 01:00 - 01:01 = 0h 01min\n")  # forgotten: one minute

        def test_same_minute_running_goes_by_the_file_written_last(self):
            a = self.put("A.md", "2026-10-09 14:00 - 14:05\n")
            b = self.put("B.md", "2026-10-09 14:00 -\n")
            c = self.put("C.md", "2026-10-09 14:00 -\n")
            os.utime(b, (5000, 5000))
            os.utime(c, (4000, 4000))
            self.assertEqual(self.tl("running", "--from", str(a)), str(b))
            self.assertEqual(self.tl("where"), f"{b}:1")

    class Summary(Case):
        def test_one_line_per_task_and_day_with_heading_bullets(self):
            self.put("A.md", "# Title A\n2026-10-09 11:00 - 12:00\n"
                             "```py\n# not a heading\n```\n2026-10-09 09:00 - 09:30\n"
                             " #+BEGIN_SRC\n# org comment\n#+END_SRC\n"
                             "## Second ##\n2026-10-09 08:00 - 08:15  note\n2026-10-08 13:00 - 14:00\n"
                             "#tag\n# \n2026-10-08 15:00 - 15:30\n")
            self.put("B.md", "2026-10-09 12:00 - 12:45\n# Bee\n2026-10-09 13:00 - 13:10\n")  # no title: an entry
            self.put("C.md", "\nPlain title\n2026-10-09 07:00 - 07:30\n")
            self.assertEqual(self.tl("summary", "3"),
                             f"Time summary, last 3 days ({self.tasks})\n\n"
                             "2026-10-09 Fri   3h 10min\n"
                             "    A   1h 45min  Title A\n      - Second\n"
                             "    B   0h 55min\n      - Bee\n"
                             "    C   0h 30min  Plain title\n"
                             "2026-10-08 Thu   1h 30min\n"
                             "    A   1h 30min  Title A\n      - Second\n"
                             "-----\nTotal (2 days)  4h 40min\n")

        def test_td_inbox_entries_under_their_todos(self):
            self.put("todo.md", "- [ ] 2026-10-09 08:00 - 09:00 = 1h  not counted\n"
                                "- [ ] prep slides\n  deck\n  2026-10-09 09:00 - 10:00\n"
                                "  - [ ] print\n    2026-10-09 10:00 - 10:15\n"
                                "- [A] call\n\t2026-10-09 13:00 -  bank\n"
                                "# misc\n2026-10-09 11:00 - 11:30\n")  # under a heading, no todo: the heading
            self.assertEqual(self.tl("summary", "1"),
                             "Still running:\n"
                             "  ~/tasks/todo.md:8  2026-10-09 13:00   1h 05min  call - bank\n\n"
                             f"Time summary, last 1 day ({self.tasks})\n\n"
                             "2026-10-09 Fri   1h 45min\n"
                             "    todo   1h 45min\n      - prep slides\n      - print\n      - misc\n"
                             "-----\nTotal (1 day)  1h 45min\n")

        def test_td_inbox_heading_above_an_entry_is_its_topic(self):
            # the entry is in the todo's section, but what you typed in `o`'s heading is the bullet
            self.put("todo.md", "- [ ] prep slides\n# outline\n2026-10-09 09:00 - 10:00\n"
                                "2026-10-09 10:00 - 10:15\n# \n2026-10-09 10:15 - 10:30\n")
            self.assertEqual(self.tl("summary", "1"),
                             f"Time summary, last 1 day ({self.tasks})\n\n"
                             "2026-10-09 Fri   1h 30min\n"
                             "    todo   1h 30min\n      - outline\n      - prep slides\n"
                             "-----\nTotal (1 day)  1h 30min\n")

        def test_titles_leave_out_tds_state(self):
            self.put("A.md", "# [A] Title A\n2026-10-09 11:00 - 12:00\n## [x] Second\n2026-10-09 12:00 - 12:30\n")
            self.assertIn("    A   1h 30min  Title A\n      - Second\n", self.tl("summary", "1"))

        def test_running_entries_first_whatever_their_date(self):
            self.put("C.md", "# Cee\n2026-10-09 13:30 -  running note\n2026-09-01 10:00 -  forgotten\n")
            self.assertEqual(self.tl("summary"),
                             "Still running:\n"
                             "  ~/tasks/C.md:2  2026-10-09 13:30   0h 35min  Cee - running note\n"
                             "  ~/tasks/C.md:3  2026-09-01 10:00  916h 05min  Cee - forgotten\n\n"
                             f"Time summary, last 14 days ({self.tasks})\n\nNo complete entries found.\n")

        def test_check_by_hand(self):
            self.put("W.md", "2026-10-09 09:00 - 10:00\n2026-10-09 09:30 - 10:30\n2026-10-09 09:00 - 10:00\n"
                             "2026-10-10 09:00 - 10:00\n2026-10-08 06:00 - 23:00\n2026-10-08 25:00 - 26:00\n"
                             "2026-10-08 10:00 - 10:4\n2026-10-09 16:00\n")  # last: a td reminder, not flagged
            self.assertTrue(self.tl("summary").endswith(
                "Check by hand:\n"
                "  ~/tasks/W.md:2  overlaps ~/tasks/W.md:1\n"
                "  ~/tasks/W.md:3  duplicate of line 1\n"
                "  ~/tasks/W.md:4  date 2026-10-10 is in the future\n"
                "  ~/tasks/W.md:5  duration 17h 00min, typo?\n"
                '  ~/tasks/W.md:6  invalid date or time: "2026-10-08 25:00 - 26:00"\n'
                '  ~/tasks/W.md:7  can\'t parse: "2026-10-08 10:00 - 10:4"\n'))

        def test_days_window(self):
            self.put("A.md", "2026-10-01 10:00 - 11:00\n2026-10-09 10:00 - 10:30\n")
            self.assertNotIn("2026-10-01", self.tl("summary", "3"))
            for arg in ("9", "all"):
                out = self.tl("summary", arg)
                self.assertIn("2026-10-01 Thu   1h 00min\n", out)
                self.assertIn("Total (2 days)  1h 30min\n", out)

        def test_this_week(self):
            # NOW is Friday 2026-10-09: the week is Monday 10-05 to Sunday 10-11.
            self.put("A.md", "# Alpha\n2026-10-04 09:00 - 10:00\n2026-10-05 09:00 - 10:30\n"
                             "# Fixing\n2026-10-09 13:00 - 14:00\n2026-10-12 09:00 - 10:00\n")
            self.assertEqual(self.tl("summary", "--week"),
                             f"Time summary, week 2026-10-05 Mon to 2026-10-11 Sun ({self.tasks})\n\n"
                             "2026-10-09 Fri   1h 00min\n    A   1h 00min  Alpha\n      - Fixing\n"
                             "2026-10-05 Mon   1h 30min\n    A   1h 30min  Alpha\n"
                             "-----\nTotal (2 days)  2h 30min\n")  # 10-04 and 10-12: other weeks

        def test_view_file(self):
            # space , L: the same text in a read-only file, its path printed for :open.
            self.put("A.md", "2026-10-09 09:00 - 10:00\n")
            view = self.home / ".cache" / "tl" / "summary.txt"
            for _ in range(2):  # the second run replaces the read-only file
                self.assertEqual(self.tl("summary", "--week", "--view"), str(view))
            self.assertEqual(view.read_text(), self.tl("summary", "--week"))
            self.assertEqual(view.stat().st_mode & 0o777, 0o444)

        def test_missing_task_folder(self):
            missing = self.home / "nope"
            self.assertEqual(self.tl("summary", TL_DIR=str(missing)),
                             f"Task folder not found: {missing}\n(create it or set TL_DIR)\n")

    loader = unittest.defaultTestLoader
    suite = unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in (Parse, Commands, Out, OutEdit, Switch, Summary))
    return 0 if unittest.TextTestRunner(verbosity=2 if verbose else 1).run(suite).wasSuccessful() else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

