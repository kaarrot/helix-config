#!/usr/bin/env python3
"""Todo scheduler + agenda for Helix.

Two tiers of tasks:

  Inbox bullets in $TD_FILE (default $TL_DIR/todo.md). Lightweight, fire-and-forget.
      - [ ] call jon                            # [ ] todo
      - [Y] pay rent                            # [Y] today
      - [A] refactor td parser                  # [A] active
      - [W] reply from bank                     # [W] waiting
      - [x] took bins out                       # [x] done
      - [!] call mom                            # [!] ignore

  Dedicated files in $TL_DIR/*.md, one per follow-up task, named by the
  bullet's slug. Any `YYYY-MM-DD HH:MM` timestamp fires a termux
  notification at that time (TD_LEAD_MIN earlier), except the leading time
  of a tl log entry line (`YYYY-MM-DD HH:MM - …`, the pattern tl uses).
  Inbox bullets fire while they are open: [ ]/[Y]/[A]/[W]. A dedicated
  file fires while its bullet is open; a file with no bullet, unless its
  first H1 is `# [x]`/`# [X]`/`# [!]`. A done or ignored subtask bullet in
  a file doesn't fire. The agenda marks a bullet with
  " (*)" when a dedicated file with the same slug exists.

      # refactor td parser
      2026-11-01 10:00

      notes/subtasks...

Commands:
  td install           build the alarm helper (bin/TdAlarm.java, needs
                       `pkg install ecj dx`), write the `td-tick` shim, drop
                       the old 15-min job, and arm the first reminder
  td uninstall         cancel the alarm (and any old job), remove the shim
  td tick              scan files, record future timestamps, fire due ones
                       (also ones added since the previous tick, unless
                       `td stamp` wrote them as "now"), then arm one exact
                       Android alarm for the next one. `td list` and the
                       commands that change tasks on disk (toggle, set,
                       rename, file, promote) start a tick in the
                       background when they finish, so the alarm follows.
                       Not stamp, shift and new: their keys don't save,
                       so the next tick sees their change.
  td list [--state todo|today|active|waiting|done|all] [--sort added|modified]
                       build the agenda from $TD_FILE bullets; write to
                       ~/.cache/td/agenda.md (read-only: it is a view) and
                       stdout. Appends " (*)" to
                       bullets whose slug has a dedicated file. Files with
                       no matching bullet are listed under their status if
                       their first line is `# [S] title` (done/ignored ones
                       hidden), else in # ORPHANS. The options are kept
                       in ~/.cache/td/agenda-args, so a rebuild after a
                       change keeps the order.
                       added: newest first-seen first. modified: most
                       recently changed first (its line, or its dedicated
                       file; hand edits count from the next td run).
                       all shows the open states; done lists the [x]/[X]
                       bullets and file tasks (space , D, with modified).
  td promote [--from PATH:LINE]
                       stdin: a line, at PATH:LINE. A bullet gets its file
                       ~/tasks/<slug>.md: created with a `# [S] title`
                       heading, or reused with the heading retagged (nothing
                       is written from the agenda). Prints where `space , P`
                       goes, and writes it to ~/.cache/td/open: that file
                       (from an agenda row, the row's file, if any), else
                       PATH:LINE.
  td jump [--from PATH:LINE]
                       stdin: a line, at PATH:LINE. Prints where `space , p`
                       goes, and writes it to ~/.cache/td/open: a bullet's
                       ~/tasks/<slug>.md if it exists; from an agenda row,
                       its todo.md line (INBOX:N); a file-task or orphan row,
                       its file; else PATH:LINE (stay).
  td set PATH LINE S   rewrite checkbox char at PATH:LINE to S (" "/Y/A/x/!)
  td toggle S          stdin: a line. Toggle the checkbox between " " and S
                       in place. With --from the agenda, the row stays as
                       it is (it is a view): the task it shows changes
                       where it lives (its todo.md bullet, or a file
                       task's heading) and the agenda is rebuilt. With
                       --from any other
                       file, the inbox bullet with the same slug gets the
                       same state (an open one first, if there are several);
                       in a dedicated file the `# [S] title` heading toggles
                       too and sets the file's bullet. If S is "x"
                       and the line carries an org-style ++Nu/.+Nu repeater
                       as its own token (u = d|w|m|y, N ≥ 1; `C++1d` does not
                       count), the date is bumped instead and state
                       stays [ ]: ++ advances the stamped date by N units
                       until it is in the future (anchored, e.g. rent on the
                       1st); .+ sets it to today + N units (floating).
  td new [--state todo|today|active|waiting] [- [--above]]
                       print "- [S] " for pipe/insert. With -, for space , q:
                       read the buffer's last line on stdin and print it
                       back with "- [S] " on a line under it, or just
                       "- [S] " when that line already is that empty bullet.
                       --above, for space , Q: the first line, and the
                       bullet goes on a line above it
  td file NAME...      a file task with no todo.md bullet: create
                       ~/tasks/<slug of NAME>.md with `# [ ] NAME` on its
                       first line (an existing file is left as it is) and
                       print the path to open (PATH:2, the blank line
                       under the heading, when it is new). For space , n, NAME may follow
                       `"$BASH_EXECUTION_STRING" # name:` (see NAME_MARK).
  td rename --from AGENDA:LINE NAME...
                       space , N: give the task on an agenda row a new
                       name, checked as td file checks it: a file task's
                       (or orphan's) file and first-line heading, or a
                       bullet's todo.md text and its own file, if any.
  td stamp [--restamp] [--col N]
                       stdin: a line. If it contains a date (the one at
                       column N with --col N, else the first), replace (default)
                       with today's date (preserving the time) or recompute
                       the weekday only (--restamp, or --col N with column N,
                       1-based, on the stamp). If no date, append a
                       fresh "YYYY-MM-DD Xxx HH:MM" to the end of the line.
                       The weekday is always kept in sync with the date.
  td shift +N|-N [--col COL]
                       stdin: a line. Move its stamp (the one at COL when it
                       has two, else the first) by N of the part under
                       column COL (1-based): year, month, day (or weekday),
                       hour, or 5 minutes; the day when COL is off the stamp
                       or not given. The weekday follows the date; month ends
                       clamp (01-31 +1 month → 02-28). With --col, the
                       part's new column goes to ~/.cache/td/stamp-col.
                       On a tl entry line, its head moves instead: the
                       date, or the start or end time under COL (the date
                       when COL is elsewhere, unless the line also has a
                       stamp), in tl's format, with its duration redone.
                       On tl's week summary view (~/.cache/tl/summary.txt),
                       the view moves N weeks instead and the line comes
                       back unchanged. No stamp or entry: the line comes
                       back unchanged.
  td fire PATH         fire a dedicated file's timestamp now (testing)
  td test [-v]         run tests

Env: $TL_DIR (default ~/tasks), $TD_FILE (default $TL_DIR/todo.md),
     $TL_NOW="YYYY-MM-DD HH:MM" fakes the clock,
     $TD_LEAD_MIN (default 0) fires that many minutes early,
     $TD_DRY_RUN=1 skips notifications and alarms and prints "would fire: ..."
     and "would arm: ..." instead,
     $TD_TERMUX=1/0 says whether this is Termux (default: detected).
     Reminders (tick, install, fire) need Termux; elsewhere they refuse.
"""
import atexit
import calendar
import fcntl
import hashlib
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from collections import namedtuple
from datetime import datetime, timedelta
from pathlib import Path

TASK = re.compile(r"^(?P<indent>\s*)- \[(?P<state>[ xXyYaAwW!])\]\s+(?P<text>.*?)\s*$")
# A scheduled timestamp is any YYYY-MM-DD [Xxx ]HH:MM. The optional
# 3-letter weekday between date and time is purely decorative and ignored
# by parsing — `td stamp` keeps it in sync with the date. Use find_stamp(),
# which skips the leading time of a tl log entry (see TL_ENTRY).
SCHEDULE_TS = re.compile(
    r"(\d{4}-\d{2}-\d{2})(?: [A-Z][a-z]{2})? (\d{1,2}:\d{2})")
# A tl log entry: the line *starts* (after an optional "- " / "* " /
# "- [S] ", any state) with date, time, then "-" or "–". That leading time
# is a log, never a schedule, whatever the checkbox says. The same pattern
# as tl's ATTEMPT (a test checks), so a line is either a log entry to tl or
# a reminder to td, never both or neither. A " - " after a time elsewhere is
# just text: `call bank 2026-10-12 10:00 - bring docs` is a reminder.
TL_ENTRY = re.compile(
    r"^\s*(?:[-*]\s+(?:\[[ xXyYaAwW!]\]\s+)?)?(\d{4}-\d{2}-\d{2})\s+\d{1,2}:\d{2}\s*[-–]")
# org-mode-style repeater, as its own token: ++2w bumps the old date by
# N units until >today; .+2w bumps to today + N units. Units: d/w/m/y.
# Whitespace (or start) before the sigil, and a non-word after the unit,
# so `C++1d` and `++1days` are not repeaters. See _bump_recurring.
# N must be at least 1: `++0d` would never move the date, so it is plain text.
REPEATER = re.compile(r"(?<!\S)(\+\+|\.\+)(0*[1-9]\d*)([dwmy])(?!\w)")
LINK = re.compile(r"\s*→\s*\S+\s*$")
MARKER = re.compile(r"\s*\(\*\)\s*$")
AGENDA_ROW = re.compile(
    r"^(?P<rest>- \[[ xXyYaAwW!]\].*?)\s{2,}(?P<path>\S+?):(?P<line>\d+):\d+\s*$")
H1 = re.compile(r"^#\s+(?:\[[ xXyYaAwW!]\]\s+)?(.+?)\s*$")
H1_STATE = re.compile(r"^#\s+\[([ xXyYaAwW!])\]")
SLUG_SPLIT = re.compile(r"[^a-z0-9]+")
CHECKBOX = re.compile(r"- \[[ xXyYaAwW!]\]")

STATE_NAMES = {" ": "todo", "Y": "today", "A": "active", "W": "waiting",
               "x": "done", "X": "done", "!": "ignore"}
STATE_FROM_NAME = {"todo": " ", "today": "Y", "active": "A", "waiting": "W",
                   "done": "x", "ignore": "!"}
VISIBLE = {" ", "Y", "A", "W"}
GROUPS = ("today", "active", "todo", "waiting")


def canon(state):
    """Today, active and waiting are written [Y]/[A]/[W]; lowercase reads
    the same."""
    return {"y": "Y", "a": "A", "w": "W"}.get(state, state)

JOB_ID = 7421
CACHE = Path("~/.cache/td").expanduser()
FIRED_PATH = CACHE / "fired"
ADDED_PATH = CACHE / "added"
SCHEDULED_PATH = CACHE / "scheduled"
CHANGED_PATH = CACHE / "changed"
LAST_TICK_PATH = CACHE / "last-tick"
STAMPED_NOW_PATH = CACHE / "stamped-now"
LIST_PATH = CACHE / "agenda.md"
# The `td list` options the agenda was last built with, so a rebuild after a
# change keeps the view's order (space , A) instead of falling back to added.
LIST_ARGS_PATH = CACHE / "agenda-args"
# Cursor column `space , s` and `+`/`-` hand from Helix to td (and back).
COL_PATH = CACHE / "stamp-col"
# Where `space , p` / `P` go: td jump/promote write it, the key :opens it.
OPEN_PATH = CACHE / "open"
TICK_SHIM = Path("~/.config/helix/bin/td-tick").expanduser()
TICK_LOCK = CACHE / "tick.lock"
# The reminder alarm (see bin/TdAlarm.java): built by `td install`, run
# under app_process. Arming failures go to the log, since they stop the
# chain of alarms until the next tick.
ALARM_SRC = Path(__file__).resolve().parent / "TdAlarm.java"
ALARM_JAR = CACHE / "td-alarm.jar"
ALARM_LOG = CACHE / "alarm.log"
# Reminders use Termux:API notifications and Android alarms, so they only
# run on Termux (Termux's Python lives under com.termux). TD_TERMUX
# overrides the check.
TERMUX = os.environ.get(
    "TD_TERMUX", "1" if "com.termux" in sys.prefix else "0") == "1"

LEGEND = ("# td VIEW ONLY (status keys change the task itself; space , p "
          "goes there): [ ] todo  [Y] today  [A] active  [W] waiting")

Bullet = namedtuple("Bullet", "path line raw indent state text hash")
Scheduled = namedtuple("Scheduled", "path line due title hash")


def now():
    fake = os.environ.get("TL_NOW")
    return datetime.strptime(fake, "%Y-%m-%d %H:%M") if fake else datetime.now()


def tilde(path):
    home = str(Path.home())
    s = str(path)
    return "~" + s[len(home):] if s.startswith(home + os.sep) else s


def task_folder():
    return Path(os.environ.get("TL_DIR", "~/tasks")).expanduser()


def td_file():
    env = os.environ.get("TD_FILE")
    if env:
        return Path(env).expanduser()
    return task_folder() / "todo.md"


def _same_file(a, b):
    """True when paths a and b name the same file. False if either is None."""
    if a is None or b is None:
        return False
    try:
        return a.resolve() == b.resolve()
    except OSError:
        return False


def find_stamps(line):
    """Every SCHEDULE_TS match in line, but a tl log entry's leading time."""
    entry = TL_ENTRY.match(line)
    return [m for m in SCHEDULE_TS.finditer(line)
            if not (entry and m.start() < entry.end())]


def find_stamp(line):
    """The first of find_stamps(line), or None."""
    stamps = find_stamps(line)
    return stamps[0] if stamps else None


def _stamp_at(line, i):
    """The stamp in line holding 0-based index i (or just past its end),
    else the first one; None when line has none. Which stamp `space , s`
    and `+`/`-` work on when a line has two."""
    stamps = find_stamps(line)
    if i is not None:
        for m in stamps:
            if m.start() <= i <= m.end():
                return m
    return stamps[0] if stamps else None


def _split_eol(s):
    """(s without its line ending, the line ending: "\\n", "\\r\\n" or "")."""
    body = s.rstrip("\r\n")
    return body, s[len(body):]


def _identity_text(text):
    """Task text with link, (*), and its stamps and repeaters removed.

    A stamp is an annotation, wherever it is in the line (`call bank
    2026-10-12 10:00 - bring docs`, `rent 2026-11-01 09:00 ++1m #home`).
    Leaving it in the slug or the added-hash orphans the dedicated file and
    jumps the row to the top of the agenda every time `td stamp`, `+`/`-` or
    a repeater bump moves the date. A repeater goes with the stamps: on a
    line with none, `++1d` is text.
    """
    s = MARKER.sub("", text).strip()
    s = LINK.sub("", s).strip()
    stamps = find_stamps(s)
    if stamps:
        for m in reversed(stamps):
            s = s[:m.start()] + " " + s[m.end():]
        s = REPEATER.sub(" ", s)
    return re.sub(r"\s+", " ", s).strip()


def bullet_hash(path, text):
    """Stable hash: ignores checkbox, link, marker, and a trailing stamp."""
    core = _identity_text(text)
    h = hashlib.sha1(f"{path}\t{core}".encode("utf-8", "surrogateescape"))
    return h.hexdigest()[:16]


def schedule_hash(path, due_iso, text):
    """A reminder's key: its file, due time, and line (see stamp_text), so
    two reminders at the same minute in one file are two reminders."""
    h = hashlib.sha1(f"{path}\t{due_iso}\t{text}".encode(
        "utf-8", "surrogateescape"))
    return h.hexdigest()[:16]


def stamp_text(path, lineno, raw):
    """The line a reminder's key holds: a bullet's text without its
    checkbox, link, marker, stamps or repeater (as bullet_hash), else the line
    itself. So toggling a state or a repeater bump keeps the text."""
    b = parse_bullet(path, lineno, raw)
    return _identity_text(b.text if b else raw)


def _add_period(d, n, unit):
    if unit == "h":
        return d + timedelta(hours=n)
    if unit == "d":
        return d + timedelta(days=n)
    if unit == "w":
        return d + timedelta(weeks=n)
    if unit == "m":
        m = d.month - 1 + n
        y = d.year + m // 12
        m = m % 12 + 1
        last = calendar.monthrange(y, m)[1]
        return d.replace(year=y, month=m, day=min(d.day, last))
    if unit == "y":
        last = calendar.monthrange(d.year + n, d.month)[1]
        return d.replace(year=d.year + n, day=min(d.day, last))
    raise ValueError(f"bad unit: {unit}")


def _bump_recurring(raw, today):
    """If raw has both a SCHEDULE_TS and a ++/.+ repeater token, return
    raw with the date advanced. Otherwise return None.

    ++Nu: new = old + N*unit, repeated until >today (anchored).
    .+Nu: new = today + N*unit (floating).
    The stamp is the one the repeater follows (the nearest before it), else
    the first, so a second date on the line stays put.
    """
    m_rep = REPEATER.search(raw)
    if not m_rep:
        return None
    stamps = find_stamps(raw)
    if not stamps:
        return None
    before = [m for m in stamps if m.start() < m_rep.start()]
    m_ts = before[-1] if before else stamps[0]
    try:
        old = datetime.strptime(f"{m_ts.group(1)} {m_ts.group(2)}",
                                "%Y-%m-%d %H:%M")
    except ValueError:
        return None
    prefix, n_s, unit = m_rep.group(1), m_rep.group(2), m_rep.group(3)
    n = int(n_s)
    if prefix == ".+":
        # Floating: new = today + N units, time-of-day preserved from stamp.
        base = today.replace(hour=old.hour, minute=old.minute,
                             second=0, microsecond=0)
        new = _add_period(base, n, unit)
    else:
        new = _add_period(old, n, unit)
        while new <= today:
            new = _add_period(new, n, unit)
    new_ts = f"{new.strftime('%Y-%m-%d %a %H:%M')}"
    return raw[:m_ts.start()] + new_ts + raw[m_ts.end():]


def slugify(text):
    s = _identity_text(text).lower()
    s = SLUG_SPLIT.sub("-", s).strip("-")
    return s or "untitled"


def parse_bullet(path, lineno, raw):
    m = TASK.match(raw)
    if not m:
        return None
    text = m["text"]
    return Bullet(path, lineno, raw, m["indent"], canon(m["state"]), text,
                  bullet_hash(str(path), text))


def scan_inbox():
    """-> (path, [Bullet]). (path, []) if missing."""
    p = td_file()
    if not p.is_file():
        return p, []
    try:
        lines = p.read_bytes().decode("utf-8", "surrogateescape").splitlines()
    except OSError:
        return p, []
    out = []
    for i, raw in enumerate(lines, 1):
        b = parse_bullet(p, i, raw)
        if b:
            out.append(b)
    return p, out


def scan_schedules():
    """All schedule candidates across $TL_DIR files + inbox bullets.

    Any `YYYY-MM-DD HH:MM` timestamp counts — no `SCHEDULE:` marker needed —
    except the leading time of a tl log entry (see TL_ENTRY); a line with
    two has two reminders. On inbox bullets, only open states ([ ], [Y],
    [A], [W]) are eligible — [x]/[!] skip. A dedicated file follows its
    inbox bullet (the one whose slug is the file name), as the agenda does:
    it is skipped unless that bullet is open, whatever its heading says, so
    a bullet marked done by hand stops its file too. A file with no bullet
    is skipped when its first H1 is `# [x]`/`# [X]`/`# [!]`. Otherwise every
    timestamp in the file is a candidate, but on a subtask bullet that is
    done or ignored. The inbox is scanned even when $TD_FILE lives outside
    $TL_DIR.
    """
    folder = task_folder()
    files = sorted(folder.glob("*.md")) if folder.is_dir() else []
    inbox, bullets = scan_inbox()
    if inbox.is_file() and not any(_same_file(f, inbox) for f in files):
        files.append(inbox)
    has_bullet = {slugify(b.text) for b in bullets}
    open_bullet = {slugify(b.text) for b in bullets if b.state in VISIBLE}
    out = []
    for f in files:
        is_inbox = _same_file(f, inbox)
        try:
            lines = f.read_bytes().decode("utf-8", "surrogateescape").splitlines()
        except OSError:
            continue
        file_title, file_state = f.stem, None
        for raw in lines:
            hm = H1.match(raw)
            if hm:
                file_title = hm[1]
                sm = H1_STATE.match(raw)
                file_state = sm[1] if sm else None
                break
        if not is_inbox:
            if f.stem in has_bullet:
                if f.stem not in open_bullet:
                    continue
            elif file_state in ("x", "X", "!"):
                continue
        for i, raw in enumerate(lines, 1):
            stamps = find_stamps(raw)
            if not stamps:
                continue
            b = parse_bullet(f, i, raw)
            if (b and b.state not in VISIBLE) or (is_inbox and not b):
                continue
            text = stamp_text(f, i, raw)
            if is_inbox:
                line_title = (LINK.sub("", MARKER.sub("", b.text)).strip()
                              or f.stem)
            else:
                line_title = file_title
            for ts in stamps:
                try:
                    due = datetime.strptime(f"{ts[1]} {ts[2]}", "%Y-%m-%d %H:%M")
                except ValueError:
                    continue
                iso = due.isoformat(timespec="minutes")
                out.append(Scheduled(f, i, due, line_title,
                                     schedule_hash(str(f), iso, text)))
    return out


# ---------------------------------------------------------------- sidecars

def _read_sidecar(path):
    if not path.exists():
        return []
    return path.read_text(encoding="utf-8", errors="surrogateescape").splitlines()


def _append_sidecar(path, rows):
    CACHE.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8", errors="surrogateescape") as f:
        for row in rows:
            f.write("\t".join(str(x) for x in row) + "\n")


def _rewrite_sidecar(path, lines):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text("".join(line + "\n" for line in lines),
                   encoding="utf-8", errors="surrogateescape")
    os.replace(tmp, path)


def _drop_lines(path, old):
    """Rewrite sidecar `path` without the lines old(line) is true for."""
    lines = _read_sidecar(path)
    keep = [line for line in lines if not old(line)]
    if len(keep) != len(lines):
        _rewrite_sidecar(path, keep)


# Reminder rows are kept this long after they were due. By then a tick has
# run after their time, so they can't fire again (see _tick), and dropping
# them keeps the sidecars from growing forever.
KEEP_DAYS = 7


def prune_reminders(t):
    """Drop `fired`, `scheduled` and `stamped-now` rows due over KEEP_DAYS
    before t, and alarm.log lines older than that. Run by the first tick
    of a day, after it has fired what is due."""
    cutoff = (t - timedelta(days=KEEP_DAYS)).isoformat(timespec="minutes")
    for path, col in ((FIRED_PATH, 0), (SCHEDULED_PATH, 2),
                      (STAMPED_NOW_PATH, 1)):
        _drop_lines(path, lambda line, col=col: (
            len(line.split("\t")) > col and line.split("\t")[col] < cutoff))
    _drop_lines(ALARM_LOG, lambda line: line[:16] < cutoff)


def compact_task_rows(live):
    """Keep one row per task hash in `added` and `changed`: the last, which
    the loaders read, and only for the hashes in `live` (the tasks the
    agenda found). Deleted tasks and old edits drop out."""
    for path in (ADDED_PATH, CHANGED_PATH):
        lines = _read_sidecar(path)
        last = {}
        for line in lines:
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] in live:
                last[parts[1]] = line
        if len(last) != len(lines):
            _rewrite_sidecar(path, list(last.values()))


def load_fired():
    """-> set of (hash, due_iso)."""
    out = set()
    for line in _read_sidecar(FIRED_PATH):
        parts = line.split("\t")
        if len(parts) >= 2:
            out.add((parts[1], parts[0]))
    return out


def load_scheduled():
    """-> set of (hash, due_iso). Items we've seen as future on some tick."""
    out = set()
    for line in _read_sidecar(SCHEDULED_PATH):
        parts = line.split("\t")
        if len(parts) >= 3:
            out.add((parts[1], parts[2]))
    return out


def load_added():
    """-> {hash: first_seen_iso}."""
    out = {}
    for line in _read_sidecar(ADDED_PATH):
        parts = line.split("\t")
        if len(parts) >= 2:
            out[parts[1]] = parts[0]
    return out


def update_added(pairs, when_iso):
    """pairs: list of (hash, label). Appends unseen hashes to the added sidecar."""
    seen = load_added()
    new = []
    for h, label in pairs:
        if h not in seen:
            new.append((when_iso, h, label[:80]))
            seen[h] = when_iso
    if new:
        _append_sidecar(ADDED_PATH, new)
    return seen


def update_changed(bullets, when_iso, added):
    """Record when each bullet last changed -> {hash: changed_iso}.

    A bullet first seen here starts at its added time. Later, whenever its
    line (state or text, stamp included) differs from the recorded one, its
    time moves to when_iso. Bullets sharing a hash are fingerprinted together
    so two copies with different states don't flip it on every run. Hand
    edits count from the next time td builds the agenda.
    """
    last = {}  # hash -> (iso, fingerprint)
    for line in _read_sidecar(CHANGED_PATH):
        parts = line.split("\t")
        if len(parts) >= 3:
            last[parts[1]] = (parts[0], parts[2])
    lines_by_hash = {}
    for b in bullets:
        lines_by_hash.setdefault(b.hash, []).append(f"{b.state}\t{b.text}")
    new = []
    for h, lines in lines_by_hash.items():
        fp = hashlib.sha1("\n".join(sorted(lines)).encode(
            "utf-8", "surrogateescape")).hexdigest()[:16]
        prev = last.get(h)
        if prev is None:
            row = (added.get(h, when_iso), h, fp)
        elif prev[1] != fp:
            row = (when_iso, h, fp)
        else:
            continue
        new.append(row)
        last[h] = (row[0], fp)
    if new:
        _append_sidecar(CHANGED_PATH, new)
    return {h: iso for h, (iso, _) in last.items()}


def load_last_tick():
    """-> datetime of the previous `td tick`, or None."""
    lines = _read_sidecar(LAST_TICK_PATH)
    try:
        return datetime.fromisoformat(lines[0]) if lines else None
    except ValueError:
        return None


def save_last_tick(t):
    CACHE.mkdir(parents=True, exist_ok=True)
    LAST_TICK_PATH.write_text(t.isoformat(timespec="minutes") + "\n",
                              encoding="utf-8")


def load_stamped_now():
    """-> set of due_iso that `td stamp` wrote when they were already now/past."""
    out = set()
    for line in _read_sidecar(STAMPED_NOW_PATH):
        parts = line.split("\t")
        if len(parts) >= 2:
            out.add(parts[1])
    return out


# ---------------------------------------------------------------- fire

def fire_notification(title, body, open_path):
    """-> True when the notification was posted."""
    if os.environ.get("TD_DRY_RUN") == "1":
        print(f"would fire: {tilde(open_path)}  {title}: {body}")
        return True
    try:
        # The action is a shell command line (termux-notification runs it
        # with sh -c), so the path is quoted.
        r = subprocess.run(["termux-notification",
                            "--title", title,
                            "--content", body,
                            "--sound",
                            "--action",
                            f"termux-open {shlex.quote(str(open_path))}"],
                           check=False)
    except OSError:
        return False
    return r.returncode == 0


def _need_termux(cmd):
    if not TERMUX:
        sys.exit(f"td {cmd}: reminders need Termux (Termux:API notifications"
                 " and Android alarms); TD_TERMUX=1 forces it")


def _log_alarm(msg):
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        with ALARM_LOG.open("a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat(timespec='seconds')}  {msg}\n")
    except OSError:
        pass


def _run_alarm(*args):
    """Run TdAlarm under app_process (as $PREFIX/bin/am does). -> error
    text, or None when it worked."""
    if not ALARM_JAR.is_file():
        return f"{tilde(ALARM_JAR)} missing: run td install"
    env = {k: v for k, v in os.environ.items()
           if k not in ("LD_PRELOAD", "LD_LIBRARY_PATH")}
    env["CLASSPATH"] = str(ALARM_JAR)
    try:
        r = subprocess.run(["/system/bin/app_process", "-Xnoimage-dex2oat",
                            "/", "TdAlarm", *args],
                           env=env, capture_output=True, text=True)
    except OSError as e:
        return str(e)
    if r.returncode != 0:
        return (r.stderr.strip() or f"exit {r.returncode}").splitlines()[-1]
    return None


def arm(at):
    """Point the one reminder alarm at datetime `at`, or cancel it (None).
    -> error text, or None."""
    when = at.strftime("%Y-%m-%d %H:%M:%S") if at else None
    if os.environ.get("TD_DRY_RUN") == "1":
        print(f"would arm: {when}" if at else "would arm: nothing")
        return None
    if at:
        err = _run_alarm("set", str(TICK_SHIM), str(int(at.timestamp() * 1000)))
    else:
        err = _run_alarm("cancel", str(TICK_SHIM))
    if err:
        _log_alarm(f"could not arm {when or 'nothing'}: {err}")
    return err


def _tick_later():
    """Start a detached `td tick --later` (see main): stdio to /dev/null
    and a new session, so a :pipe key doesn't wait for it."""
    if not TERMUX or os.environ.get("TD_DRY_RUN") == "1":
        return
    try:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                          "tick", "--later"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


# ---------------------------------------------------------------- commands

def cmd_tick(args=()):
    """Fire scheduled items (see _tick), then arm the alarm for the next.

    A tick runs from that alarm (`--alarm`: then it releases the wake lock
    the alarm took), and in the background after `td list` and the
    commands that change tasks (`--later`: it waits 2 s, so
    a key's trailing :update has saved the buffer). Ticks take a lock, so
    two at once never fire a reminder twice."""
    _need_termux("tick")
    try:
        if "--later" in args:
            time.sleep(2)
        CACHE.mkdir(parents=True, exist_ok=True)
        with TICK_LOCK.open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            err = _tick()
    finally:
        if "--alarm" in args and os.environ.get("TD_DRY_RUN") != "1":
            subprocess.run(["termux-wake-unlock"], check=False,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    if err:
        print(f"td tick: could not arm the alarm: {err}", file=sys.stderr)
        return 1
    return 0


def _tick():
    """Fire scheduled items, and arm the alarm for the next one.

    An item fires once it is due or past-due, if either:
      • it was observed as future on a prior tick (recorded in the
        `scheduled` sidecar), or
      • it was still to come at the previous tick — a reminder added
        between two ticks (or inside the TD_LEAD_MIN window) — and is not
        a stamp `td stamp` wrote as "now" (the `stamped-now` sidecar).
    Rule:
      • new timestamp with due − lead > now  →  add (hash, iso) to `scheduled`
      • timestamp with due − lead ≤ now, ∉ fired, AND (∈ scheduled OR
        (previous tick < due AND due ∉ stamped-now))  →  fire

    `tl` log entries are excluded by find_stamp(). Old past-date mentions
    never fire: they were already past at the previous tick. The cost of
    catching late additions: a time typed by hand after it passed, within
    one tick interval, fires once. Missed fires across reboots still fire
    on the next tick, however late. A notification that fails is not
    recorded as fired: it is kept in `scheduled` and retried a minute later.

    Then the one exact alarm (see arm) is pointed at the earliest future
    `due − lead` not yet fired, or cancelled when nothing is left."""
    t = now()
    lead = timedelta(minutes=int(os.environ.get("TD_LEAD_MIN", "0")))
    items = scan_schedules()
    scheduled = load_scheduled()
    fired = load_fired()
    last_tick = load_last_tick()
    stamped_now = load_stamped_now()
    new_scheduled = []
    failed = False
    for s in items:
        due_iso = s.due.isoformat(timespec="minutes")
        fire_at = s.due - lead
        key = (s.hash, due_iso)
        if fire_at > t:
            if key not in scheduled:
                new_scheduled.append((t.isoformat(timespec="minutes"),
                                      s.hash, due_iso, s.title[:80]))
                scheduled.add(key)
            continue
        if key not in scheduled:
            # Not seen as future: fire only if it was still to come at the
            # previous tick (an old date was already past then) and is not
            # a stamp of "now" from `td stamp`.
            if (last_tick is None or s.due <= last_tick
                    or due_iso in stamped_now):
                continue
        if key in fired:
            continue
        if fire_notification("TODO", s.title, s.path):
            _append_sidecar(FIRED_PATH, [(due_iso, s.hash, s.title[:80])])
            fired.add(key)
        else:
            failed = True
            if key not in scheduled:
                # Past due by the next tick: only `scheduled` lets it retry.
                new_scheduled.append((t.isoformat(timespec="minutes"),
                                      s.hash, due_iso, s.title[:80]))
                scheduled.add(key)
    if new_scheduled:
        _append_sidecar(SCHEDULED_PATH, new_scheduled)
    if last_tick is None or last_tick.date() != t.date():
        prune_reminders(t)
    save_last_tick(t)
    upcoming = [s.due - lead for s in items
                if s.due - lead > t
                and (s.hash, s.due.isoformat(timespec="minutes")) not in fired]
    if failed:
        upcoming.append(t + timedelta(minutes=1))
    return arm(min(upcoming) if upcoming else None)


def _parse_list_args(args):
    state = "all"
    sort = "added"
    i = 0
    while i < len(args):
        if args[i] == "--state" and i + 1 < len(args):
            state = args[i + 1]; i += 2
        elif args[i] == "--sort" and i + 1 < len(args):
            sort = args[i + 1]; i += 2
        else:
            i += 1
    if state not in ("todo", "today", "active", "waiting", "done", "all"):
        sys.exit(f"bad --state: {state}")
    if sort not in ("added", "modified"):
        sys.exit(f"bad --sort: {sort}")
    return state, sort


def _row(b, has_file):
    marker = " (*)" if has_file else ""
    return f"- [{b.state}] {b.text}{marker}"


def _file_tasks(skip_slugs):
    """Dedicated files that are tasks of their own: no inbox bullet (slug not
    in skip_slugs) and a first line `# [S] title`. -> [Bullet] with path =
    the file, line 1, text = the title."""
    folder = task_folder()
    if not folder.is_dir():
        return []
    out = []
    for f in sorted(folder.glob("*.md")):
        if f.stem in skip_slugs or _same_file(f, td_file()):
            continue
        try:
            with open(f, "rb") as fh:
                first = fh.readline().decode("utf-8", "surrogateescape").rstrip("\r\n")
        except OSError:
            continue
        m = H1_PARTS.match(first)
        if not m or m["state"] is None:
            continue
        title = m["title"]
        out.append(Bullet(f, 1, first, "", canon(m["state"]), title,
                          bullet_hash(str(f), title)))
    return out


def _existing_slugs():
    """-> set of file-stem slugs under $TL_DIR (dedicated files, inbox excluded)."""
    folder = task_folder()
    if not folder.is_dir():
        return set()
    try:
        inbox = td_file().resolve()
    except OSError:
        inbox = None
    out = set()
    for f in folder.glob("*.md"):
        try:
            if inbox and f.resolve() == inbox:
                continue
        except OSError:
            continue
        out.add(f.stem.lower())
    return out


def _modified_iso(b, changed):
    """When bullet b was last touched: its line changed, or its dedicated
    file was written, whichever is later."""
    iso = changed.get(b.hash, "0")
    # A file task (see _file_tasks) is its own file.
    dedicated = (task_folder() / f"{slugify(b.text)}.md"
                 if _same_file(b.path, td_file()) else b.path)
    try:
        mtime = datetime.fromtimestamp(dedicated.stat().st_mtime)
    except OSError:
        return iso
    return max(iso, mtime.isoformat(timespec="seconds"))


def build_list(args):
    state, sort = _parse_list_args(args)
    inbox, bullets = scan_inbox()
    existing = _existing_slugs()
    bullet_slugs = {slugify(b.text) for b in bullets}
    # Files with a `# [S]` first line and no bullet are tasks of their own.
    file_tasks = _file_tasks(bullet_slugs)
    bullets = bullets + file_tasks
    # To the second, so tasks seen a few seconds apart don't tie.
    when = now().isoformat(timespec="seconds")
    update_added([(b.hash, b.text) for b in bullets], when)
    added = load_added()
    changed = update_changed(bullets, when, added)
    if inbox.is_file():
        # Not when the inbox is missing (mid-sync, say): every row would go.
        compact_task_rows({b.hash for b in bullets})
    kept = [b for b in bullets if (b.state in VISIBLE if state == "all"
                                   else STATE_NAMES[b.state] == state)]
    if sort == "modified":
        kept.sort(key=lambda b: _modified_iso(b, changed), reverse=True)
    else:
        kept.sort(key=lambda b: added.get(b.hash, "0"), reverse=True)

    def row(b):
        if not _same_file(b.path, inbox):
            return f"- [{b.state}] {b.text}  {tilde(b.path)}:1:1"
        return _row(b, slugify(b.text) in existing)

    out = [LEGEND, ""]
    if state == "all":
        groups = {name: [] for name in GROUPS}
        for b in kept:
            groups[STATE_NAMES[b.state]].append(b)
        for name in GROUPS:
            items = groups[name]
            if not items:
                continue
            out.append(f"# {name.upper()}")
            out.append("")
            for b in items:
                out.append(row(b))
            out.append("")
    else:
        out.append(f"# {state.upper()}")
        out.append("")
        for b in kept:
            out.append(row(b))
        out.append("")

    orphans = sorted(existing - bullet_slugs - {b.path.stem for b in file_tasks})
    if orphans and state == "all":
        out.append("# ORPHANS")
        out.append("")
        for slug in orphans:
            path = task_folder() / f"{slug}.md"
            out.append(f"- {slug}  {tilde(path)}:1:1")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def _write_agenda(text):
    """Write agenda.md read-only (0444): it is a view, and Helix refuses to
    save a read-only file. It is replaced by a rename, which needs no write
    permission on the file, and Helix's auto-reload still picks it up."""
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = LIST_PATH.with_name(LIST_PATH.name + ".tmp")
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
    tmp.write_text(text, encoding="utf-8", errors="surrogateescape")
    os.chmod(tmp, 0o444)
    os.replace(tmp, LIST_PATH)


def cmd_list(args):
    state, sort = _parse_list_args(args)
    text = build_list(args)
    _write_agenda(text)
    LIST_ARGS_PATH.write_text(f"--state {state} --sort {sort}\n", encoding="utf-8")
    sys.stdout.write(text)
    return 0


def refresh_list():
    """Rebuild agenda.md, with the options it was last listed with, without
    touching stdout (used after a state change)."""
    try:
        saved = _read_sidecar(LIST_ARGS_PATH)
        _write_agenda(build_list(saved[0].split() if saved else []))
    except Exception:
        pass


def _from_arg(args):
    """Path after --from, or None."""
    if "--from" not in args:
        return None
    i = args.index("--from")
    return Path(args[i + 1]).expanduser() if i + 1 < len(args) else None


def _changed(data):
    """data with a space before its newline, for the agenda and the week view: there the keys take
    back the pipe's edit with `:earlier 1`, so the pipe must make exactly one edit. A line given
    back as it was can make none (an empty one does), and the undo would take back the reload
    before it instead, leaving the buffer stale and modified."""
    body, eol = _split_eol(data)
    return body + " " + eol


def _echo_if_agenda(args, data):
    """The agenda is view only: when --from is the agenda, write data back
    unchanged and return True."""
    if not _same_file(_from_arg(args), LIST_PATH):
        return False
    sys.stdout.write(data)
    return True


def cmd_next():
    t = now()
    future = [s for s in scan_schedules() if s.due >= t]
    if not future:
        print("")
        return 0
    nxt = min(future, key=lambda s: s.due)
    print(f"{nxt.due.strftime('%Y-%m-%d %H:%M')}  {nxt.title}")
    return 0


# Ends the prompt `space , n` leaves open: what you type after it is a shell comment, which td
# reads back from $BASH_EXECUTION_STRING, so the name needs no quoting.
NAME_MARK = '"$BASH_EXECUTION_STRING" # name:'


def _task_name(text):
    """The check every task name goes through, whether it names a new file (space , n, P) or a
    new name for one (space , N): runs of whitespace become one space, and the name needs a
    letter or digit to make a file name from. -> (name, slug), or None."""
    name = re.sub(r"\s+", " ", text).strip()
    slug = SLUG_SPLIT.sub("-", _identity_text(name).lower()).strip("-")
    return (name, slug) if slug else None


def _name_arg(args):
    """NAME in `td file NAME...` / `td rename ... NAME...`: the text after NAME_MARK when a key
    passes "$BASH_EXECUTION_STRING", else the words that are not options."""
    joined = " ".join(args)
    if NAME_MARK in joined:
        return joined.split(NAME_MARK, 1)[1]
    words, skip = [], False
    for a in args:
        if skip or a.startswith("--"):
            skip = a == "--from"
            continue
        words.append(a)
    return " ".join(words)


def cmd_file(args):
    """td file NAME...: a file task, for a task clear enough to skip todo.md. Create
    ~/tasks/<slug>.md (the slug as for a bullet's own file) with `# [ ] NAME` on its first line,
    so the agenda lists it under TODO, and print where to open it: PATH:2, the blank line under
    the heading. An existing file is left alone and printed as PATH. No usable name: exit 1."""
    named = _task_name(_name_arg(args))
    if named is None:
        sys.exit("td: no task name (type it after # name:)")
    name, slug = named
    folder = task_folder()
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{slug}.md"
    if path.exists():
        print(path)
        return 0
    path.write_text(f"# [ ] {name}\n\n", encoding="utf-8", errors="surrogateescape")
    refresh_list()
    print(f"{path}:2")
    return 0


ORPHAN_ROW = re.compile(r"^- (?P<slug>\S+)\s{2,}(?P<path>\S+?):\d+:\d+\s*$")
RowTask = namedtuple("RowTask", "kind path name state")


def _agenda_task(raw):
    """The task an agenda row shows -> RowTask: kind "file" for a file-task or orphan row (path:
    its file; name: its first-line heading's title, else the file's name), kind "bullet" for a
    bullet row (name: its text without the ` (*)`; state, to find it in todo.md). Else None."""
    frow = AGENDA_ROW.match(raw) or ORPHAN_ROW.match(raw)
    if frow:
        path = Path(frow["path"]).expanduser()
        if not path.is_file():
            return None
        first = path.read_bytes().decode("utf-8", "surrogateescape").splitlines()[:1]
        hm = H1_PARTS.match(first[0]) if first else None
        return RowTask("file", task_folder() / path.name, hm["title"] if hm else path.stem, None)
    bm = TASK.match(raw)
    if bm:
        return RowTask("bullet", None, MARKER.sub("", bm["text"]).strip(), bm["state"])
    return None


def _carry_over(old_hash, new_hash, label):
    """A renamed task keeps its place in the newest-added order, and counts as just changed."""
    if old_hash == new_hash:
        return
    added = load_added()
    if old_hash in added:
        _append_sidecar(ADDED_PATH, [(added[old_hash], new_hash, label[:80])])
    _append_sidecar(CHANGED_PATH, [(now().isoformat(timespec="seconds"), new_hash, "")])


def _set_heading_title(path, title):
    """Give path's first-line heading a new title, keeping its `[S]`; no heading: add `# title`."""
    lines = path.read_bytes().decode("utf-8", "surrogateescape").splitlines(keepends=True)
    hm = H1_PARTS.match(_split_eol(lines[0])[0]) if lines else None
    if hm:
        state = f"[{hm['state']}] " if hm["state"] is not None else ""
        _write_line(path, lines, 0, f"{hm['hash']}{state}{title}{hm['trail']}")
    else:
        path.write_bytes(f"# {title}\n".encode("utf-8", "surrogateescape")
                         + "".join(lines).encode("utf-8", "surrogateescape"))


def cmd_rename(args):
    """td rename --from AGENDA:LINE NAME...: for space , N, on an agenda row (the key copies the
    row's name into the prompt itself, from the row's text).

    The task gets NAME (after NAME_MARK when the key passes it), checked as a new file task's
    name is (_task_name), and the agenda is rebuilt: a file-task or orphan row's file
    is renamed to the new slug and its first-line heading gets the name (keeping `[S]`; a file
    with no heading gets `# NAME`); a bullet row's todo.md bullet gets the name as its text, and
    its own file, if any, is renamed and retitled with it, so the two stay linked (the title
    without the bullet's stamps: they are the bullet's reminders, not the file's). Prints
    AGENDA:LINE for :open. A file already there under the new name, an unusable name, or a row
    with no task: exit 1, nothing changed."""
    source, lineno = _from_spec(args)
    raw = ""
    if source and lineno and source.is_file():
        lines = source.read_bytes().decode("utf-8", "surrogateescape").splitlines()
        raw = lines[lineno - 1] if 1 <= lineno <= len(lines) else ""
    task = _agenda_task(raw) if _same_file(source, LIST_PATH) else None
    if task is None:
        sys.exit("td: space , N renames the task on an agenda row")
    named = _task_name(_name_arg(args))
    if named is None:
        sys.exit("td: no task name (type it after # name:)")
    name, slug = named
    new_file = task_folder() / f"{slug}.md"
    if task.kind == "file":
        if new_file.exists() and not _same_file(task.path, new_file):
            sys.exit(f"td: {tilde(new_file)} already exists")
        _set_heading_title(task.path, name)
        if not _same_file(task.path, new_file):
            task.path.rename(new_file)
        _carry_over(bullet_hash(str(task.path), task.name), bullet_hash(str(new_file), name), name)
    else:
        inbox = td_file()
        lines, hits, _ = _find_bullet_lines(inbox, task.name, task.state) if inbox.is_file() else ([], [], "")
        if not hits:
            sys.exit("td: no such bullet in todo.md now (space , a rebuilds the agenda)")
        m = TASK.match(_split_eol(lines[hits[0]])[0])
        old_file = task_folder() / f"{slugify(m['text'])}.md"
        if new_file.exists() and not _same_file(old_file, new_file):
            sys.exit(f"td: {tilde(new_file)} already exists")
        _write_line(inbox, lines, hits[0], f"{m['indent']}- [{m['state']}] {name}")
        if old_file.is_file():
            _set_heading_title(old_file, _identity_text(name))
            if not _same_file(old_file, new_file):
                old_file.rename(new_file)
        _carry_over(bullet_hash(str(inbox), m["text"]), bullet_hash(str(inbox), name), name)
    refresh_list()
    print(f"{source}:{lineno}")
    return 0


def cmd_new(args):
    state_name = "todo"
    after_stdin = above = False
    i = 0
    while i < len(args):
        if args[i] == "--state" and i + 1 < len(args):
            state_name = args[i + 1]; i += 2
        elif args[i] == "-":
            after_stdin = True; i += 1
        elif args[i] == "--above":
            above = True; i += 1
        else:
            i += 1
    if state_name not in STATE_FROM_NAME:
        sys.exit(f"bad --state: {state_name}")
    bullet = f"- [{STATE_FROM_NAME[state_name]}] "
    if not after_stdin:
        sys.stdout.write(bullet)
        return 0
    # space , q pipes the last line through here (space , Q the first): an
    # empty bullet left by an earlier one is reused, not joined by a second.
    piped = sys.stdin.read()
    raw, eol = _split_eol(piped)
    if raw.rstrip() == bullet.rstrip():
        sys.stdout.write(bullet + eol)
    elif not piped:
        sys.stdout.write(bullet)
    elif above:
        sys.stdout.write(bullet + (eol or "\n") + raw + eol)
    else:
        sys.stdout.write(raw + (eol or "\n") + bullet + eol)
    return 0


SHIFT_ARG = re.compile(r"^[+-]\d+$")


def _shift_part(m, i):
    """Which part of stamp match m holds 0-based index i: "y" year, "m"
    month, "d" day (the weekday counts as the day), "h" hour, "M" minute.
    None when i is off the stamp."""
    if not m.start() <= i < m.end():
        return None
    date, time = m.start(1), m.start(2)
    if i < date + 5:
        return "y"
    if i < date + 8:
        return "m"
    if i < time:
        return "d"
    return "h" if i <= time + m.group(2).index(":") else "M"


def _shift(old, n, part):
    """old moved by n steps of part; minutes go in 5-minute steps, landing
    on a multiple of 5 (09:32 +1 → 09:35, -1 → 09:30)."""
    if part == "M":
        q = old.minute
        base = q - q % 5 if n > 0 else q + (-q) % 5
        return old + timedelta(minutes=base - q + 5 * n)
    return _add_period(old, n, {"M": "h"}.get(part, part))


def cmd_shift(args):
    """stdin: a line. Move its stamp by +N/-N of the part under column
    --col (1-based): year, month, day (or weekday), hour, or 5 minutes; the
    day when the column is off the stamp or not given. The weekday follows
    the date. With --col, the column of the same part afterwards goes to
    ~/.cache/td/stamp-col, so the key can put the cursor back. A line
    without a stamp (or with an impossible date) comes back unchanged."""
    if not args or not SHIFT_ARG.match(args[0]):
        sys.stderr.write("usage: td shift +N|-N [--col COL]  (e.g. +1)\n")
        return 2
    n = int(args[0])
    col = _col_arg(args)
    data = sys.stdin.read()
    from_path = _from_arg(args)
    if _same_file(from_path, LIST_PATH):
        sys.stdout.write(_changed(data))  # the agenda is view only; the keys undo this
        return 0
    if from_path and from_path.name == "summary.txt" and _same_file(from_path, _tl().VIEW_PATH):
        # tl's week summary view: step it n weeks. The keys undo the pipe's edit there, so
        # Helix reloads the rewritten view.
        _tl().view_step(n)
        sys.stdout.write(_changed(data))
        return 0
    body, eol = _split_eol(data)
    i = col - 1 if col is not None else None
    m = _stamp_at(body, i)
    # A tl entry line: its head (date, start, end) moves, in tl's format. Off the head, the
    # day moves: the entry's, unless the line also has a reminder stamp, whose day moves.
    head = _tl().entry_head(body) if TL_ENTRY.match(body) else None
    log_part = _log_part(head, i) if head else None
    if head and (log_part or not m):
        body, i = _shift_log(body, head, n, log_part or "d", i)
    elif m:
        try:
            old = datetime.strptime(f"{m.group(1)} {m.group(2)}", "%Y-%m-%d %H:%M")
        except ValueError:
            old = None
        if old is not None:
            part = _shift_part(m, i) if i is not None else None
            new = _shift(old, n, part or "d").strftime("%Y-%m-%d %a %H:%M")
            if i is None:
                pass
            elif part is None:
                if i >= m.end():
                    i += len(new) - (m.end() - m.start())
            elif part in ("h", "M"):
                # New time starts 15 chars into the stamp; a 1-digit hour
                # ("9:00") becomes 2 digits.
                old_hour = m.group(2).index(":")
                i = m.start() + 15 + (i - m.start(2)) + (2 - old_hour)
            body = body[:m.start()] + new + body[m.end():]
    sys.stdout.write(body + eol)
    if i is not None:
        try:
            CACHE.mkdir(parents=True, exist_ok=True)
            COL_PATH.write_text(f"{i + 1}\n")
        except OSError:
            pass
    return 0


_TL = []  # tl as a module, once loaded


def _tl():
    """tl, next to this file, as a module: td moves a time-log entry with tl's own parsing and
    formatting, so the two scripts can't disagree on its shape. Loaded only for such lines."""
    if _TL:
        return _TL[0]
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    loader = SourceFileLoader("tl", str(Path(__file__).resolve().with_name("tl")))
    module = module_from_spec(spec_from_loader("tl", loader))
    loader.exec_module(module)
    _TL.append(module)
    return module


def _log_part(head, i):
    """Which part of a tl entry's head (see tl's entry_head) holds 0-based index i: "y", "m",
    "d" of the date, "sh"/"sM" the start's hour or minutes, "eh"/"eM" the end's; "" elsewhere."""
    if i is None:
        return ""
    a, b = head.span("date")
    if a <= i < b:
        return "y" if i < a + 5 else "m" if i < a + 8 else "d"
    for name in ("start", "end"):
        if head[name] and head.start(name) <= i < head.end(name):
            return name[0] + ("h" if i <= head.start(name) + head[name].index(":") else "M")
    return ""


def _shift_log(body, head, n, part, i):
    """body, a tl entry line, moved n steps of part (see _log_part): the date (the times stay),
    or the start or end time; a start crossing midnight moves the date too. A duration
    ("= 1h 15min") is written again for the new times. -> (new body, i on the same part)."""
    tl = _tl()
    start = datetime.strptime(f"{head['date']} {head['start']}", "%Y-%m-%d %H:%M")
    date_s, start_s, end_s = head["date"], head["start"], head["end"]
    moved = None  # the group whose text changed width, and its new text
    if part in ("y", "m", "d"):
        date_s = _shift(start, n, part).strftime("%Y-%m-%d")
    elif part[0] == "s":
        new = _shift(start, n, part[1])
        date_s, start_s = new.strftime("%Y-%m-%d"), new.strftime("%H:%M")
        moved = "start"
    else:
        end = datetime.strptime(f"{head['date']} {end_s}", "%Y-%m-%d %H:%M")
        end_s = _shift(end, n, part[1]).strftime("%H:%M")
        moved = "end"
    dur = head["dur"] or ""
    if dur and end_s:
        dur = " = " + tl.dur_text(tl.duration(tl.to_min(start_s), tl.to_min(end_s)))
    new_body = (head["prefix"] + date_s + head["sp"] + start_s + head["dash"]
                + ((head["sp2"] or "") + end_s if end_s else "") + dur + body[head.end():])
    if i is not None and moved:
        # A 1-digit hour ("9:05") is written with 2: the cursor follows its part.
        i += 2 - head[moved].index(":")
    elif i is not None and i >= head.end():
        i += len(new_body) - len(body)
    return new_body, i


def _col_arg(args):
    """1-based column after --col, or None (missing or not a number)."""
    if "--col" not in args:
        return None
    i = args.index("--col")
    try:
        return int(args[i + 1])
    except (IndexError, ValueError):
        return None


def cmd_stamp(args):
    restamp = "--restamp" in args
    col = _col_arg(args)
    data = sys.stdin.read()
    if _echo_if_agenda(args, data):
        return 0
    body, eol = _split_eol(data)
    t = now()
    stamped = None  # "YYYY-MM-DD HH:MM" this run wrote (not for --restamp)

    m = _stamp_at(body, col - 1 if col is not None else None)
    # Cursor on the stamp (or just past it): the date was edited by hand,
    # so only fix the weekday instead of moving the date to today.
    if m and col is not None and m.start() <= col - 1 <= m.end():
        restamp = True
    if m:
        date_str = m.group(1)
        time_str = m.group(2)
        if restamp:
            try:
                wd = datetime.strptime(date_str, "%Y-%m-%d").strftime("%a")
                new = f"{date_str} {wd} {time_str}"
            except ValueError:
                new = body[m.start():m.end()]
        else:
            new = f"{t.strftime('%Y-%m-%d %a')} {time_str}"
            stamped = f"{t.strftime('%Y-%m-%d')} {time_str}"
        rewritten = body[:m.start()] + new + body[m.end():]
    else:
        if restamp:
            rewritten = body
        else:
            stamp = t.strftime("%Y-%m-%d %a %H:%M")
            rewritten = f"{body} {stamp}" if body else stamp
            stamped = t.strftime("%Y-%m-%d %H:%M")

    sys.stdout.write(rewritten + eol)
    _record_stamped_now(stamped, t)
    return 0


def _record_stamped_now(stamped, t):
    """Remember a stamp this run wrote that was already due (a stamp of
    "now", or today at a time already past), so `td tick` doesn't take it
    for a reminder added between ticks. A stamp later moved to another time
    no longer matches and fires as usual."""
    if stamped is None:
        return
    try:
        due = datetime.strptime(stamped, "%Y-%m-%d %H:%M")
    except ValueError:
        return
    if due > t:
        return
    try:
        _append_sidecar(STAMPED_NOW_PATH, [(t.isoformat(timespec="minutes"),
                                            due.isoformat(timespec="minutes"))])
    except OSError:
        pass


def _from_spec(args):
    """(Path, line) from `--from PATH:LINE`; (Path, None) without :LINE;
    (None, None) without --from."""
    if "--from" not in args:
        return None, None
    i = args.index("--from")
    if i + 1 >= len(args):
        return None, None
    m = re.match(r"^(.+):(\d+)$", args[i + 1])
    if m:
        return Path(m[1]).expanduser(), int(m[2])
    return Path(args[i + 1]).expanduser(), None


def _goto(source, lineno, raw, want_file):
    """Where `space , p` (want_file False) or `space , P` (True) goes from
    line lineno of source, whose text is raw -> a path or PATH:LINE.

    A line ending in `path:line:col` (file-task and orphan rows) goes to
    that file. A bullet goes to its ~/tasks/<slug>.md, if it exists; but p
    on an agenda row goes to the row's line in the inbox, the source of
    truth. Anything else stays: PATH:LINE (a bare path would put the
    cursor back at the top)."""
    here = f"{source}:{lineno}" if source and lineno else str(source or td_file())
    tail = re.search(r"(\S+):\d+:\d+\s*$", raw)
    if tail:
        candidate = Path(tail[1]).expanduser()
        if candidate.is_file():
            return str(candidate)
    bm = TASK.match(raw)
    if not bm:
        return here
    if _same_file(source, LIST_PATH) and not want_file:
        inbox = td_file()
        if inbox.is_file():
            _, hits, _ = _find_bullet_lines(inbox, bm["text"], bm["state"])
            if hits:
                return f"{inbox}:{hits[0] + 1}"
        return here
    target = task_folder() / f"{slugify(bm['text'])}.md"
    return str(target) if target.is_file() else here


def _hand_back(target):
    """Print target and write it to ~/.cache/td/open: the p and P keys send
    the line with :pipe-to, which drops stdout, then :open that file."""
    CACHE.mkdir(parents=True, exist_ok=True)
    OPEN_PATH.write_text(target + "\n", encoding="utf-8", errors="surrogateescape")
    print(target)


def cmd_promote(args):
    """stdin: a line; --from PATH:LINE says where it is. The `space , P` key
    pipes the line from the buffer, so a bullet not saved yet counts.

    A bullet gets its dedicated file ~/tasks/<slug>.md: written with a
    `# [S] title` heading if missing, else its heading is retagged with
    the bullet's state, and the agenda is refreshed for the new ` (*)`.
    The title leaves out the bullet's stamps and repeater: they stay the
    bullet's, and in the heading they would fire a second time and never
    move with a repeater bump. From the agenda nothing is written (it is a
    view). Then prints where P goes (see _goto): the dedicated file, or the
    line itself."""
    source, lineno = _from_spec(args)
    raw = sys.stdin.read().rstrip("\r\n")
    m = TASK.match(raw)
    named = _task_name(LINK.sub("", MARKER.sub("", m["text"]))) if m else None
    if named and not _same_file(source, LIST_PATH):
        core, slug = named
        folder = task_folder()
        folder.mkdir(parents=True, exist_ok=True)
        dedicated = folder / f"{slug}.md"
        if not dedicated.exists():
            dedicated.write_text(f"# [{canon(m['state'])}] {_identity_text(core)}\n\n",
                                 encoding="utf-8", errors="surrogateescape")
        else:
            _retag_dedicated_h1(core, canon(m["state"]))
        refresh_list()
    _hand_back(_goto(source, lineno, raw, want_file=True))
    return 0


def cmd_jump(args):
    """stdin: a line; --from PATH:LINE says where it is. The `space , p` key
    pipes the line from the buffer, so unsaved edits count. Prints where p
    goes (see _goto); never writes a task file."""
    source, lineno = _from_spec(args)
    raw = sys.stdin.read().rstrip("\r\n")
    _hand_back(_goto(source, lineno, raw, want_file=False))
    return 0


def _rewrite_checkbox(path, lineno, state):
    """Rewrite the checkbox char at path:lineno. -> True on success."""
    data = path.read_bytes().decode("utf-8", "surrogateescape")
    lines = data.splitlines(keepends=True)
    if lineno < 1 or lineno > len(lines):
        return False
    new = CHECKBOX.sub(f"- [{state}]", lines[lineno - 1], count=1)
    if new == lines[lineno - 1]:
        return False
    lines[lineno - 1] = new
    path.write_bytes("".join(lines).encode("utf-8", "surrogateescape"))
    return True


def cmd_set(args):
    if len(args) < 3:
        sys.exit("usage: td set PATH LINE STATE")
    path = Path(args[0]).expanduser()
    try:
        lineno = int(args[1])
    except ValueError:
        sys.exit("line must be integer")
    state = canon(args[2])
    if state not in STATE_NAMES:
        sys.exit(f"bad state: {state!r}")
    if not path.is_file():
        sys.exit(f"no such file: {path}")
    if not _rewrite_checkbox(path, lineno, state):
        sys.exit(f"no checkbox at {path}:{lineno}")
    return 0


def cmd_toggle(args):
    """Toggle state on a bullet.

    Two input modes:
      • `--from PATH --line N` reads the line from PATH on disk and writes
        the toggled version back to PATH:N. No stdout output.
      • Otherwise reads stdin, writes the toggled line to stdout, keeping
        its newline. The Helix bindings :pipe the line this way with
        --from; Helix puts stderr in place of the line, so that mode is
        silent on stderr.

    The agenda is a view: a row comes back unchanged, and the task it
    shows changes where it lives (see _toggle_agenda_row). Everywhere else
    the line is toggled, and from another file in $TL_DIR the inbox bullet
    with the same slug gets the same state.
    In a dedicated file (~/tasks/<slug>.md) the `# [S] title` heading
    toggles too, and sets the inbox bullet named by the file (an open one
    first, see _set_inbox_state); with no bullet, a file task, done moves
    its repeating date instead (see _set_file_task; from its buffer, only a
    date on the heading line can move, so with the date on another line the
    heading stays as it is). The inbox line is
    rewritten from itself, so it keeps its indent and link, and marking it
    done bumps it if it repeats. A line that is neither bullet nor heading
    changes only when it is a date with a repeater and the state is done:
    the date moves. The dedicated file's
    heading follows the inbox (unless that file is the one being edited:
    Helix saves it next), and agenda.md is refreshed.

    Outside $TL_DIR and the inbox (a README's checklist), or without
    --from, only the line itself changes."""
    if not args:
        sys.exit("usage: td toggle STATE [--from PATH [--line N]]")
    # A name (todo, waiting, ...) saves quoting " " in a key binding.
    state = STATE_FROM_NAME.get(args[0], canon(args[0]))
    if state not in STATE_NAMES:
        sys.exit(f"bad state: {state!r}")
    from_path = None
    line_no = None
    i = 1
    while i < len(args):
        if args[i] == "--from" and i + 1 < len(args):
            from_path = Path(args[i + 1]).expanduser()
            i += 2
        elif args[i] == "--line" and i + 1 < len(args):
            try:
                line_no = int(args[i + 1])
            except ValueError:
                sys.exit(f"bad --line: {args[i + 1]!r}")
            i += 2
        else:
            i += 1

    inbox = td_file()
    use_file = from_path is not None and line_no is not None
    if use_file:
        try:
            data = from_path.read_bytes().decode("utf-8", "surrogateescape")
        except OSError as e:
            sys.exit(f"td: {from_path}: {e}")
        lines = data.splitlines(keepends=True)
        if not 1 <= line_no <= len(lines):
            return 0
        raw = _split_eol(lines[line_no - 1])[0]
    else:
        raw, nl = _split_eol(sys.stdin.read())
        if from_path is not None:
            # Helix's :pipe puts any stderr output in place of the line.
            sys.stderr = open(os.devnull, "w")

    def emit(new_raw):
        if use_file:
            if new_raw != raw:
                _write_line(from_path, lines, line_no - 1, new_raw)
        else:
            sys.stdout.write(new_raw + nl)

    if _same_file(from_path, LIST_PATH):
        # The agenda is a view: the task changes where it lives, and the
        # agenda is rebuilt. The row itself comes back unchanged (the keys
        # undo it with :earlier, so Helix reloads the rebuilt agenda).
        _toggle_agenda_row(raw, state)
        if not use_file:
            sys.stdout.write(_changed(raw + nl))  # the keys undo this edit
        return 0

    from_inbox = _same_file(from_path, inbox)
    own_slug = _dedicated_slug(from_path)
    in_tasks = from_inbox or _in_task_folder(from_path)
    bm = TASK.match(raw)
    hm = H1_PARTS.match(raw) if own_slug and not bm else None
    if hm:
        # The dedicated file's heading: its file names the inbox bullet.
        cur = canon(hm["state"] or " ")
        wanted = " " if cur == state else state
        inbox_line = _set_inbox_state(inbox, own_slug, wanted)
        if inbox_line:
            new_state = canon(TASK.match(inbox_line)["state"])
            emit(f"{hm['hash']}[{new_state}] {hm['title']}{hm['trail']}")
        elif use_file:
            # A file task, on disk: done moves a repeating date instead.
            new_lines = _set_file_task(lines, line_no - 1, wanted)
            if new_lines != lines:
                from_path.write_bytes("".join(new_lines).encode("utf-8", "surrogateescape"))
        elif wanted in ("x", "X") and _repeats_below(from_path):
            # A file task, from its buffer, with its repeating date on
            # another line: only the heading came, and Helix saves the
            # buffer next, so the date can't move from here, and done would
            # end the repeats. The heading stays as it is (x on the date
            # line, or on the agenda row, moves the date).
            emit(raw)
        else:
            emit(_set_file_task([raw], 0, wanted)[0])
        refresh_list()
        return 0
    if not bm:
        # A date with a repeater on a line of its own (a file task's
        # `2026-12-15 Tue 11:50 ++2m`): done moves it. Other lines stay.
        bumped = _bump_recurring(raw, now()) if state in ("x", "X") else None
        emit(raw if bumped is None else bumped)
        return 0

    wanted = " " if canon(bm["state"]) == state else state
    new_raw = _set_state(raw, wanted)
    emit(new_raw)
    if not in_tasks:
        return 0  # a checklist elsewhere: this line only
    heading_state = canon(TASK.match(new_raw)["state"])
    slug = slugify(bm["text"])
    if not from_inbox:
        inbox_line = _set_inbox_state(inbox, slug, wanted)
        if inbox_line:
            heading_state = canon(TASK.match(inbox_line)["state"])
    if slug != own_slug:
        _retag_dedicated_h1(bm["text"], heading_state)
    refresh_list()
    return 0


def _toggle_agenda_row(raw, state):
    """Toggle state on the task an agenda row shows, where it lives, then
    rebuild the agenda. A bullet row: its todo.md line (the one with the
    same state and text, as space , p finds it), bumped instead if it
    repeats and state is done; its file's heading follows. A file-task row
    (ending `path:1:1`): that file's `# [S] title` heading, or done moves
    its repeating date instead (see _set_file_task). Anything else
    (orphans, headings, a stale row): nothing but the rebuild."""
    bm = TASK.match(raw)
    if bm:
        wanted = " " if canon(bm["state"]) == state else state
        frow = AGENDA_ROW.match(raw)
        if frow:
            path = Path(frow["path"]).expanduser()
            lines = (path.read_bytes().decode("utf-8", "surrogateescape").splitlines(keepends=True)
                     if path.is_file() else [])
            if lines and H1_PARTS.match(_split_eol(lines[0])[0]):
                new_lines = _set_file_task(lines, 0, wanted)
                if new_lines != lines:
                    path.write_bytes("".join(new_lines).encode("utf-8", "surrogateescape"))
        elif td_file().is_file():
            lines, hits, _ = _find_bullet_lines(td_file(), bm["text"], bm["state"])
            if hits:
                old = _split_eol(lines[hits[0]])[0]
                new = _set_state(old, wanted)
                if new != old:
                    _write_line(td_file(), lines, hits[0], new)
                nm = TASK.match(new)
                _retag_dedicated_h1(nm["text"], canon(nm["state"]))
    refresh_list()


def _set_state(raw, new_state):
    """raw with its checkbox set to new_state.

    Recurring: marking done (x/X) a line that carries a ++/.+ repeater bumps
    its date and keeps it todo instead — org-style anchored (++) or
    floating (.+) rescheduling.
    """
    if new_state in ("x", "X"):
        bumped = _bump_recurring(raw, now())
        if bumped is not None:
            return CHECKBOX.sub("- [ ]", bumped, count=1)
    return CHECKBOX.sub(f"- [{new_state}]", raw, count=1)


def _set_file_task(lines, head, wanted):
    """A file task's lines (line ends kept) with the heading at lines[head]
    set to [wanted] -> new lines. Done (x/X) on a task with a repeating date
    moves the date instead and sets [ ], as for a bullet: every line with a
    stamp and a ++/.+ repeater (`2026-12-15 Tue 11:50 ++2m`, or the heading
    itself) but a bullet's, since bullets are subtasks with dates of their
    own (see _bump_recurring)."""
    out = list(lines)
    if wanted in ("x", "X"):
        t = now()
        for i, line in enumerate(out):
            body, eol = _split_eol(line)
            bumped = None if TASK.match(body) else _bump_recurring(body, t)
            if bumped is not None:
                out[i] = bumped + eol
                wanted = " "
    body, eol = _split_eol(out[head])
    hm = H1_PARTS.match(body)
    if hm:
        out[head] = f"{hm['hash']}[{wanted}] {hm['title']}{hm['trail']}{eol}"
    return out


def _repeats_below(path):
    """True when the file task at path has, on disk, a repeating date under
    its first line that _set_file_task would move."""
    try:
        lines = path.read_bytes().decode("utf-8", "surrogateescape").splitlines()
    except OSError:
        return False
    t = now()
    return any(not TASK.match(line) and _bump_recurring(line, t) is not None
               for line in lines[1:])


def _in_task_folder(path):
    """True when path is a file directly in $TL_DIR (the inbox, a task's
    own file, a tl task file)."""
    if path is None:
        return False
    try:
        return path.resolve().parent == task_folder().resolve()
    except OSError:
        return False


def _dedicated_slug(path):
    """The slug when path is a dedicated file (~/tasks/<slug>.md other than
    the inbox), else None."""
    if path is None or path.suffix != ".md" or _same_file(path, td_file()):
        return None
    try:
        if path.resolve().parent != task_folder().resolve():
            return None
    except OSError:
        return None
    return path.stem


def _set_inbox_state(inbox, slug, new_state):
    """Set the inbox bullet whose slug is slug to new_state (bumping it if
    it repeats and new_state is done) -> its new line, or None. With
    several, the first open one ([ ]/[Y]/[A]/[W]); a done or ignored copy
    is an old task with the same name. Without an open one, the first."""
    if not inbox.is_file():
        return None
    lines = inbox.read_bytes().decode("utf-8", "surrogateescape").splitlines(keepends=True)
    hits = []  # (closed, index)
    for i, line in enumerate(lines):
        m = TASK.match(_split_eol(line)[0])
        if m and slugify(m["text"]) == slug:
            hits.append((canon(m["state"]) not in VISIBLE, i))
    if not hits:
        return None
    _, i = min(hits)
    raw = _split_eol(lines[i])[0]
    new = _set_state(raw, new_state)
    if new != raw:
        _write_line(inbox, lines, i, new)
    return new


def _write_line(path, lines, i, new):
    """Replace lines[i] with new, keeping the old line's ending ("\\r\\n"
    too, whatever new ends with), and write lines to path."""
    lines[i] = _split_eol(new)[0] + _split_eol(lines[i])[1]
    path.write_bytes("".join(lines).encode("utf-8", "surrogateescape"))


def _find_bullet_lines(path, text, old_state, exact=False):
    """Lines whose checkbox state and text match -> (lines, hits, needle).

    The caller's trailing ` (*)` is dropped: the agenda appends it for
    display; it is not part of the inbox bullet. With exact, the rest must
    match as is. Otherwise both sides also drop their `→ link` (core text).
    """
    def key(t):
        # Marker before link: the agenda writes `→ link (*)` and LINK is
        # anchored at end of line, so the marker has to come off first.
        t = MARKER.sub("", t).strip()
        return t if exact else LINK.sub("", t).strip()

    needle = key(text)
    data = path.read_bytes().decode("utf-8", "surrogateescape")
    lines = data.splitlines(keepends=True)
    hits = []
    for i, raw in enumerate(lines):
        m = TASK.match(raw.rstrip("\r\n"))
        if (m and canon(m["state"]) == canon(old_state)
                and key(m["text"]) == needle):
            hits.append(i)
    return lines, hits, needle


H1_WITH_STATE = re.compile(r"^(#\s+)(?:\[[ xXyYaAwW!]\]\s+)?(.+?)(\s*)$")
# The same, naming the parts and the state (None when the heading has none).
H1_PARTS = re.compile(
    r"^(?P<hash>#\s+)(?:\[(?P<state>[ xXyYaAwW!])\]\s+)?(?P<title>.+?)(?P<trail>\s*)$")


def _retag_dedicated_h1(text, new_state):
    """Rewrite the first H1 of ~/tasks/<slug>.md so it carries `[state] ` prefix.

    No-op when the dedicated file is absent. State " " strips the prefix.
    """
    core = LINK.sub("", MARKER.sub("", text)).strip()
    if not core:
        return False
    path = task_folder() / f"{slugify(core)}.md"
    if not path.is_file():
        return False
    data = path.read_bytes().decode("utf-8", "surrogateescape")
    lines = data.splitlines(keepends=True)
    for i, raw in enumerate(lines):
        body, tail = _split_eol(raw)
        m = H1_WITH_STATE.match(body)
        if not m:
            continue
        new = f"{m[1]}[{new_state}] {m[2]}{tail}"
        if new == raw:
            return False
        lines[i] = new
        path.write_bytes("".join(lines).encode("utf-8", "surrogateescape"))
        return True
    return False


def cmd_fire(args):
    """td fire PATH -> fire the SCHEDULE in that dedicated file now."""
    if not args:
        sys.exit("usage: td fire PATH")
    path = Path(args[0]).expanduser()
    if not path.is_file():
        sys.exit(f"no such file: {path}")
    lines = path.read_bytes().decode("utf-8", "surrogateescape").splitlines()
    _need_termux("fire")
    title = path.stem
    title_found = False
    due = None
    text = ""
    for i, raw in enumerate(lines, 1):
        hm = H1.match(raw)
        if hm and not title_found:
            title = hm[1]; title_found = True
        if due is None:
            ts = find_stamp(raw)
            if ts:
                try:
                    due = datetime.strptime(f"{ts[1]} {ts[2]}", "%Y-%m-%d %H:%M")
                    text = stamp_text(path, i, raw)
                except ValueError:
                    pass
    if not fire_notification("TODO", title, path):
        sys.exit("td fire: termux-notification failed")
    due_iso = (due or now()).isoformat(timespec="minutes")
    _append_sidecar(FIRED_PATH, [(due_iso, schedule_hash(str(path), due_iso, text),
                                  title[:80])])
    return 0


def build_alarm():
    """Compile bin/TdAlarm.java into ALARM_JAR with ecj and dx (both run on
    Android's own runtime: no JDK). -> error text, or None."""
    missing = [t for t in ("ecj", "dx") if not shutil.which(t)]
    if missing:
        return f"needs {' and '.join(missing)}: pkg install ecj dx"
    CACHE.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as out:
        for step in (["ecj", "-nowarn", "-d", out, str(ALARM_SRC)],
                     ["dx", "--dex", f"--output={ALARM_JAR}", out]):
            r = subprocess.run(step, capture_output=True, text=True)
            if r.returncode != 0:
                return f"{step[0]} failed:\n{r.stdout}{r.stderr}".rstrip()
    return None


def _cancel_job():
    """Drop the 15-min job older td versions registered."""
    subprocess.run(["termux-job-scheduler", "--cancel", "--job-id", str(JOB_ID)],
                   check=False, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)


def cmd_install():
    _need_termux("install")
    err = build_alarm()
    if err:
        sys.exit(f"td install: {err}")
    TICK_SHIM.parent.mkdir(parents=True, exist_ok=True)
    TICK_SHIM.write_text(f"#!/bin/sh\nexec {sys.executable} "
                         f"{Path(__file__).resolve()} tick \"$@\"\n")
    TICK_SHIM.chmod(0o755)
    _cancel_job()
    if cmd_tick() != 0:
        sys.exit(f"td install: see {tilde(ALARM_LOG)}")
    print(f"td: installed: alarm helper {tilde(ALARM_JAR)}, shim "
          f"{tilde(TICK_SHIM)}; the next reminder is armed (td next)")
    return 0


def cmd_uninstall():
    _need_termux("uninstall")
    _cancel_job()
    if ALARM_JAR.is_file():
        err = _run_alarm("cancel", str(TICK_SHIM))
        if err:
            print(f"td: could not cancel the alarm: {err}", file=sys.stderr)
    if TICK_SHIM.exists():
        TICK_SHIM.unlink()
    print("td: uninstalled: alarm cancelled, shim removed")
    return 0


# After these, a background tick re-arms the alarm: they may have moved,
# added or closed a reminder, and opening the agenda (`list`) re-arms it
# after a reboot. Not `stamp`, `shift` and `new`: their keys don't save the
# buffer, so a tick would only see the file as it was. Their change is
# armed like a hand edit, once saved: by the next tick.
RETICK = {"list", "file", "rename", "promote", "set", "toggle"}


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    rest = argv[2:]
    if cmd in RETICK:
        atexit.register(_tick_later)
    if cmd == "install":
        return cmd_install()
    if cmd == "uninstall":
        return cmd_uninstall()
    if cmd == "tick":
        return cmd_tick(rest)
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "next":
        return cmd_next()
    if cmd == "new":
        return cmd_new(rest)
    if cmd == "file":
        return cmd_file(rest)
    if cmd == "rename":
        return cmd_rename(rest)
    if cmd == "stamp":
        return cmd_stamp(rest)
    if cmd == "shift":
        return cmd_shift(rest)
    if cmd == "promote":
        return cmd_promote(rest)
    if cmd == "jump":
        return cmd_jump(rest)
    if cmd == "set":
        return cmd_set(rest)
    if cmd == "toggle":
        return cmd_toggle(rest)
    if cmd == "fire":
        return cmd_fire(rest)
    if cmd == "test":
        return run_tests("-v" in rest)
    sys.exit(__doc__)


# -------------------------------------------------------------------- tests

def run_tests(verbose=False):
    import json
    import subprocess as sp
    import tempfile
    import unittest

    NOW = "2026-10-10 11:00"
    TD = os.path.abspath(__file__)

    class Case(unittest.TestCase):
        maxDiff = None

        def setUp(self):
            tmp = tempfile.TemporaryDirectory()
            self.addCleanup(tmp.cleanup)
            self.home = Path(tmp.name)
            self.tasks = self.home / "tasks"
            self.tasks.mkdir()
            self.cache = self.home / ".cache" / "td"
            self.inbox = self.tasks / "todo.md"

        def put_inbox(self, text):
            self.inbox.write_bytes(text.encode("utf-8", "surrogateescape"))
            return self.inbox

        def put_dedicated(self, name, text):
            p = self.tasks / name
            p.write_bytes(text.encode("utf-8", "surrogateescape"))
            return p

        def td(self, *args, stdin="", now_=NOW, **env):
            """Run td. Lead time 0 unless given; an env value None unsets it."""
            return self.td_run(*args, stdin=stdin, now_=now_, check=True,
                               **env).stdout.decode("utf-8", "surrogateescape")

        def td_run(self, *args, stdin="", now_=NOW, check=False, **env):
            """Run td -> CompletedProcess. As if on Termux unless TD_TERMUX
            is given."""
            e = {**os.environ, "HOME": str(self.home), "TL_DIR": str(self.tasks),
                 "TL_NOW": now_, "TD_DRY_RUN": "1", "TD_LEAD_MIN": "0",
                 "TD_TERMUX": "1", **env}
            e = {k: v for k, v in e.items() if v is not None}
            return sp.run([sys.executable, TD, *args], env=e, capture_output=True,
                          input=stdin.encode("utf-8", "surrogateescape"),
                          check=check)

        def read_cache(self, name):
            p = self.cache / name
            return p.read_text(encoding="utf-8", errors="surrogateescape") if p.exists() else ""

        def touch(self, path, when):
            """Set path's mtime to `when` ("YYYY-MM-DD HH:MM", local time)."""
            ts = datetime.strptime(when, "%Y-%m-%d %H:%M").timestamp()
            os.utime(path, (ts, ts))

    class Parse(unittest.TestCase):
        def test_bullet_shapes(self):
            p = Path("x.md")
            b = parse_bullet(p, 1, "- [ ] call jon")
            self.assertEqual((b.state, b.text), (" ", "call jon"))
            b = parse_bullet(p, 2, "- [Y] pay rent")
            self.assertEqual(b.state, "Y")
            b = parse_bullet(p, 3, "  - [A] indented")
            self.assertEqual((b.indent, b.state), ("  ", "A"))
            self.assertIsNone(parse_bullet(p, 4, "not a task"))

        def test_hash_invariant_under_link_suffix(self):
            p = "/x.md"
            a = bullet_hash(p, "refactor td parser")
            b = bullet_hash(p, "refactor td parser → ~/tasks/refactor-td-parser.md")
            self.assertEqual(a, b)
            c = bullet_hash(p, "refactor td parser V2")
            self.assertNotEqual(a, c)

        def test_hash_ignores_trailing_stamp(self):
            p = "/x.md"
            plain = bullet_hash(p, "pay rent")
            stamped = bullet_hash(p, "pay rent 2026-11-01 Sat 09:00")
            bumped = bullet_hash(p, "pay rent 2026-12-01 Tue 09:00 ++1m")
            self.assertEqual(plain, stamped)
            self.assertEqual(plain, bumped)
            self.assertNotEqual(plain, bullet_hash(p, "pay rent later"))

        def test_identity_leaves_out_stamps_anywhere(self):
            # Text after the stamp, or two stamps: moving one keeps the task.
            p = "/x.md"
            for a, b in (("call bank 2026-10-12 10:00 - bring docs",
                          "call bank 2026-10-13 Tue 11:00 - bring docs"),
                         ("rent 2026-11-01 09:00 ++1m #home", "rent 2026-12-01 Tue 09:00 ++1m #home"),
                         ("trip 2026-10-12 10:00 or 2026-10-14 10:00",
                          "trip 2026-10-12 10:00 or 2026-10-15 Thu 10:00")):
                self.assertEqual(bullet_hash(p, a), bullet_hash(p, b), a)
                self.assertEqual(slugify(a), slugify(b), a)
            self.assertEqual(slugify("call bank 2026-10-12 10:00 - bring docs"), "call-bank-bring-docs")
            # A repeater goes with a stamp; on a line with none it is text.
            self.assertEqual(slugify("learn C ++1d"), "learn-c-1d")

        def test_slugify(self):
            self.assertEqual(slugify("Costco run!"), "costco-run")
            self.assertEqual(slugify("costCo RUN"), "costco-run")
            self.assertEqual(slugify("hello / world"), "hello-world")
            self.assertEqual(slugify("___"), "untitled")
            self.assertEqual(
                slugify("refactor td parser 2026-10-12 Sun 09:00"),
                "refactor-td-parser")
            self.assertEqual(
                slugify("pay rent 2026-11-01 Sat 09:00 ++1m"), "pay-rent")
            self.assertEqual(
                slugify("pay rent 2026-11-01 Sat 09:00 .+2w"), "pay-rent")
            self.assertEqual(slugify("pay rent 2026-11-01 09:00"), "pay-rent")
            self.assertEqual(
                slugify("pay rent 2026-10-01 Thu 09:00 ++1m"),
                slugify("pay rent 2026-11-01 Sun 09:00 ++1m"))
            self.assertEqual(
                slugify("refactor td parser 2026-10-12 Sun 09:00 (*)"),
                "refactor-td-parser")
            self.assertEqual(
                slugify("Pay rent 2026-11-01 Sat 09:00 → ~/tasks/pay-rent.md"),
                "pay-rent")
            # A date inside the title, with no time, is not a stamp.
            self.assertEqual(slugify("party 2026-11-01"), "party-2026-11-01")

    class List(Case):
        def test_groups_and_sort(self):
            self.put_inbox("- [ ] call jon\n- [A] refactor\n- [Y] pay rent\n")
            out = self.td("list")
            self.assertIn(LEGEND, out)
            self.assertLess(out.index("# TODAY"), out.index("# ACTIVE"))
            self.assertLess(out.index("# ACTIVE"), out.index("# TODO"))
            for word in ("refactor", "call jon", "pay rent"):
                self.assertIn(word, out)

        def test_filter_state(self):
            self.put_inbox("- [ ] a\n- [Y] b\n- [A] c\n- [x] d\n")
            out = self.td("list", "--state", "today")
            self.assertIn("# TODAY", out)
            self.assertIn("- [Y] b", out)
            self.assertNotIn("- [ ] a", out)
            self.assertNotIn("- [A] c", out)

        def test_done_and_ignore_hidden(self):
            self.put_inbox("- [x] done\n- [X] also done\n- [!] ignore\n- [ ] visible\n")
            out = self.td("list")
            self.assertIn("visible", out)
            for word in ("done", "also done", "ignore"):
                self.assertNotIn(word, out)

        def test_done_view(self):
            # space , D: done bullets and file tasks, most recently changed
            # first; nothing open, no orphans.
            p = self.put_inbox("- [x] alpha\n- [X] bravo\n- [ ] open\n- [!] ignored\n")
            passport = self.put_dedicated("passport.md", "# [x] renew passport\n")
            self.touch(passport, "2026-10-10 10:00")
            self.put_dedicated("old-task.md", "# old\n")
            self.td("list", now_="2026-10-10 11:00")
            p.write_text("- [ ] alpha\n- [X] bravo\n- [ ] open\n- [!] ignored\n")
            self.td("list", now_="2026-10-10 11:05")
            p.write_text("- [x] alpha\n- [X] bravo\n- [ ] open\n- [!] ignored\n")
            out = self.td("list", "--state", "done", "--sort", "modified",
                          now_="2026-10-10 11:10")
            self.assertIn("# DONE\n\n- [x] alpha\n", out)
            self.assertIn("- [X] bravo", out)
            self.assertIn("- [x] renew passport  ~/tasks/passport.md:1:1", out)
            for word in ("open", "ignored", "ORPHANS", "TODO"):
                self.assertNotIn(word, out)

        def test_bullet_rows_have_no_path(self):
            self.put_inbox("- [ ] call jon\n")
            out = self.td("list")
            self.assertIn("- [ ] call jon", out)
            self.assertNotIn("todo.md:", out)

        def test_orphan_rows_keep_path(self):
            self.put_inbox("- [ ] alpha\n")
            self.put_dedicated("costco-run.md", "# Costco run!\n")
            out = self.td("list")
            self.assertIn("# ORPHANS", out)
            self.assertRegex(out, r"- costco-run\s+~/tasks/costco-run\.md:1:1")

        def test_writes_cache_file(self):
            self.put_inbox("- [ ] call jon\n")
            self.td("list")
            self.assertIn("call jon", self.read_cache("agenda.md"))

        def test_only_inbox_scanned(self):
            self.put_inbox("- [ ] from inbox\n")
            self.put_dedicated("other.md", "- [ ] from dedicated\n")
            out = self.td("list")
            self.assertIn("from inbox", out)
            self.assertNotIn("from dedicated", out)

        def test_sort_modified(self):
            # bravo is added after alpha, so it starts out on top. Changing
            # alpha's line (here, stamping it) moves alpha above it, while
            # the added order stays as it was.
            self.put_inbox("- [ ] alpha\n")
            self.td("list", now_="2026-10-10 11:00")
            self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:05")
            self.assertLess(out.index("bravo"), out.index("alpha"))
            self.put_inbox("- [ ] alpha 2026-10-12 Mon 09:00\n- [ ] bravo\n")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:10")
            self.assertLess(out.index("alpha"), out.index("bravo"))
            out = self.td("list", now_="2026-10-10 11:15")
            self.assertLess(out.index("bravo"), out.index("alpha"))

        def test_sort_modified_counts_toggles(self):
            p = self.put_inbox("- [ ] alpha\n")
            self.td("list", now_="2026-10-10 11:00")
            self.put_inbox("- [ ] bravo\n- [ ] alpha\n")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:05")
            self.assertLess(out.index("bravo"), out.index("alpha"))
            # Toggling alpha to [y] and back is a change, made through td.
            for _ in range(2):
                self.td("toggle", "Y", "--from", str(p), "--line", "2",
                        now_="2026-10-10 11:10")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:15")
            self.assertLess(out.index("alpha"), out.index("bravo"))

        def test_sort_modified_counts_dedicated_file(self):
            self.put_inbox("- [ ] alpha\n")
            self.td("list", now_="2026-10-10 11:00")
            self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            self.td("list", now_="2026-10-10 11:05")
            notes = self.put_dedicated("alpha.md", "# alpha\n\nnotes\n")
            self.touch(notes, "2026-10-10 11:20")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:25")
            self.assertLess(out.index("alpha"), out.index("bravo"))
            self.touch(notes, "2026-10-10 10:00")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:25")
            self.assertLess(out.index("bravo"), out.index("alpha"))

        def test_added_and_changed_keep_one_row_per_task(self):
            # Edits and deleted tasks don't pile up rows; order survives.
            p = self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            self.td("list")
            p.write_text("- [Y] alpha\n- [ ] bravo\n")
            self.td("list", now_="2026-10-10 11:10")
            p.write_text("- [ ] charlie\n- [ ] alpha\n")
            out = self.td("list", now_="2026-10-10 11:20")
            self.assertLess(out.index("charlie"), out.index("alpha"))
            for name in ("added", "changed"):
                rows = self.read_cache(name).splitlines()
                self.assertEqual(len(rows), 2, name)
                self.assertFalse(any("bravo" in r for r in rows), name)

        def test_changed_sidecar_steady_with_duplicate_bullets(self):
            # Same identity, different states: recorded once, not on every run.
            self.put_inbox("- [ ] call mom\n- [x] call mom\n")
            self.td("list")
            self.td("list", now_="2026-10-10 11:30")
            self.assertEqual(len(self.read_cache("changed").splitlines()), 1)

        def test_stamp_does_not_reshuffle_added_order(self):
            # Bravo is first-seen later, so added-sort puts it above alpha.
            # Stamping alpha must not mint a new hash and jump it back to the top.
            self.put_inbox("- [ ] alpha\n")
            self.td("list", now_="2026-10-10 11:00")
            self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            out = self.td("list", now_="2026-10-10 11:05")
            self.assertLess(out.index("bravo"), out.index("alpha"))
            self.put_inbox(
                "- [ ] alpha 2026-10-12 Sun 09:00 ++1w\n- [ ] bravo\n")
            out = self.td("list", now_="2026-10-10 12:00")
            self.assertLess(out.index("bravo"), out.index("alpha"))

        def test_added_seconds_apart_newest_first(self):
            # The real clock: two tasks added within a minute keep their order.
            self.put_inbox("- [ ] alpha\n")
            self.td("list", TL_NOW=None)
            time.sleep(1.1)
            self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            out = self.td("list", TL_NOW=None)
            self.assertLess(out.index("bravo"), out.index("alpha"))

    class Tick(Case):
        def test_future_timestamp_fires_when_due(self):
            # First tick (NOW = 11:00) sees future; records in scheduled.
            self.put_dedicated("rent.md", "# rent\n2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("would fire", out)
            self.assertIn("rent", out)

        def test_past_only_never_fires(self):
            # Entry is already past at first observation — never scheduled,
            # never fires. This is what blocks random date mentions / tl
            # entries that pre-date td's awareness.
            self.put_dedicated("stale.md", "# stale\n2026-10-10 04:00\n")
            out = self.td("tick")
            self.assertNotIn("would fire", out)
            later = self.td("tick", now_="2026-10-10 15:00")
            self.assertNotIn("would fire", later)

        def test_tl_entries_dont_fire(self):
            # `YYYY-MM-DD HH:MM - ...` is a tl log entry — the trailing
            # ` - ` keeps it out of the SCHEDULE_TS match entirely.
            self.put_dedicated("rent.md",
                               "# rent\n2026-10-10 12:00 - started work\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 13:00")
            self.assertNotIn("would fire", out)

        def test_future_alone_doesnt_fire(self):
            self.put_dedicated("later.md", "# later\n2026-10-11 09:00\n")
            out = self.td("tick")
            self.assertNotIn("would fire", out)

        def test_dedup(self):
            self.put_dedicated("rent.md", "# rent\n2026-10-10 12:00\n")
            self.td("tick")
            self.td("tick", now_="2026-10-10 12:00")
            second = self.td("tick", now_="2026-10-10 12:00")
            self.assertNotIn("would fire", second)

        def test_reschedule_rearms(self):
            p = self.put_dedicated("rent.md", "# rent\n2026-10-10 12:00\n")
            self.td("tick")
            self.td("tick", now_="2026-10-10 12:00")
            p.write_text("# rent\n2026-10-10 13:00\n")
            self.td("tick", now_="2026-10-10 12:00")
            out = self.td("tick", now_="2026-10-10 13:00")
            self.assertIn("would fire", out)

        def test_lead_minutes(self):
            # Due at 11:10; lead 15m means fire_at = 10:55 ≤ NOW(11:00).
            # First observation at an earlier NOW is required to seed
            # scheduled. Then a tick at NOW=11:00 fires.
            self.put_dedicated("rent.md", "# rent\n2026-10-10 11:10\n")
            self.td("tick", now_="2026-10-10 10:00", TD_LEAD_MIN="15")
            out = self.td("tick", TD_LEAD_MIN="15")
            self.assertIn("would fire", out)

        def test_no_timestamp_no_fire(self):
            self.put_dedicated("note.md", "# just a note\n\nsome content\n")
            out = self.td("tick")
            self.assertNotIn("would fire", out)

        def test_inbox_bullet_without_date_doesnt_fire(self):
            self.put_inbox("- [ ] no fire please\n")
            out = self.td("tick")
            self.assertNotIn("would fire", out)

        def test_inbox_bullet_with_future_date_fires_when_due(self):
            self.put_inbox("- [ ] pay rent 2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("would fire", out)
            self.assertIn("pay rent", out)

        def test_inbox_done_bullet_doesnt_fire(self):
            self.put_inbox("- [x] already done 2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertNotIn("would fire", out)

        def test_inbox_today_bullet_with_future_date_fires(self):
            self.put_inbox("- [Y] call jon 2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("would fire", out)

        def test_inbox_dedup(self):
            self.put_inbox("- [ ] pay rent 2026-10-10 12:00\n")
            self.td("tick")
            self.td("tick", now_="2026-10-10 12:00")
            second = self.td("tick", now_="2026-10-10 12:00")
            self.assertNotIn("would fire", second)

        def test_title_from_h1(self):
            self.put_dedicated("x.md", "# nice title\n2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("nice title", out)

        def test_title_fallback_to_stem(self):
            self.put_dedicated("stemmed.md", "2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("stemmed", out)

        def test_note_after_time_still_fires(self):
            # " - " after a stamp mid-line is text, not a tl entry.
            self.put_inbox("- [ ] call bank 2026-10-10 12:00 - bring docs\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("would fire", out)
            self.assertIn("call bank", out)

        def test_tl_entry_shapes_dont_fire(self):
            # The leading time of any line tl reads as an entry.
            self.put_dedicated("log.md", "# log\n"
                               "- [ ] 2026-10-10 12:00 -\n"
                               "* 2026-10-10 12:00 -  note\n"
                               "2026-10-10 12:00–13:00\n"
                               "2026-10-10 12:00-13:00 = 1h 00min\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 13:00")
            self.assertNotIn("would fire", out)

        def test_inbox_outside_task_folder_fires(self):
            inbox = self.home / "elsewhere" / "inbox.md"
            inbox.parent.mkdir()
            inbox.write_text("- [ ] dentist 2026-10-10 12:00\n")
            self.td("tick", TD_FILE=str(inbox))
            out = self.td("tick", now_="2026-10-10 12:00", TD_FILE=str(inbox))
            self.assertIn("would fire", out)
            self.assertIn("dentist", out)

        def test_done_or_ignored_dedicated_file_doesnt_fire(self):
            for state in ("x", "X", "!"):
                with self.subTest(state=state):
                    self.put_dedicated("renew-passport.md",
                                       f"# [{state}] renew passport\n\n"
                                       "2026-10-10 12:00\n")
                    self.td("tick")
                    out = self.td("tick", now_="2026-10-10 12:00")
                    self.assertNotIn("would fire", out)

        def test_dedicated_file_follows_its_bullet(self):
            # Done by hand (or `space . x`, which writes [X]): the heading
            # was never retagged, but the file stops firing with its bullet.
            self.put_dedicated("call-vendor.md",
                               "# call vendor\n\nfollow up 2026-10-10 12:00\n")
            for inbox, fires in (("- [X] call vendor\n", False),
                                 ("- [!] call vendor\n", False),
                                 ("- [W] call vendor\n", True),
                                 # an old done copy doesn't stop the open one
                                 ("- [x] call vendor\n- [ ] call vendor\n", True)):
                with self.subTest(inbox=inbox):
                    self.cache.joinpath("fired").unlink(missing_ok=True)
                    self.put_inbox(inbox)
                    self.td("tick")
                    out = self.td("tick", now_="2026-10-10 12:00")
                    self.assertEqual("would fire" in out, fires)

        def test_open_bullet_beats_a_stale_done_heading(self):
            self.put_inbox("- [ ] renew passport\n")
            self.put_dedicated("renew-passport.md",
                               "# [x] renew passport\n\n2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("renew passport", out)

        def test_lead_defaults_to_zero(self):
            # TD_LEAD_MIN unset: the alarm fires at the stamped minute.
            self.put_dedicated("rent.md", "# rent\n2026-10-10 11:10\n")
            out = self.td("tick", now_="2026-10-10 10:00", TD_LEAD_MIN=None)
            self.assertIn("would arm: 2026-10-10 11:10:00", out)
            out = self.td("tick", now_="2026-10-10 11:09", TD_LEAD_MIN=None)
            self.assertNotIn("would fire", out)
            out = self.td("tick", now_="2026-10-10 11:10", TD_LEAD_MIN=None)
            self.assertIn("would fire", out)

        def test_arms_the_nearest_unfired(self):
            self.put_dedicated("a.md", "# a\n2026-10-10 12:00\n")
            self.put_dedicated("b.md", "# b\n2026-10-10 13:00\n")
            self.assertIn("would arm: 2026-10-10 12:00:00", self.td("tick"))
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("would fire", out)
            self.assertIn("would arm: 2026-10-10 13:00:00", out)
            out = self.td("tick", now_="2026-10-10 13:00")
            self.assertIn("would arm: nothing", out)

        def test_arms_lead_minutes_early(self):
            self.put_dedicated("a.md", "# a\n2026-10-10 12:00\n")
            out = self.td("tick", TD_LEAD_MIN="15")
            self.assertIn("would arm: 2026-10-10 11:45:00", out)

        def test_new_earlier_reminder_moves_the_alarm(self):
            p = self.put_inbox("- [ ] late 2026-10-10 14:00\n")
            self.assertIn("would arm: 2026-10-10 14:00:00", self.td("tick"))
            p.write_text("- [ ] late 2026-10-10 14:00\n"
                         "- [ ] soon 2026-10-10 11:30\n")
            self.assertIn("would arm: 2026-10-10 11:30:00",
                          self.td("tick", now_="2026-10-10 11:05"))
            # Marked done: the alarm moves back to the one left.
            p.write_text("- [ ] late 2026-10-10 14:00\n"
                         "- [x] soon 2026-10-10 11:30\n")
            self.assertIn("would arm: 2026-10-10 14:00:00",
                          self.td("tick", now_="2026-10-10 11:10"))

        def test_same_minute_in_one_file_both_fire(self):
            self.put_inbox("- [ ] call mum 2026-10-10 18:00\n"
                           "- [ ] water plants 2026-10-10 18:00\n")
            self.put_dedicated("trip.md", "# trip\npack 2026-10-10 18:00\n"
                               "book taxi 2026-10-10 18:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 18:00")
            self.assertEqual(out.count("would fire"), 4)
            self.assertIn("call mum", out)
            self.assertIn("water plants", out)
            again = self.td("tick", now_="2026-10-10 18:05")
            self.assertNotIn("would fire", again)

        def test_state_change_keeps_the_key(self):
            # [ ] → [Y] after firing: the same reminder, not a new one.
            p = self.put_inbox("- [ ] pay rent 2026-10-10 12:00\n")
            self.td("tick")
            self.td("tick", now_="2026-10-10 12:00")
            p.write_text("- [Y] pay rent 2026-10-10 12:00\n")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertNotIn("would fire", out)

        def test_every_stamp_on_a_line_fires(self):
            self.put_inbox("- [ ] call bank 2026-10-10 12:00, or 2026-10-10 13:00\n")
            self.td("tick")
            self.assertEqual(self.td("tick", now_="2026-10-10 12:00").count("would fire"), 1)
            self.assertEqual(self.td("tick", now_="2026-10-10 13:00").count("would fire"), 1)

        def test_closed_subtask_in_a_task_file_doesnt_fire(self):
            self.put_dedicated("trip.md", "# trip\n- [x] book taxi 2026-10-10 12:00\n"
                               "- [!] call hotel 2026-10-10 12:00\n- [ ] pack 2026-10-10 12:00\n"
                               "check in 2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertEqual(out.count("would fire"), 2)
            self.assertIn("trip", out)

        def test_tl_entry_in_any_state_doesnt_fire(self):
            # A status key on a time-log bullet doesn't turn it into a reminder.
            self.put_inbox("- [Y] 2026-10-10 12:00 - prep slides\n")
            self.put_dedicated("talk.md", "# talk\n- [A] 2026-10-10 12:00 - rehearse\n")
            self.td("tick")
            self.assertNotIn("would fire", self.td("tick", now_="2026-10-10 12:00"))

        def test_recurring_fires_each_time(self):
            # Fires, is marked done (bumps a day), fires again the next day.
            p = self.put_inbox("- [ ] pills 2026-10-10 Sat 12:00 ++1d\n"
                               "- [ ] plants 2026-10-10 Sat 12:00 ++1d\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertEqual(out.count("would fire"), 2)
            for line in (1, 2):
                self.td("toggle", "x", "--from", str(p), "--line", str(line),
                        now_="2026-10-10 12:30")
            self.assertEqual(p.read_text(),
                             "- [ ] pills 2026-10-11 Sun 12:00 ++1d\n"
                             "- [ ] plants 2026-10-11 Sun 12:00 ++1d\n")
            out = self.td("tick", now_="2026-10-10 12:35")
            self.assertNotIn("would fire", out)
            self.assertIn("would arm: 2026-10-11 12:00:00", out)
            out = self.td("tick", now_="2026-10-11 12:00")
            self.assertEqual(out.count("would fire"), 2)

        def test_failed_notification_retries(self):
            # termux-notification fails: not recorded as fired, the alarm
            # retries a minute later, and the retry fires it.
            fake = self.home / "bin"
            fake.mkdir()
            notify = fake / "termux-notification"
            notify.write_text("#!/bin/sh\nexit 1\n")
            notify.chmod(0o755)
            path = f"{fake}:{os.environ['PATH']}"
            self.put_inbox("- [ ] call back 2026-10-10 11:05\n")
            self.td("tick")
            self.td_run("tick", now_="2026-10-10 11:05", TD_DRY_RUN=None,
                        PATH=path)
            self.assertEqual(self.read_cache("fired"), "")
            # No helper in this HOME, so the arm is logged as failed.
            self.assertIn("could not arm 2026-10-10 11:06:00",
                          self.read_cache("alarm.log"))
            notify.write_text("#!/bin/sh\nexit 0\n")
            self.td_run("tick", now_="2026-10-10 11:06", TD_DRY_RUN=None,
                        PATH=path)
            self.assertIn("call back", self.read_cache("fired"))

        def test_prunes_reminder_rows_a_week_after_due(self):
            # The first tick of a day drops rows due over 7 days earlier;
            # the old reminder, still in the file, doesn't fire again.
            self.put_inbox("- [ ] old 2026-10-01 12:00\n"
                           "- [ ] recent 2026-10-08 12:00\n")
            self.td("tick", now_="2026-10-01 11:00")
            self.td("stamp", stdin="- [ ] did\n", now_="2026-10-01 11:07")
            self.td("tick", now_="2026-10-01 12:00")
            self.td("tick", now_="2026-10-08 12:00")
            self.cache.joinpath("alarm.log").write_text(
                "2026-10-01T09:00:00  could not arm old\n"
                "2026-10-08T09:00:00  could not arm recent\n")
            self.td("tick", now_="2026-10-09 09:00")
            for name in ("fired", "scheduled"):
                self.assertNotIn("old", self.read_cache(name), name)
                self.assertIn("recent", self.read_cache(name), name)
            self.assertEqual(self.read_cache("stamped-now"), "")
            self.assertEqual(self.read_cache("alarm.log"),
                             "2026-10-08T09:00:00  could not arm recent\n")
            self.assertNotIn("would fire",
                             self.td("tick", now_="2026-10-09 10:00"))
            # Ticks don't write `added` (it orders the agenda's tasks).
            self.assertEqual(self.read_cache("added"), "")

        def test_reminders_need_termux(self):
            self.put_inbox("- [ ] call 2026-10-10 12:00\n")
            r = self.td_run("tick", TD_TERMUX="0")
            self.assertNotEqual(r.returncode, 0)
            self.assertIn(b"need Termux", r.stderr)
            self.assertIn("call", self.td("list", TD_TERMUX="0"))

        def test_active_dedicated_file_fires(self):
            self.put_dedicated("renew-passport.md",
                               "# [A] renew passport\n\n2026-10-10 12:00\n")
            self.td("tick")
            out = self.td("tick", now_="2026-10-10 12:00")
            self.assertIn("would fire", out)
            self.assertIn("renew passport", out)

        def test_added_between_ticks_fires(self):
            # Added after the 11:00 tick, due 11:05: no tick saw it as
            # future, but it was still to come at the previous tick. The
            # file was edited again after it was due (its mtime is "now"),
            # which doesn't matter.
            self.td("tick")
            self.put_dedicated("call-back.md", "# call back\n2026-10-10 11:05\n")
            out = self.td("tick", now_="2026-10-10 11:15")
            self.assertIn("would fire", out)
            self.assertIn("call back", out)
            again = self.td("tick", now_="2026-10-10 11:30")
            self.assertNotIn("would fire", again)

        def test_inbox_bullet_added_between_ticks_fires(self):
            self.td("tick")
            self.put_inbox("- [ ] call back 2026-10-10 11:05\n- [ ] other\n")
            out = self.td("tick", now_="2026-10-10 11:15")
            self.assertIn("would fire", out)

        def test_stamp_of_now_doesnt_fire(self):
            # `space , s` on a line at 11:07 writes 11:07: already due when
            # written, so it is a note, not a reminder.
            self.td("tick")
            line = self.td("stamp", stdin="- [ ] did it\n", now_="2026-10-10 11:07")
            self.put_inbox(line)
            out = self.td("tick", now_="2026-10-10 11:15")
            self.assertNotIn("would fire", out)

        def test_stamp_moved_to_later_time_fires(self):
            # Stamp at 11:07, then the time edited to 11:10: a reminder.
            self.td("tick")
            line = self.td("stamp", stdin="- [ ] call\n", now_="2026-10-10 11:07")
            self.put_inbox(line.replace("11:07", "11:10"))
            out = self.td("tick", now_="2026-10-10 11:15")
            self.assertIn("would fire", out)

        def test_added_inside_lead_window_fires(self):
            # Lead 15: due 11:00 fires from 10:45. Added after the 10:46
            # tick, it fires on the 10:55 tick, before it is due.
            self.td("tick", now_="2026-10-10 10:46", TD_LEAD_MIN="15")
            self.put_dedicated("call.md", "# call\n2026-10-10 11:00\n")
            out = self.td("tick", now_="2026-10-10 10:55", TD_LEAD_MIN="15")
            self.assertIn("would fire", out)

        def test_due_before_previous_tick_doesnt_fire(self):
            # Due 10:50, before the 11:00 tick: an old date, not new.
            self.td("tick")
            self.put_dedicated("old.md", "# old\n2026-10-10 10:50\n")
            out = self.td("tick", now_="2026-10-10 11:15")
            self.assertNotIn("would fire", out)

        def test_first_tick_ever_fires_nothing_past(self):
            # No previous tick to compare with: nothing already due fires.
            self.put_dedicated("x.md", "# x\n2026-10-10 10:59\n")
            out = self.td("tick")
            self.assertNotIn("would fire", out)

    class New(Case):
        def test_defaults(self):
            self.assertEqual(self.td("new"), "- [ ] ")

        def test_states(self):
            self.assertEqual(self.td("new", "--state", "today"), "- [Y] ")
            self.assertEqual(self.td("new", "--state", "active"), "- [A] ")

        def test_after_line(self):
            self.assertEqual(self.td("new", "-", stdin="- [ ] call jon\n"),
                             "- [ ] call jon\n- [ ] \n")
            self.assertEqual(self.td("new", "-", stdin="# inbox"),
                             "# inbox\n- [ ] ")
            self.assertEqual(self.td("new", "-", stdin="\n"), "\n- [ ] \n")

        def test_reuses_empty_bullet(self):
            self.assertEqual(self.td("new", "-", stdin="- [ ] \n"), "- [ ] \n")
            self.assertEqual(self.td("new", "-", stdin="- [ ]"), "- [ ] ")
            self.assertEqual(self.td("new", "-", stdin="- [ ]   \n"), "- [ ] \n")
            # Another state's empty bullet is a line like any other.
            self.assertEqual(self.td("new", "-", stdin="- [Y] \n"),
                             "- [Y] \n- [ ] \n")

        def test_empty_buffer(self):
            self.assertEqual(self.td("new", "-", stdin=""), "- [ ] ")
            self.assertEqual(self.td("new", "-", "--above", stdin=""), "- [ ] ")

        def test_above_line(self):
            self.assertEqual(self.td("new", "-", "--above", stdin="- [ ] call jon\n"),
                             "- [ ] \n- [ ] call jon\n")
            self.assertEqual(self.td("new", "-", "--above", stdin="# inbox"),
                             "- [ ] \n# inbox")
            self.assertEqual(self.td("new", "-", "--above", stdin="- [ ]\n"), "- [ ] \n")

    class Stamp(Case):
        # NOW = "2026-10-10 11:00"  → %a = "Sat"
        def test_append_when_no_date(self):
            out = self.td("stamp", stdin="- [Y] call jon")
            self.assertEqual(out, "- [Y] call jon 2026-10-10 Sat 11:00")

        def test_append_when_empty_line(self):
            self.assertEqual(self.td("stamp", stdin=""), "2026-10-10 Sat 11:00")

        def test_replace_existing_date_with_today(self):
            out = self.td("stamp",
                          stdin="- [Y] pay rent 2025-12-25 Thu 09:00")
            self.assertEqual(out, "- [Y] pay rent 2026-10-10 Sat 09:00")

        def test_replace_without_weekday_fills_it_in(self):
            # existing timestamp has no weekday — replace keeps the time
            out = self.td("stamp", stdin="meeting 2025-12-25 09:00")
            self.assertEqual(out, "meeting 2026-10-10 Sat 09:00")

        def test_date_only_line_falls_through_to_append(self):
            # SCHEDULE_TS requires a time, so a bare date is not recognised
            # as a stamp → treated as "no date", fresh stamp appended.
            out = self.td("stamp", stdin="meeting 2025-12-25")
            self.assertTrue(out.endswith("2026-10-10 Sat 11:00"))
            self.assertIn("2025-12-25", out)

        def test_restamp_fixes_weekday_only(self):
            # 2026-10-15 is a Thu — restamp fixes a wrong weekday
            out = self.td("stamp", "--restamp",
                          stdin="- [Y] pay rent 2026-10-15 Sun 09:00")
            self.assertEqual(out, "- [Y] pay rent 2026-10-15 Thu 09:00")

        def test_restamp_adds_missing_weekday(self):
            out = self.td("stamp", "--restamp",
                          stdin="pay rent 2026-10-15 09:00")
            self.assertEqual(out, "pay rent 2026-10-15 Thu 09:00")

        def test_restamp_no_date_passthrough(self):
            self.assertEqual(self.td("stamp", "--restamp", stdin="- [ ] todo"),
                             "- [ ] todo")

        def test_preserves_trailing_newline(self):
            self.assertEqual(self.td("stamp", stdin="x\n"),
                             "x 2026-10-10 Sat 11:00\n")

        def test_tl_log_entry_not_touched(self):
            # A tl entry's leading time is not a schedule → `stamp` leaves it
            # alone and appends a fresh stamp at end
            out = self.td("stamp",
                          stdin="2026-10-08 19:16 - 19:17 = 0h 01min")
            self.assertTrue(out.endswith("2026-10-10 Sat 11:00"))
            self.assertTrue(out.startswith("2026-10-08 19:16 - 19:17"))

        def test_col_on_stamp_fixes_weekday_only(self):
            line = "- [Y] pay rent 2026-10-15 Sun 09:00"
            for col in (16, 27, 31, 35, 36):  # first digit .. just past the end
                out = self.td("stamp", "--col", str(col), stdin=line)
                self.assertEqual(out, "- [Y] pay rent 2026-10-15 Thu 09:00", col)

        def test_col_off_stamp_moves_to_today(self):
            out = self.td("stamp", "--col", "3",
                          stdin="- [Y] pay rent 2026-10-15 Sun 09:00")
            self.assertEqual(out, "- [Y] pay rent 2026-10-10 Sat 09:00")

        def test_col_without_stamp_appends(self):
            out = self.td("stamp", "--col", "3", stdin="- [Y] call jon")
            self.assertEqual(out, "- [Y] call jon 2026-10-10 Sat 11:00")

        def test_col_bad_value_ignored(self):
            out = self.td("stamp", "--col", stdin="meeting 2025-12-25 09:00")
            self.assertEqual(out, "meeting 2026-10-10 Sat 09:00")

        def shift(self, n, line, col=None):
            args = ["shift", n] + (["--col", str(col)] if col else [])
            return self.td(*args, stdin=line)

        def test_shift_by_cursor_part(self):
            line = "- [ ] pay rent 2026-10-20 Tue 09:30 #home\n"
            # stamp starts at col 16: year 16-20, month 21-23, day 24-26,
            # weekday 27-30, hour 31-33, minute 34-35
            cases = {(16, "+1"): "2027-10-20 Wed 09:30", (20, "-1"): "2025-10-20 Mon 09:30",
                     (21, "+1"): "2026-11-20 Fri 09:30", (23, "-1"): "2026-09-20 Sun 09:30",
                     (25, "+1"): "2026-10-21 Wed 09:30", (28, "-1"): "2026-10-19 Mon 09:30",
                     (31, "+1"): "2026-10-20 Tue 10:30", (33, "-1"): "2026-10-20 Tue 08:30",
                     (34, "+1"): "2026-10-20 Tue 09:35", (35, "-1"): "2026-10-20 Tue 09:25"}
            for (col, n), stamp in cases.items():
                self.assertEqual(self.shift(n, line, col),
                                 f"- [ ] pay rent {stamp} #home\n", (col, n))
                self.assertEqual(self.read_cache("stamp-col"), f"{col}\n", (col, n))

        def test_shift_off_stamp_moves_day(self):
            line = "- [ ] pay rent 2026-10-20 Tue 09:30"
            for col in (None, 3, 36):
                self.assertEqual(self.shift("+1", line, col),
                                 "- [ ] pay rent 2026-10-21 Wed 09:30", col)

        def test_two_stamps_the_one_under_the_cursor_moves(self):
            line = "- [ ] call 2026-10-12 Mon 10:00 or 2026-10-14 Wed 10:00\n"
            # the first stamp's day is cols 20-21, the second's 44-45
            self.assertEqual(self.shift("+1", line, 45),
                             "- [ ] call 2026-10-12 Mon 10:00 or 2026-10-15 Thu 10:00\n")
            self.assertEqual(self.shift("+1", line, 21),
                             "- [ ] call 2026-10-13 Tue 10:00 or 2026-10-14 Wed 10:00\n")
            self.assertEqual(self.shift("+1", line, 3),
                             "- [ ] call 2026-10-13 Tue 10:00 or 2026-10-14 Wed 10:00\n")
            typo = "- [ ] call 2026-10-12 Mon 10:00 or 2026-10-14 Mon 10:00\n"
            self.assertEqual(self.td("stamp", "--col", "45", stdin=typo),
                             "- [ ] call 2026-10-12 Mon 10:00 or 2026-10-14 Wed 10:00\n")

        def test_crlf_line_ends_stay(self):
            self.assertEqual(self.shift("+1", "- [ ] rent 2026-10-20 Tue 09:30\r\n"),
                             "- [ ] rent 2026-10-21 Wed 09:30\r\n")
            self.assertEqual(self.td("stamp", stdin="- [ ] call jon\r\n"),
                             "- [ ] call jon 2026-10-10 Sat 11:00\r\n")
            self.assertEqual(self.td("new", "-", stdin="- [ ] call jon\r\n"),
                             "- [ ] call jon\r\n- [ ] \r\n")
            self.assertEqual(self.td("new", "-", "--above", stdin="- [ ] call jon\r\n"),
                             "- [ ] \r\n- [ ] call jon\r\n")
            self.assertEqual(self.td("new", "-", stdin="- [ ] \r\n"), "- [ ] \r\n")

        def test_shift_minutes_land_on_five(self):
            line = "call 2026-10-20 Tue 09:32"
            self.assertEqual(self.shift("+1", line, 24), "call 2026-10-20 Tue 09:35")
            self.assertEqual(self.shift("-1", line, 24), "call 2026-10-20 Tue 09:30")

        def test_shift_hour_rolls_over_day(self):
            out = self.shift("+1", "call 2026-10-20 Tue 23:30", 21)
            self.assertEqual(out, "call 2026-10-21 Wed 00:30")

        def test_shift_month_clamps_end(self):
            out = self.shift("+1", "pay 2026-01-31 Sat 09:00", 10)
            self.assertEqual(out, "pay 2026-02-28 Sat 09:00")

        def test_shift_fills_weekday_and_keeps_cursor_on_part(self):
            # No weekday, 1-digit hour: the stamp grows, the cursor follows
            out = self.shift("+1", "call 2026-10-20 9:30 now", 17)  # on the "9"
            self.assertEqual(out, "call 2026-10-20 Tue 10:30 now")
            self.assertEqual(self.read_cache("stamp-col"), "22\n")
            out = self.shift("+1", "call 2026-10-20 9:30 now", 23)  # on "now"
            self.assertEqual(self.read_cache("stamp-col"), "28\n")

        def test_shift_keeps_repeater_and_tl_time(self):
            # Off both, on the note: the reminder's day moves, not the entry's.
            line = "2026-10-08 19:16 - did it 2026-10-20 09:00 ++1w"
            self.assertEqual(self.shift("+1", line, 21),
                             "2026-10-08 19:16 - did it 2026-10-21 Wed 09:00 ++1w")
            # On the entry's head: the entry moves, the reminder stays.
            self.assertEqual(self.shift("+1", line, 3),
                             "2027-10-08 19:16 - did it 2026-10-20 09:00 ++1w")

        def test_shift_log_entry_by_cursor_part(self):
            line = "2026-10-13 09:30 - 10:45 = 1h 15min  fixed the parser\n"
            # date 1-10, start hour 12-14 (the colon counts), minutes 15-16, end 20-24
            cases = {(3, "+1"): "2027-10-13 09:30 - 10:45 = 1h 15min",
                     (6, "+1"): "2026-11-13 09:30 - 10:45 = 1h 15min",
                     (9, "-1"): "2026-10-12 09:30 - 10:45 = 1h 15min",
                     (12, "+1"): "2026-10-13 10:30 - 10:45 = 0h 15min",
                     (15, "+1"): "2026-10-13 09:35 - 10:45 = 1h 10min",
                     (16, "-1"): "2026-10-13 09:25 - 10:45 = 1h 20min",
                     (20, "+1"): "2026-10-13 09:30 - 11:45 = 2h 15min",
                     (24, "-1"): "2026-10-13 09:30 - 10:40 = 1h 10min",
                     (40, "+1"): "2026-10-14 09:30 - 10:45 = 1h 15min"}  # on the note: the day
            for (col, n), head in cases.items():
                with self.subTest(col=col, n=n):
                    self.assertEqual(self.shift(n, line, col), head + "  fixed the parser\n")
                    self.assertEqual(self.read_cache("stamp-col"), f"{col}\n")
            self.assertEqual(self.shift("+1", line), "2026-10-14" + line[10:])  # no --col: the day

        def test_shift_log_entry_shapes(self):
            # Running; a bullet; no duration (none is added); a 1-digit hour, which the
            # cursor follows; an en dash, kept.
            self.assertEqual(self.shift("+1", "2026-10-13 09:30 -", 12), "2026-10-13 10:30 -")
            self.assertEqual(self.shift("+1", "- [ ] 2026-10-13 09:30 - 10:45", 18),
                             "- [ ] 2026-10-13 10:30 - 10:45")
            self.assertEqual(self.shift("+1", "2026-10-13 9:05 – 10:00 note", 12),
                             "2026-10-13 10:05 – 10:00 note")
            self.assertEqual(self.read_cache("stamp-col"), "13\n")

        def test_shift_log_entry_across_midnight(self):
            # The start takes the date with it; the end is a clock time.
            self.assertEqual(self.shift("-1", "2026-10-14 00:30 - 01:00 = 0h 30min", 12),
                             "2026-10-13 23:30 - 01:00 = 1h 30min")
            self.assertEqual(self.shift("+1", "2026-10-13 23:30 - 23:50 = 0h 20min", 20),
                             "2026-10-13 23:30 - 00:50 = 1h 20min")

        def test_shifted_log_entry_stays_a_log_entry(self):
            # Still tl's shape (no weekday added), so it never becomes a reminder,
            # even moved into the future.
            out = self.shift("+1", "2026-10-10 10:00 - 10:30 = 0h 30min  note\n", 9)
            self.assertEqual(out, "2026-10-11 10:00 - 10:30 = 0h 30min  note\n")
            self.assertIsNotNone(_tl().parse(out.strip())[0])
            self.put_dedicated("log.md", "# log\n" + out)
            self.td("tick")
            self.assertNotIn("would fire", self.td("tick", now_="2026-10-11 10:05"))

        def test_shift_no_stamp_or_bad_date_unchanged(self):
            for line in ("- [ ] plain\n", "x 2026-02-30 09:00"):
                self.assertEqual(self.shift("+1", line, 3), line)

        def test_note_after_time_is_restamped(self):
            out = self.td("stamp",
                          stdin="- [ ] call bank 2025-12-25 10:00 - bring docs")
            self.assertEqual(out, "- [ ] call bank 2026-10-10 Sat 10:00 - bring docs")

    class Next(Case):
        def test_soonest_future(self):
            self.put_dedicated("a.md", "# a\n2026-10-10 15:00\n")
            self.put_dedicated("b.md", "# b\n2026-10-10 12:00\n")
            self.put_dedicated("c.md", "# c\n2026-10-09 09:00\n")
            out = self.td("next").strip()
            self.assertTrue(out.startswith("2026-10-10 12:00"))
            self.assertIn("b", out)

        def test_none(self):
            self.put_inbox("- [ ] no stamp\n")
            self.assertEqual(self.td("next").strip(), "")

    class Promote(Case):
        def test_creates_dedicated_file(self):
            inbox = self.put_inbox("- [ ] alpha\n- [ ] Costco run!\n")
            out = self.td("promote", "--from", f"{inbox}:2", stdin="- [ ] Costco run!\n")
            p = self.tasks / "costco-run.md"
            # Where P goes: printed, and in ~/.cache/td/open for the key.
            self.assertEqual(out, f"{p}\n")
            self.assertEqual(self.read_cache("open"), f"{p}\n")
            self.assertEqual(p.read_text(), "# [ ] Costco run!\n\n")

        def test_uses_the_piped_line_not_the_file(self):
            # The key pipes the buffer's line: a bullet not saved yet counts.
            inbox = self.put_inbox("- [ ] old text\n")
            out = self.td("promote", "--from", f"{inbox}:1", stdin="- [ ] new text\n")
            self.assertEqual(out.strip(), str(self.tasks / "new-text.md"))
            self.assertFalse((self.tasks / "old-text.md").exists())

        def test_non_bullet_stays(self):
            inbox = self.put_inbox("# notes\n")
            out = self.td("promote", "--from", f"{inbox}:1", stdin="# notes\n")
            self.assertEqual(out.strip(), f"{inbox}:1")
            self.assertEqual(sorted(p.name for p in self.tasks.iterdir()), ["todo.md"])

        def test_promote_active_bullet_h1_has_state(self):
            self.td("promote", stdin="- [A] foo bar\n")
            self.assertIn("# [A] foo bar", (self.tasks / "foo-bar.md").read_text())

        def test_promote_existing_file_h1_gets_retagged(self):
            p = self.put_dedicated("foo-bar.md", "# foo bar\n\nnotes\n")
            self.td("promote", stdin="- [A] foo bar\n")
            self.assertIn("# [A] foo bar", p.read_text())
            self.assertIn("notes", p.read_text())  # body preserved

        def test_reuses_existing(self):
            existing = self.put_dedicated(
                "costco-run.md", "# Costco run!\n2026-10-10 09:00\n\nnotes\n")
            self.td("promote", stdin="- [ ] costCo RUN\n")
            self.assertIn("notes", existing.read_text())

        def test_indented_bullet(self):
            self.td("promote", stdin="  - [A] refactor TD parser\n")
            self.assertEqual((self.tasks / "refactor-td-parser.md").read_text(),
                             "# [A] refactor TD parser\n\n")

        def test_heading_leaves_out_an_old_link(self):
            self.td("promote", stdin="- [Y] Pay rent → ~/tasks/pay-rent.md\n")
            self.assertEqual((self.tasks / "pay-rent.md").read_text(), "# [Y] Pay rent\n\n")

        def test_promote_stamped_bullet_uses_unstamped_slug(self):
            self.td("promote",
                    stdin="- [A] refactor td parser 2026-10-12 Sun 09:00\n")
            self.assertTrue((self.tasks / "refactor-td-parser.md").is_file())
            dated = "refactor-td-parser-2026-10-12-sun-09-00.md"
            self.assertFalse((self.tasks / dated).exists())
            self.td("promote",
                    stdin="- [ ] pay rent 2026-11-01 Sat 09:00 ++1m\n")
            self.assertTrue((self.tasks / "pay-rent.md").is_file())

        def test_heading_leaves_out_the_stamp(self):
            # The stamp stays the bullet's: in the heading it would fire twice.
            self.td("promote", stdin="- [ ] pay rent 2026-11-01 Sun 09:00 ++1m #home\n")
            self.assertEqual((self.tasks / "pay-rent-home.md").read_text(), "# [ ] pay rent #home\n\n")

    class Marker(Case):
        def test_bullet_with_dedicated_file_gets_marker(self):
            self.put_inbox("- [A] refactor td parser\n- [ ] call jon\n")
            self.put_dedicated("refactor-td-parser.md", "# refactor td parser\n")
            out = self.td("list")
            self.assertIn("- [A] refactor td parser (*)", out)
            self.assertIn("- [ ] call jon", out)
            self.assertNotIn("call jon (*)", out)

        def test_orphans_section(self):
            self.put_inbox("- [A] refactor td parser\n")
            self.put_dedicated("refactor-td-parser.md", "# refactor td parser\n")
            self.put_dedicated("costco-run.md", "# Costco run!\n")
            out = self.td("list")
            self.assertIn("# ORPHANS", out)
            self.assertIn("costco-run", out)
            self.assertNotIn("- refactor-td-parser", out)

        def test_no_orphans_section_when_empty(self):
            self.put_inbox("- [ ] alpha\n")
            out = self.td("list")
            self.assertNotIn("# ORPHANS", out)

        def test_stamped_bullet_still_marks_dedicated_file(self):
            self.put_inbox(
                "- [A] refactor td parser 2026-10-12 Sun 09:00 ++1w\n")
            self.put_dedicated("refactor-td-parser.md", "# refactor td parser\n")
            out = self.td("list")
            self.assertIn(
                "- [A] refactor td parser 2026-10-12 Sun 09:00 ++1w (*)", out)
            self.assertNotIn("# ORPHANS", out)

    class Jump(Case):
        def go(self, cmd, path, lineno):
            """Run `td jump`/`td promote` the way p/P do: the line piped in."""
            line = Path(path).read_text().splitlines(keepends=True)[lineno - 1]
            out = self.td(cmd, "--from", f"{path}:{lineno}", stdin=line)
            self.assertEqual(self.read_cache("open"), out)
            return out.strip()

        def agenda_line(self, text):
            agenda = self.cache / "agenda.md"
            lines = agenda.read_text().splitlines()
            return agenda, next(i for i, line in enumerate(lines, 1) if text in line)

        def test_jumps_to_dedicated_when_exists(self):
            inbox = self.put_inbox("- [A] refactor td parser\n")
            target = self.put_dedicated("refactor-td-parser.md",
                                        "# refactor td parser\n")
            self.assertEqual(self.go("jump", inbox, 1), str(target))

        def test_fallback_when_missing(self):
            inbox = self.put_inbox("- [ ] call jon\n")
            self.assertEqual(self.go("jump", inbox, 1), f"{inbox}:1")

        def test_uses_the_piped_line_not_the_file(self):
            inbox = self.put_inbox("- [ ] alpha\n")
            target = self.put_dedicated("bravo.md", "# bravo\n")
            out = self.td("jump", "--from", f"{inbox}:1", stdin="- [ ] bravo\n")
            self.assertEqual(out.strip(), str(target))

        def test_jump_ignores_stamp(self):
            inbox = self.put_inbox(
                "- [A] refactor td parser 2026-10-12 Sun 09:00 ++1w\n")
            target = self.put_dedicated("refactor-td-parser.md",
                                        "# refactor td parser\n")
            self.assertEqual(self.go("jump", inbox, 1), str(target))

        def test_fallback_on_non_bullet(self):
            inbox = self.put_inbox("just a note\n")
            self.assertEqual(self.go("jump", inbox, 1), f"{inbox}:1")

        def test_jump_from_agenda_row(self):
            inbox = self.put_inbox("- [A] refactor td parser\n")
            target = self.put_dedicated("refactor-td-parser.md",
                                        "# refactor td parser\n")
            # `space , a`, then `space , p` / `space , P` on the row.
            self.td("list")
            agenda, lineno = self.agenda_line("- [A] refactor td parser")
            # p: the todo.md line, even with a dedicated file; P: the file
            self.assertEqual(self.go("jump", agenda, lineno), f"{inbox}:1")
            self.assertEqual(self.go("promote", agenda, lineno), str(target))

        def test_promote_from_agenda_row_without_file_stays(self):
            self.put_inbox("- [ ] alpha\n")
            self.td("list")
            agenda, lineno = self.agenda_line("- [ ] alpha")
            self.assertEqual(self.go("promote", agenda, lineno), f"{agenda}:{lineno}")
            self.assertFalse((self.tasks / "alpha.md").exists())

        def test_jump_from_agenda_row_to_inbox_line(self):
            inbox = self.put_inbox("- [ ] alpha\n- [Y] call jon 2026-10-12 09:00\n")
            self.td("list")
            agenda, lineno = self.agenda_line("call jon")
            self.assertEqual(self.go("jump", agenda, lineno), f"{inbox}:2")

        def test_jump_from_stale_agenda_row_stays(self):
            self.put_inbox("- [ ] alpha\n")
            self.td("list")
            self.put_inbox("- [ ] bravo\n")
            agenda, lineno = self.agenda_line("alpha")
            self.assertEqual(self.go("jump", agenda, lineno), f"{agenda}:{lineno}")

        def test_jump_from_orphan_row(self):
            self.put_inbox("- [ ] alpha\n")
            orphan = self.put_dedicated("costco-run.md", "# Costco run!\n")
            self.td("list")
            agenda, lineno = self.agenda_line("costco-run")
            self.assertEqual(self.go("jump", agenda, lineno), str(orphan))

        def test_jump_from_file_task_row(self):
            self.put_inbox("- [ ] alpha\n")
            d = self.put_dedicated("passport.md", "# [W] renew passport\n")
            self.td("list")
            agenda, lineno = self.agenda_line("renew passport")
            for cmd in ("jump", "promote"):
                self.assertEqual(self.go(cmd, agenda, lineno), str(d), cmd)

    class SetToggle(Case):
        def test_set_rewrites_checkbox(self):
            p = self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            self.td("set", str(p), "2", "Y")
            self.assertEqual(p.read_text(), "- [ ] alpha\n- [Y] bravo\n")

        def test_set_bad_state(self):
            self.put_inbox("- [ ] alpha\n")
            with self.assertRaises(sp.CalledProcessError):
                self.td("set", str(self.inbox), "1", "z")

        def test_toggle_in_place_set(self):
            out = self.td("toggle", "Y", stdin="- [ ] alpha\n")
            self.assertEqual(out.strip(), "- [Y] alpha")

        def test_toggle_in_place_unset(self):
            out = self.td("toggle", "Y", stdin="- [Y] alpha\n")
            self.assertEqual(out.strip(), "- [ ] alpha")

        def piped(self, state, from_path, line):
            """Run td the way the Helix :pipe bindings do -> CompletedProcess."""
            e = {**os.environ, "HOME": str(self.home), "TL_DIR": str(self.tasks),
                 "TL_NOW": NOW, "TD_DRY_RUN": "1"}
            return sp.run([sys.executable, TD, "toggle", state, "--from",
                           str(from_path)], env=e, capture_output=True,
                          input=line.encode("utf-8"))

        def test_piped_keeps_newline(self):
            p = self.put_inbox("- [ ] alpha\n")
            r = self.piped("x", p, "- [ ] alpha\n")
            self.assertEqual(r.stdout, b"- [x] alpha\n")
            r = self.piped("x", p, "just a note\n")
            self.assertEqual(r.stdout, b"just a note\n")

        def test_agenda_rows_dont_change(self):
            # The agenda is a view: +/-, space , s and P leave a row and the
            # task alone (status keys change the task: AgendaToggle).
            p = self.put_inbox("- [ ] alpha 2026-10-20 Tue 09:00\n")
            self.put_dedicated("alpha.md", "# [ ] alpha\n")
            self.td("list")
            agenda = self.home / ".cache" / "td" / "agenda.md"
            self.assertEqual(agenda.stat().st_mode & 0o777, 0o444)
            before = agenda.read_text()
            row = "- [ ] alpha 2026-10-20 Tue 09:00 (*)\n"
            lineno = before.splitlines().index(row.strip()) + 1
            # +/- give the row back with one edit, which the keys undo (see _changed).
            out = self.td("shift", "+1", "--col", "20", "--from", str(agenda), stdin=row)
            self.assertEqual(out, row[:-1] + " \n")
            self.assertEqual(self.td("stamp", "--col", "3", "--from", str(agenda), stdin=row), row)
            self.td("promote", "--from", f"{agenda}:{lineno}", stdin=row)
            self.assertEqual(p.read_text(), "- [ ] alpha 2026-10-20 Tue 09:00\n")
            self.assertEqual((self.tasks / "alpha.md").read_text(), "# [ ] alpha\n")
            self.assertEqual(agenda.read_text(), before)

        def test_waiting_state(self):
            p = self.put_inbox("- [w] reply from bank\n- [ ] alpha\n")
            out = self.td("list")
            self.assertIn("# TODO\n\n- [ ] alpha\n\n# WAITING\n\n- [W] reply from bank", out)
            self.assertIn("[W] waiting", out)
            self.assertNotIn("alpha", self.td("list", "--state", "waiting"))
            self.assertEqual(self.td("new", "--state", "waiting"), "- [W] ")
            for name, want in (("waiting", "- [W] alpha\n"), ("W", "- [W] alpha\n"),
                               ("w", "- [W] alpha\n")):
                self.assertEqual(self.td("toggle", name, stdin="- [ ] alpha\n"), want, name)
            self.assertEqual(self.td("toggle", "waiting", stdin="- [w] alpha\n"),
                             "- [ ] alpha\n")

        def test_toggle_todo_by_name_sets_todo(self):
            for line in ("- [A] alpha\n", "- [ ] alpha\n", "- [x] alpha\n"):
                self.assertEqual(self.td("toggle", "todo", stdin=line), "- [ ] alpha\n")
            d = self.put_dedicated("passport.md", "# [W] passport\n")
            out = self.td("toggle", "todo", "--from", str(d), stdin="# [W] passport\n")
            self.assertEqual(out, "# [ ] passport\n")

        def test_file_tasks_listed_by_state(self):
            self.put_inbox("- [ ] alpha\n- [A] tracked\n")
            self.put_dedicated("passport.md", "# [W] renew passport\n\nnotes\n")
            self.put_dedicated("garden.md", "# [ ] garden plan\n")
            self.put_dedicated("move.md", "# [a] house move\n")
            self.put_dedicated("old.md", "# [x] old thing\n")
            self.put_dedicated("ignored.md", "# [!] ignored thing\n")
            self.put_dedicated("tracked.md", "# [A] tracked\n")
            self.put_dedicated("day.md", "# Today\n- [ ] read\n")
            self.put_dedicated("late.md", "notes first\n# [W] heading on line 2\n")
            out = self.td("list")
            passport = f"- [W] renew passport  ~/tasks/passport.md:1:1"
            self.assertIn(f"# WAITING\n\n{passport}", out)
            self.assertIn(f"- [ ] garden plan  ~/tasks/garden.md:1:1", out)
            self.assertIn(f"# ACTIVE\n\n", out)
            self.assertIn(f"- [A] house move  ~/tasks/move.md:1:1", out)
            # Done/ignored files are hidden, and not orphans either.
            self.assertNotIn("old", out)
            self.assertNotIn("ignored", out)
            # A file with a bullet shows once, as the bullet.
            self.assertEqual(out.count("tracked"), 1)
            self.assertIn("- [A] tracked (*)", out)
            orphans = out.split("# ORPHANS")[1]
            self.assertIn("- day  ", orphans)
            self.assertIn("- late  ", orphans)
            self.assertNotIn("passport", orphans)
            self.td("list", "--sort", "modified")  # file tasks sort too

        def test_agenda_rebuild_replaces_read_only_file(self):
            self.put_inbox("- [ ] alpha\n")
            self.td("list")
            self.put_inbox("- [ ] bravo\n")
            self.td("list")
            agenda = self.home / ".cache" / "td" / "agenda.md"
            self.assertIn("bravo", agenda.read_text())
            self.assertIn("VIEW ONLY", agenda.read_text())
            self.assertEqual(agenda.stat().st_mode & 0o777, 0o444)

        def test_heading_toggle_sets_inbox(self):
            p = self.put_inbox("- [ ] note\n- [Y] refactor td parser\n")
            d = self.put_dedicated("refactor-td-parser.md", "# [Y] refactor parser\n")
            # The file names the bullet, so an edited heading title still works.
            heading = "# [Y] refactor parser\n"
            for state, want, inbox_state in (("A", "# [A] refactor parser", "A"),
                                             ("A", "# [ ] refactor parser", " "),
                                             ("x", "# [x] refactor parser", "x")):
                heading = self.td("toggle", state, "--from", str(d), stdin=heading)
                self.assertEqual(heading, want + "\n", state)
                self.assertEqual(p.read_text(),
                                 f"- [ ] note\n- [{inbox_state}] refactor td parser\n")
            self.assertNotIn("refactor", self.read_cache("agenda.md").split("# ORPHANS")[0])

        def test_heading_toggle_prefers_the_open_bullet(self):
            # An old done `call mom` above a new one: the new one changes.
            p = self.put_inbox("- [x] call mom\n- [ ] call mom\n")
            d = self.put_dedicated("call-mom.md", "# [ ] call mom\n")
            out = self.td("toggle", "Y", "--from", str(d), stdin="# [ ] call mom\n")
            self.assertEqual(out, "# [Y] call mom\n")
            self.assertEqual(p.read_text(), "- [x] call mom\n- [Y] call mom\n")
            # With no open copy, the first one changes.
            p.write_text("- [x] call mom\n- [!] call mom\n")
            self.td("toggle", "todo", "--from", str(d), stdin="# [x] call mom\n")
            self.assertEqual(p.read_text(), "- [ ] call mom\n- [!] call mom\n")

        def test_heading_without_state_and_line_mode(self):
            p = self.put_inbox("- [ ] alpha\n")
            d = self.put_dedicated("alpha.md", "# alpha\n\nnotes\n")
            self.td("toggle", "Y", "--from", str(d), "--line", "1")
            self.assertEqual(d.read_text(), "# [Y] alpha\n\nnotes\n")
            self.assertEqual(p.read_text(), "- [Y] alpha\n")

        def test_heading_done_bumps_repeating_inbox_bullet(self):
            p = self.put_inbox("- [A] rent 2026-10-01 Thu 09:00 ++1m\n")
            d = self.put_dedicated("rent.md", "# [A] rent\n")
            out = self.td("toggle", "x", "--from", str(d), stdin="# [A] rent\n")
            self.assertEqual(out, "# [ ] rent\n")
            self.assertEqual(p.read_text(), "- [ ] rent 2026-11-01 Sun 09:00 ++1m\n")

        def test_heading_of_orphan_toggles_alone(self):
            p = self.put_inbox("- [ ] alpha\n")
            d = self.put_dedicated("old.md", "# [ ] old\n")
            out = self.td("toggle", "x", "--from", str(d), stdin="# [ ] old\n")
            self.assertEqual(out, "# [x] old\n")
            self.assertEqual(p.read_text(), "- [ ] alpha\n")

        def test_heading_outside_task_folder_is_text(self):
            other = self.home / "notes.md"
            other.write_text("# [ ] alpha\n")
            self.put_inbox("- [ ] alpha\n")
            out = self.td("toggle", "x", "--from", str(other), stdin="# [ ] alpha\n")
            self.assertEqual(out, "# [ ] alpha\n")

        def test_own_bullet_in_dedicated_file_sets_inbox_whatever_its_state(self):
            # Used to need the same state on both sides: the heading changed,
            # todo.md did not.
            p = self.put_inbox("- [A] refactor td parser\n")
            d = self.put_dedicated("refactor-td-parser.md",
                                   "# [A] refactor td parser\n- [ ] refactor td parser\n")
            out = self.td("toggle", "x", "--from", str(d), stdin="- [ ] refactor td parser\n")
            self.assertEqual(out, "- [x] refactor td parser\n")
            self.assertEqual(p.read_text(), "- [x] refactor td parser\n")
            # Its own heading is in the buffer Helix is saving: not written on disk.
            self.assertEqual(d.read_text(),
                             "# [A] refactor td parser\n- [ ] refactor td parser\n")

        def test_subtask_changes_only_its_line(self):
            p = self.put_inbox("- [A] refactor td parser\n")
            d = self.put_dedicated("refactor-td-parser.md", "# [A] refactor td parser\n")
            out = self.td("toggle", "x", "--from", str(d), stdin="  - [ ] write tests\n")
            self.assertEqual(out, "  - [x] write tests\n")
            self.assertEqual(p.read_text(), "- [A] refactor td parser\n")

        def test_checklist_outside_the_task_folder_changes_alone(self):
            p = self.put_inbox("- [ ] alpha\n")
            d = self.put_dedicated("alpha.md", "# [ ] alpha\n")
            readme = self.home / "proj" / "README.md"
            readme.parent.mkdir()
            readme.write_text("- [ ] alpha\n")
            self.assertEqual(self.piped("x", readme, "- [ ] alpha\n").stdout, b"- [x] alpha\n")
            self.td("toggle", "x", "--from", str(readme), "--line", "1")
            self.assertEqual(readme.read_text(), "- [x] alpha\n")
            self.assertEqual(p.read_text(), "- [ ] alpha\n")
            self.assertEqual(d.read_text(), "# [ ] alpha\n")
            self.assertEqual(self.td("toggle", "x", stdin="- [ ] alpha\n"), "- [x] alpha\n")
            self.assertEqual(p.read_text(), "- [ ] alpha\n")

        def test_crlf_files_keep_their_line_ends(self):
            p = self.put_inbox("- [ ] alpha\r\n- [ ] bravo\r\n")
            d = self.put_dedicated("bravo.md", "# [ ] bravo\r\n\r\nnotes\r\n")
            self.td("toggle", "x", "--from", str(p), "--line", "2")
            self.assertEqual(p.read_bytes(), b"- [ ] alpha\r\n- [x] bravo\r\n")
            self.assertEqual(d.read_bytes(), b"# [x] bravo\r\n\r\nnotes\r\n")
            out = self.piped("A", d, "# [x] bravo\r\n").stdout
            self.assertEqual(out, b"# [A] bravo\r\n")
            self.assertEqual(p.read_bytes(), b"- [ ] alpha\r\n- [A] bravo\r\n")

        def test_piped_duplicate_is_silent(self):
            p = self.put_inbox("- [ ] alpha\n- [ ] alpha\n")
            d = self.put_dedicated("notes.md", "# notes\n")
            r = self.piped("x", d, "- [ ] alpha\n")
            self.assertEqual((r.stdout, r.stderr), (b"- [x] alpha\n", b""))
            self.assertEqual(p.read_text(), "- [x] alpha\n- [ ] alpha\n")

        def test_lowercase_states_still_read(self):
            p = self.put_inbox("- [y] alpha\n- [a] bravo\n")
            out = self.td("list")
            self.assertIn("# TODAY\n\n- [Y] alpha", out)
            self.assertIn("# ACTIVE\n\n- [A] bravo", out)
            self.td("toggle", "y", "--from", str(p), "--line", "1")
            self.assertEqual(p.read_text(), "- [ ] alpha\n- [a] bravo\n")
            out = self.td("toggle", "A", stdin="- [a] bravo\n")
            self.assertEqual(out.strip(), "- [ ] bravo")

        def test_toggle_from_inbox_no_double_write(self):
            p = self.put_inbox("- [ ] alpha\n")
            # Caller is TD_FILE itself: td toggle must NOT also mutate disk.
            out = self.td("toggle", "Y", "--from", str(p),
                          stdin="- [ ] alpha\n")
            self.assertEqual(out.strip(), "- [Y] alpha")
            # Disk still has old state — Helix will :write it with the new state.
            self.assertEqual(p.read_text(), "- [ ] alpha\n")

        def test_toggle_retags_dedicated_h1(self):
            p = self.put_inbox("- [ ] foo bar\n")
            dedicated = self.put_dedicated("foo-bar.md",
                                           "# [ ] foo bar\n\nnotes\n")
            other = self.put_dedicated("notes.md", "# notes\n- [ ] foo bar\n")
            self.td("toggle", "A", "--from", str(other), "--line", "2")
            self.assertEqual(p.read_text(), "- [A] foo bar\n")
            self.assertEqual(dedicated.read_text(), "# [A] foo bar\n\nnotes\n")

        def test_toggle_retags_h1_from_inbox_too(self):
            inbox = self.put_inbox("- [ ] foo bar\n")
            dedicated = self.put_dedicated("foo-bar.md", "# [ ] foo bar\n")
            self.td("toggle", "A", "--from", str(inbox),
                    stdin="- [ ] foo bar\n")
            self.assertIn("# [A] foo bar", dedicated.read_text())

    class AgendaToggle(Case):
        """A status key on an agenda row changes the task where it lives
        (todo.md, or a file task's heading) and rebuilds the agenda."""

        def toggle_row(self, state, text, *args):
            agenda = self.cache / "agenda.md"
            row = next(line for line in agenda.read_text().splitlines(keepends=True)
                       if text in line)
            out = self.td("toggle", state, "--from", str(agenda), *args, stdin=row)
            self.assertEqual(out, row[:-1] + " \n")  # one edit, which the keys undo
            return self.read_cache("agenda.md")

        def test_empty_line_still_makes_an_edit(self):
            # On the agenda's last, empty line the pipe gets "": giving "" back would make no
            # edit, and the keys' :earlier 1 would undo the agenda's last reload instead.
            self.put_inbox("- [ ] alpha\n")
            self.td("list")
            agenda = str(self.cache / "agenda.md")
            self.assertEqual(self.td("toggle", "Y", "--from", agenda, stdin=""), " ")
            self.assertEqual(self.td("shift", "+1", "--from", agenda, stdin=""), " ")

        def test_bullet_row_sets_todo_md(self):
            p = self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            self.td("list")
            agenda = self.toggle_row("Y", "bravo")
            self.assertEqual(p.read_text(), "- [ ] alpha\n- [Y] bravo\n")
            self.assertIn("# TODAY\n\n- [Y] bravo", agenda)
            agenda = self.toggle_row("Y", "bravo")  # toggles back
            self.assertEqual(p.read_text(), "- [ ] alpha\n- [ ] bravo\n")
            self.assertNotIn("TODAY", agenda)

        def test_done_hides_the_row_and_bumps_a_repeater(self):
            p = self.put_inbox("- [ ] alpha\n- [Y] rent 2026-10-01 Thu 09:00 ++1m\n")
            self.td("list")
            agenda = self.toggle_row("x", "alpha")
            self.assertEqual(p.read_text().splitlines()[0], "- [x] alpha")
            self.assertNotIn("alpha", agenda)
            self.toggle_row("x", "rent")
            self.assertEqual(p.read_text().splitlines()[1], "- [ ] rent 2026-11-01 Sun 09:00 ++1m")

        def test_row_with_a_file_retags_its_heading(self):
            p = self.put_inbox("- [ ] refactor td parser\n")
            d = self.put_dedicated("refactor-td-parser.md", "# [ ] refactor td parser\n\nnotes\n")
            self.td("list")
            self.toggle_row("A", "refactor td parser (*)")
            self.assertEqual(p.read_text(), "- [A] refactor td parser\n")
            self.assertEqual(d.read_text(), "# [A] refactor td parser\n\nnotes\n")

        def test_file_task_row_sets_its_heading(self):
            self.put_inbox("- [ ] alpha\n")
            d = self.put_dedicated("passport.md", "# [W] renew passport\r\n\r\nnotes\r\n")
            self.td("list")
            agenda = self.toggle_row("A", "renew passport")
            self.assertEqual(d.read_bytes(), b"# [A] renew passport\r\n\r\nnotes\r\n")
            self.assertIn("# ACTIVE\n\n- [A] renew passport  ~/tasks/passport.md:1:1", agenda)
            self.assertEqual(self.inbox.read_text(), "- [ ] alpha\n")

        def test_repeating_file_task_row_moves_its_date(self):
            # A file task (no todo.md bullet) repeats by its own date: done moves it and the
            # task stays open, on any line but a subtask's.
            d = self.put_dedicated("haircut.md", "# [ ] haircut\r\n2026-12-15 Tue 11:50 ++2m\r\n\r\n"
                                                 "- [ ] book 2026-12-01 Tue 09:00 ++1m\r\n")
            self.td("list")
            agenda = self.toggle_row("x", "haircut")
            self.assertEqual(d.read_bytes(), b"# [ ] haircut\r\n2027-02-15 Mon 11:50 ++2m\r\n\r\n"
                                             b"- [ ] book 2026-12-01 Tue 09:00 ++1m\r\n")
            self.assertIn("- [ ] haircut  ~/tasks/haircut.md:1:1", agenda)
            # The date on the heading line moves the same way.
            d = self.put_dedicated("rent.md", "# [Y] rent 2026-10-01 Thu 09:00 ++1m\n")
            self.td("list")
            self.toggle_row("x", "rent")
            self.assertEqual(d.read_text(), "# [ ] rent 2026-11-01 Sun 09:00 ++1m\n")

        def test_stale_or_other_rows_change_nothing(self):
            p = self.put_inbox("- [ ] alpha\n")
            self.put_dedicated("old.md", "# old\n")
            self.td("list")
            p.write_text("- [ ] alpha renamed\n")
            agenda = self.toggle_row("Y", "- [ ] alpha")  # stale: no such bullet now
            self.assertEqual(p.read_text(), "- [ ] alpha renamed\n")
            self.assertIn("- [ ] alpha renamed", agenda)  # but the agenda is rebuilt
            self.toggle_row("Y", "- old")  # an orphan has no state
            self.toggle_row("Y", "VIEW ONLY")
            self.assertEqual(p.read_text(), "- [ ] alpha renamed\n")
            self.assertEqual((self.tasks / "old.md").read_text(), "# old\n")

        def test_line_mode(self):
            p = self.put_inbox("- [ ] alpha\n")
            self.td("list")
            agenda = self.cache / "agenda.md"
            lineno = agenda.read_text().splitlines().index("- [ ] alpha") + 1
            self.td("toggle", "W", "--from", str(agenda), "--line", str(lineno))
            self.assertEqual(p.read_text(), "- [W] alpha\n")
            self.assertIn("# WAITING\n\n- [W] alpha", agenda.read_text())

        def test_rebuild_keeps_the_views_order(self):
            p = self.put_inbox("- [ ] alpha\n")
            self.td("list", now_="2026-10-10 11:00")
            self.put_inbox("- [ ] alpha\n- [ ] bravo\n- [ ] charlie\n")
            self.td("list", now_="2026-10-10 11:05")
            self.put_inbox("- [ ] alpha 2026-10-12 Mon 09:00\n- [ ] bravo\n- [ ] charlie\n")
            out = self.td("list", "--sort", "modified", now_="2026-10-10 11:10")
            self.assertLess(out.index("alpha"), out.index("bravo"))
            # space , A's order survives the rebuild after a change.
            agenda = self.toggle_row("A", "charlie")
            self.assertLess(agenda.index("alpha"), agenda.index("bravo"))
            self.td("list")  # space , a: back to newest added first
            agenda = self.toggle_row("A", "charlie")
            self.assertLess(agenda.index("bravo"), agenda.index("alpha"))

        def test_done_view_row_back_to_todo(self):
            p = self.put_inbox("- [x] alpha\n- [x] bravo\n")
            self.td("list", "--state", "done", "--sort", "modified")
            agenda = self.toggle_row("x", "alpha")  # space , x undoes it
            self.assertEqual(p.read_text(), "- [ ] alpha\n- [x] bravo\n")
            self.assertIn("# DONE\n\n- [x] bravo\n", agenda)
            self.assertNotIn("alpha", agenda)

    class File(Case):
        def test_creates_a_file_task(self):
            self.put_inbox("- [ ] alpha\n")
            out = self.td("file", "Buy a car!")
            path = self.tasks / "buy-a-car.md"
            self.assertEqual(out.strip(), f"{path}:2")
            self.assertEqual(path.read_text(), "# [ ] Buy a car!\n\n")
            self.assertEqual(self.inbox.read_text(), "- [ ] alpha\n")  # todo.md untouched
            self.assertIn("# TODO\n\n- [ ] alpha\n- [ ] Buy a car!  ~/tasks/buy-a-car.md:1:1",
                          self.read_cache("agenda.md"))

        def test_name_from_the_prompt_needs_no_quoting(self):
            import shlex
            name = "it's (part 2) \"q\" $HOME `id` & ; | done"
            line = (f'{shlex.quote(sys.executable)} {shlex.quote(TD)} file '
                    f'"$BASH_EXECUTION_STRING" # name: {name}')
            e = {**os.environ, "HOME": str(self.home), "TL_DIR": str(self.tasks)}
            out = sp.run(["bash", "-c", line], env=e, capture_output=True, check=True).stdout.decode()
            path = self.tasks / "it-s-part-2-q-home-id-done.md"
            self.assertEqual(out.strip(), f"{path}:2")
            self.assertEqual(path.read_text(), f"# [ ] {name}\n\n")

        def test_existing_file_is_left_alone(self):
            path = self.put_dedicated("buy-a-car.md", "# [A] buy a car\n\nnotes\n")
            self.assertEqual(self.td("file", "Buy a CAR").strip(), str(path))
            self.assertEqual(path.read_text(), "# [A] buy a car\n\nnotes\n")

        def test_no_usable_name(self):
            for args in ([], ["!!"], ['"$BASH_EXECUTION_STRING" # name:   ']):
                with self.assertRaises(sp.CalledProcessError, msg=args):
                    self.td("file", *args)
            self.assertEqual(list(self.tasks.iterdir()), [])

    class WeekView(Case):
        def test_plus_minus_step_the_week(self):
            # +/- on tl's week summary view step it; NOW is Saturday 2026-10-10.
            self.put_dedicated("a.md", "# A\n2026-10-01 09:00 - 10:00\n2026-10-06 09:00 - 10:30\n")
            view = Path(self.td_tl("summary", "--week", "--view"))
            weeks = []
            for n in ("-1", "+1", "+1"):
                out = self.td("shift", n, "--col", "3", "--from", str(view), stdin="Time summary\n")
                self.assertEqual(out, "Time summary \n")
                weeks.append(view.read_text().split("\n")[0][19:29])
            self.assertEqual(weeks, ["2026-09-28", "2026-10-05", "2026-10-12"])
            self.assertEqual(self.td("shift", "+1", "--from", str(view), stdin=""), " ")

        def td_tl(self, *args):
            e = {**os.environ, "HOME": str(self.home), "TL_DIR": str(self.tasks), "TL_NOW": NOW}
            tl = str(Path(TD).with_name("tl"))
            return sp.run([sys.executable, tl, *args], env=e, capture_output=True,
                          check=True).stdout.decode()

    class Rename(Case):
        """td rename, as space , N runs it: the row's line in the agenda, then the new name."""

        def rename(self, row_text, name):
            self.td("list")
            agenda = self.cache / "agenda.md"
            lineno = next(i for i, line in enumerate(agenda.read_text().splitlines(), 1)
                          if row_text in line)
            return self.td("rename", "--from", f"{agenda}:{lineno}",
                           f'... "$BASH_EXECUTION_STRING" # name: {name}').strip(), agenda, lineno

        def test_file_task(self):
            self.put_inbox("- [ ] alpha\n")
            old = self.put_dedicated("passport.md", "# [W] renew passport\r\n\r\nnotes\r\n")
            out, agenda, lineno = self.rename("renew passport", "Renew  my passport!")
            self.assertEqual(out, f"{agenda}:{lineno}")
            self.assertFalse(old.exists())
            new = self.tasks / "renew-my-passport.md"
            self.assertEqual(new.read_bytes(), b"# [W] Renew my passport!\r\n\r\nnotes\r\n")
            self.assertIn("- [W] Renew my passport!  ~/tasks/renew-my-passport.md:1:1",
                          self.read_cache("agenda.md"))

        def test_keeps_its_place_in_the_agenda(self):
            self.put_inbox("")
            self.put_dedicated("older.md", "# [ ] older\n")
            self.td("list", now_="2026-10-10 10:00")
            self.put_dedicated("newer.md", "# [ ] newer\n")
            self.td("list", now_="2026-10-10 10:30")
            self.rename("older", "older renamed")
            agenda = self.read_cache("agenda.md")
            self.assertLess(agenda.index("newer"), agenda.index("older renamed"))

        def test_bullet_and_its_file_stay_linked(self):
            p = self.put_inbox("- [ ] alpha\n  - [A] bravo 2026-10-20 Tue 09:00\n")
            d = self.put_dedicated("bravo.md", "# [A] bravo\n\nnotes\n")
            self.rename("bravo", "bravo two 2026-10-20 Tue 09:00")
            self.assertEqual(p.read_text(), "- [ ] alpha\n  - [A] bravo two 2026-10-20 Tue 09:00\n")
            self.assertFalse(d.exists())
            # The stamp stays the bullet's: in the heading it would fire twice.
            self.assertEqual((self.tasks / "bravo-two.md").read_text(),
                             "# [A] bravo two\n\nnotes\n")
            self.assertIn("- [A] bravo two 2026-10-20 Tue 09:00 (*)", self.read_cache("agenda.md"))

        def test_bullet_without_a_file(self):
            p = self.put_inbox("- [ ] alpha\n")
            self.rename("alpha", "alpha one")
            self.assertEqual(p.read_text(), "- [ ] alpha one\n")
            self.assertEqual(sorted(f.name for f in self.tasks.iterdir()), ["todo.md"])

        def test_orphan_gets_a_heading(self):
            self.put_inbox("- [ ] alpha\n")
            self.put_dedicated("old-notes.md", "just notes\n")
            self.rename("- old-notes", "Old notes!")
            self.assertEqual((self.tasks / "old-notes.md").read_text(), "# Old notes!\njust notes\n")

        def test_refused_without_changes(self):
            p = self.put_inbox("- [ ] alpha\n- [ ] bravo\n")
            self.put_dedicated("bravo.md", "# bravo\n")
            task = self.put_dedicated("passport.md", "# [W] renew passport\n")
            for row, name in (("renew passport", "bravo"),  # its file exists
                              ("alpha", "Bravo!"),          # would adopt bravo.md
                              ("renew passport", "!!"),     # no usable name
                              ("VIEW ONLY", "x")):          # not a task
                with self.subTest(row=row, name=name):
                    with self.assertRaises(sp.CalledProcessError):
                        self.rename(row, name)
            self.assertEqual(p.read_text(), "- [ ] alpha\n- [ ] bravo\n")
            self.assertEqual(task.read_text(), "# [W] renew passport\n")
            with self.assertRaises(sp.CalledProcessError):  # not the agenda
                self.td("rename", "--from", f"{p}:1", "x")

        def test_promote_checks_the_name_too(self):
            self.td("promote", stdin="- [ ] !!\n")
            self.assertEqual(list(self.tasks.iterdir()), [])

    class Fire(Case):
        def test_fire_by_file(self):
            p = self.put_dedicated("ping.md", "# ping\n2026-10-10 09:00\n")
            out = self.td("fire", str(p))
            self.assertIn("would fire", out)
            self.assertIn("ping", out)

        def test_tap_action_quotes_the_path(self):
            # termux-notification runs --action with sh -c.
            bin_dir = self.home / "bin"
            bin_dir.mkdir()
            fake = bin_dir / "termux-notification"
            fake.write_text(f"#!{sys.executable}\nimport json, sys\n"
                            f"open({str(self.home / 'args')!r}, 'w').write(json.dumps(sys.argv[1:]))\n")
            fake.chmod(0o755)
            p = self.put_dedicated("it's here.md", "# here\n2026-10-10 09:00\n")
            self.td("fire", str(p), TD_DRY_RUN=None, PATH=f"{bin_dir}{os.pathsep}{os.environ['PATH']}")
            args = json.loads((self.home / "args").read_text())
            action = args[args.index("--action") + 1]
            self.assertEqual(shlex.split(action), ["termux-open", str(p)])

    class Recurring(Case):
        # NOW = "2026-10-10 11:00" (Sat)

        def test_add_period_units(self):
            d = datetime(2026, 10, 10, 9, 0)
            self.assertEqual(_add_period(d, 3, "d"), datetime(2026, 10, 13, 9, 0))
            self.assertEqual(_add_period(d, 2, "w"), datetime(2026, 10, 24, 9, 0))
            self.assertEqual(_add_period(d, 1, "m"), datetime(2026, 11, 10, 9, 0))
            self.assertEqual(_add_period(d, 1, "y"), datetime(2027, 10, 10, 9, 0))

        def test_add_period_month_wraps_year(self):
            self.assertEqual(_add_period(datetime(2026, 11, 10, 9, 0), 3, "m"),
                             datetime(2027, 2, 10, 9, 0))

        def test_add_period_month_clamps_day(self):
            # Jan 31 + 1m → Feb 28 (2027 is non-leap).
            self.assertEqual(_add_period(datetime(2027, 1, 31, 9, 0), 1, "m"),
                             datetime(2027, 2, 28, 9, 0))

        def test_add_period_year_leap_clamps(self):
            # Feb 29 + 1y → Feb 28.
            self.assertEqual(_add_period(datetime(2024, 2, 29, 9, 0), 1, "y"),
                             datetime(2025, 2, 28, 9, 0))

        def test_bump_cumulative_past_due(self):
            # today 2026-10-10, due 2026-09-15, ++2w → one step past today.
            today = datetime(2026, 10, 10, 11, 0)
            out = _bump_recurring(
                "- [ ] rent 2026-09-15 Tue 09:00 ++2w", today)
            self.assertIn("2026-10-13 Tue 09:00", out)

        def test_bump_cumulative_already_future(self):
            # Even when due is already future, ++ still advances by one step.
            today = datetime(2026, 10, 10, 11, 0)
            out = _bump_recurring(
                "- [ ] rent 2026-10-15 Thu 09:00 ++1m", today)
            self.assertIn("2026-11-15 Sun 09:00", out)

        def test_bump_floating_from_today(self):
            today = datetime(2026, 10, 10, 11, 0)
            out = _bump_recurring(
                "- [ ] water 2026-09-15 Tue 09:00 .+2w", today)
            self.assertIn("2026-10-24 Sat 09:00", out)

        def test_bump_no_repeater(self):
            self.assertIsNone(_bump_recurring(
                "- [ ] rent 2026-09-15 Tue 09:00", datetime(2026, 10, 10)))

        def test_bump_ignores_repeater_inside_word(self):
            # `C++1d` contains `++1d` but is not a repeater token.
            today = datetime(2026, 10, 10, 11, 0)
            for raw in (
                "- [ ] upgrade C++1d parser 2026-11-01 Sun 09:00",
                "- [ ] upgrade C++1y parser 2026-11-01 Sun 09:00",
                "- [ ] port foo.+2w later 2026-11-01 Sun 09:00",
                "- [ ] rent 2026-10-01 Thu 09:00 ++1days",
            ):
                self.assertIsNone(_bump_recurring(raw, today), raw)

        def test_bump_real_repeater_after_plusplus_word(self):
            today = datetime(2026, 10, 10, 11, 0)
            out = _bump_recurring(
                "- [ ] upgrade C++1d parser 2026-10-01 Thu 09:00 ++1m", today)
            self.assertEqual(
                out, "- [ ] upgrade C++1d parser 2026-11-01 Sun 09:00 ++1m")

        def test_zero_count_is_not_a_repeater(self):
            # `++0d` would never move the date (an endless loop): plain text.
            self.assertIsNone(REPEATER.search("- [ ] standup ++0d"))
            self.assertIsNone(REPEATER.search("- [ ] standup .+00w"))
            self.assertIsNotNone(REPEATER.search("- [ ] standup ++01d"))
            self.assertIsNone(_bump_recurring(
                "- [ ] standup 2026-10-01 Thu 09:00 ++0d",
                datetime(2026, 10, 10, 11, 0)))

        def test_toggle_x_zero_count_marks_done(self):
            out = self.td("toggle", "x",
                          stdin="- [ ] standup 2026-10-01 Thu 09:00 ++0d\n")
            self.assertEqual(out.strip(),
                             "- [x] standup 2026-10-01 Thu 09:00 ++0d")

        def test_bump_no_date(self):
            self.assertIsNone(_bump_recurring(
                "- [ ] rent ++2w", datetime(2026, 10, 10)))

        def test_bump_preserves_rest(self):
            # Prefix and repeater suffix stay intact around the rewritten date.
            today = datetime(2026, 10, 10, 11, 0)
            out = _bump_recurring(
                "- [ ] pay rent 2026-10-01 Thu 09:00 ++1m #active", today)
            self.assertEqual(
                out, "- [ ] pay rent 2026-11-01 Sun 09:00 ++1m #active")

        def test_bump_moves_the_stamp_before_the_repeater(self):
            t = datetime(2026, 10, 10, 11, 0)
            self.assertEqual(_bump_recurring("rent 2026-10-01 09:00 ++1m, paid 2026-10-05 10:00", t),
                             "rent 2026-11-01 Sun 09:00 ++1m, paid 2026-10-05 10:00")
            self.assertEqual(_bump_recurring("since 2026-09-01 08:00: rent 2026-10-01 09:00 ++1m", t),
                             "since 2026-09-01 08:00: rent 2026-11-01 Sun 09:00 ++1m")

        def test_toggle_x_bumps_cumulative(self):
            # `td toggle x` on a recurring bullet: state stays [ ], date bumps.
            out = self.td("toggle", "x",
                          stdin="- [ ] rent 2026-10-01 Thu 09:00 ++1m\n")
            self.assertEqual(out.strip(),
                             "- [ ] rent 2026-11-01 Sun 09:00 ++1m")

        def test_toggle_x_bumps_floating(self):
            # today = Sat 2026-10-10 11:00
            out = self.td("toggle", "x",
                          stdin="- [ ] water 2026-09-01 Tue 09:00 .+2w\n")
            self.assertEqual(out.strip(),
                             "- [ ] water 2026-10-24 Sat 09:00 .+2w")

        def test_toggle_x_no_repeater_marks_done(self):
            out = self.td("toggle", "x",
                          stdin="- [ ] plain 2026-10-01 Thu 09:00\n")
            self.assertEqual(out.strip(),
                             "- [x] plain 2026-10-01 Thu 09:00")

        def test_toggle_x_plusplus_inside_word_marks_done(self):
            out = self.td("toggle", "x", stdin=(
                "- [ ] upgrade C++1d parser 2026-11-01 Sun 09:00\n"))
            self.assertEqual(
                out.strip(),
                "- [x] upgrade C++1d parser 2026-11-01 Sun 09:00")

        def test_toggle_x_from_file_bumps_on_disk(self):
            p = self.put_inbox("- [ ] rent 2026-10-01 Thu 09:00 ++1m\n")
            self.td("toggle", "x", "--from", str(p), "--line", "1")
            self.assertEqual(p.read_text(),
                             "- [ ] rent 2026-11-01 Sun 09:00 ++1m\n")

        def test_file_task_repeats_from_its_own_file(self):
            text = "# [ ] haircut\n2026-12-15 Tue 11:50 ++2m\n\n1mm at the back\n"
            bumped = "# [ ] haircut\n2027-02-15 Mon 11:50 ++2m\n\n1mm at the back\n"
            p = self.put_dedicated("haircut.md", text)
            # x on the date line moves it; other states leave it.
            date = "2026-12-15 Tue 11:50 ++2m\n"
            self.assertEqual(self.td("toggle", "x", "--from", str(p), stdin=date),
                             "2027-02-15 Mon 11:50 ++2m\n")
            self.assertEqual(self.td("toggle", "Y", "--from", str(p), stdin=date), date)
            self.assertEqual(self.td("toggle", "x", "--from", str(p), stdin="1mm at the back\n"),
                             "1mm at the back\n")
            # x on the heading from the buffer: the date is on another line, which this key
            # can't change, so the heading stays (done would end the repeats).
            self.assertEqual(self.td("toggle", "x", "--from", str(p), stdin="# [ ] haircut\n"),
                             "# [ ] haircut\n")
            self.assertEqual(self.td("toggle", "Y", "--from", str(p), stdin="# [ ] haircut\n"),
                             "# [Y] haircut\n")
            self.assertEqual(p.read_text(), text)
            # On disk (--line) the whole file is there: the date moves.
            self.td("toggle", "x", "--from", str(p), "--line", "1")
            self.assertEqual(p.read_text(), bumped)
            # The date on the heading line moves from the buffer too.
            q = self.put_dedicated("rent.md", "# [ ] rent 2026-10-01 Thu 09:00 ++1m\n")
            self.assertEqual(self.td("toggle", "x", "--from", str(q), stdin=q.read_text()),
                             "# [ ] rent 2026-11-01 Sun 09:00 ++1m\n")
            # With no repeater, done is done.
            r = self.put_dedicated("passport.md", "# [ ] renew passport\n2026-12-15 Tue 11:50\n")
            self.assertEqual(self.td("toggle", "x", "--from", str(r), stdin="# [ ] renew passport\n"),
                             "# [x] renew passport\n")

        def test_toggle_x_bumps_from_today_state(self):
            # Marking a [y] (today) line done also bumps if recurring.
            out = self.td("toggle", "x",
                          stdin="- [Y] rent 2026-10-01 Thu 09:00 ++1m\n")
            self.assertEqual(out.strip(),
                             "- [ ] rent 2026-11-01 Sun 09:00 ++1m")

        def test_toggle_bumps_with_note_after_time(self):
            # The line ends `09:00 -`; it must bump, not end the recurrence by
            # marking it done.
            text = "rent ++1m 2026-10-01 Thu 09:00 -"
            p = self.put_inbox(f"- [ ] {text}\n")
            self.td("toggle", "x", "--from", str(p), "--line", "1")
            self.assertEqual(p.read_text(),
                             "- [ ] rent ++1m 2026-11-01 Sun 09:00 -\n")

        def test_toggle_mirror_marks_inbox_done_when_it_cannot_bump(self):
            # The dedicated file's line repeats (its `→` part is `++1m`), the
            # inbox copy has the same core text but no repeater: the inbox
            # line is marked done, not reset to [ ].
            p = self.put_inbox("- [Y] pay rent 2026-10-01 Thu 09:00\n")
            d = self.put_dedicated(
                "notes.md", "# notes\n- [Y] pay rent 2026-10-01 Thu 09:00 → ++1m\n")
            self.td("toggle", "x", "--from", str(d), "--line", "2")
            self.assertEqual(d.read_text(), "# notes\n"
                             "- [ ] pay rent 2026-11-01 Sun 09:00 → ++1m\n")
            self.assertEqual(p.read_text(), "- [x] pay rent 2026-10-01 Thu 09:00\n")

        def test_toggle_y_ignores_bad_fake_clock(self):
            # Only x/X needs the clock (for a bump).
            p = self.put_inbox("- [ ] alpha\n")
            self.td("toggle", "Y", "--from", str(p), "--line", "1",
                    now_="2026-10-10T11:00")
            self.assertEqual(p.read_text(), "- [Y] alpha\n")

    class TlAgrees(unittest.TestCase):
        def test_tl_entry_is_tls_pattern(self):
            # tl logs (and flags typos in) the lines that start with date,
            # time, dash; td never fires their leading time. One pattern,
            # so each such line belongs to exactly one of them.
            from importlib.machinery import SourceFileLoader
            from importlib.util import module_from_spec, spec_from_loader
            path = Path(TD).with_name("tl")
            if not path.exists():
                self.skipTest("no tl next to td")
            loader = SourceFileLoader("tl", str(path))
            tl = module_from_spec(spec_from_loader("tl", loader))
            sys.dont_write_bytecode, before = True, sys.dont_write_bytecode
            try:
                loader.exec_module(tl)
            finally:
                sys.dont_write_bytecode = before
            self.assertEqual(TL_ENTRY.pattern, tl.ATTEMPT.pattern)

    class KeysDoc(unittest.TestCase):
        # keys.md lists every `space ,` key in config.toml and the `+`/`-`
        # stamp keys, and nothing else.
        def test_keys_md_matches_config(self):
            import tomllib
            here = Path(TD).parent
            config = here.parent / "config.toml"
            if not config.exists():
                self.skipTest("no config.toml next to bin/")
            with open(config, "rb") as f:
                normal = tomllib.load(f)["keys"]["normal"]
            names = {"ret": "Enter"}
            in_config = set()
            for k, v in normal["space"][","].items():
                if isinstance(v, dict):  # a sub-menu: `, y` is `space , , y`
                    in_config |= {f"{k} {sub}" for sub in v}
                else:
                    in_config.add(names.get(k, k))
            in_config |= {k for k in ("+", "-") if k in normal}
            doc = (here.parent / "docs" / "keys.md").read_text(encoding="utf-8")
            in_doc = set(re.findall(r"^\| `([^`]+)` \|", doc, re.M))
            self.assertEqual(in_doc, in_config,
                             "docs/keys.md is out of sync with config.toml")

    loader = unittest.defaultTestLoader
    suite = unittest.TestSuite(loader.loadTestsFromTestCase(c)
                               for c in (Parse, List, Tick, New, Stamp, Next,
                                         Promote, Marker, Jump, SetToggle,
                                         AgendaToggle, File, WeekView, Rename, Fire, Recurring,
                                         TlAgrees,
                                         KeysDoc))
    ok = unittest.TextTestRunner(verbosity=2 if verbose else 1).run(suite).wasSuccessful()
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
